# Match SWOOVR_ZAMMAD_WEBHOOK_SECRET in private .local/zammad/runtime.env.
# Empty/unconfigured secret or missing database makes intake return 503.
# Do not commit a filled copy. Minimum secret length: 32 characters.
Ticketing__Zammad__WebhookSecret=
# Existing application persistence setting; use isolated credentials supplied by the operator.
ConnectionStrings__Swoovr=
