# Swoovr API ↔ Zammad settings. Placeholders only — never commit real values.
Ticketing__Zammad__BaseUrl=https://helpdesk.example.invalid/
Ticketing__Zammad__IdentityToken=<identity-lifecycle-token>
Ticketing__Zammad__WebhookSecret=<at-least-32-random-characters>
# Staff directory (admin.user, admin.session; ticket.agent only to read groups/roles). Swoovr creates every staff member's
# Zammad identities and tokens from Swoovr roles; there is no per-staff setting.
Ticketing__Zammad__StaffDirectoryToken=<staff-directory-token>
# Retention (D337): swoovr-retention identity, ticket.agent read on every group + admin.data_privacy.
Ticketing__Zammad__RetentionToken=<retention-token>
# Home City check (D349, D354): swoovr-home-city-check identity, ticket.agent create/read in "Home City checks" only.
Ticketing__Zammad__HomeCityCheckToken=<home-city-check-token>
Location__HomeCityCheck__AdminBaseUrl=https://admin.swoovr.example.invalid/
# Attachment scanning (D336): the private ClamAV service; never a public address.
Attachments__Scanning__ClamAv__Host=<clamav-private-host>
Attachments__Scanning__ClamAv__Port=3310
# Ticketing__Staff__SyncSeconds=60
# Ticketing__Staff__VerifyMinutes=10
Ticketing__Events__ReconcileMinutes=10
Ticketing__Guest__AllowedOrigins__0=https://swoovr.example.invalid
Ticketing__Guest__FrontendUrl=https://swoovr.example.invalid/support
# Optional bot check for guest code requests:
# Ticketing__Guest__Turnstile__Secret=<turnstile-secret>
