# Deny by default: no Git history, .local, realm exports, docs, private fixtures,
# credentials or host build products are transferred to the builder.
**
!global.json
!Directory.Build.props
!src/
!src/Hosting/
!src/Hosting/**
!src/Swoovr.Api/
!src/Swoovr.Api/**
!src/Swoovr.Web/
!src/Swoovr.Web/**
!src/Swoovr.Web.Client/
!src/Swoovr.Web.Client/**
!src/Swoovr.Admin/
!src/Swoovr.Admin/**
!src/Swoovr.Contracts/
!src/Swoovr.Contracts/**
!src/Swoovr.Client/
!src/Swoovr.Client/**
!src/Swoovr.Domain/
!src/Swoovr.Domain/**
!src/Swoovr.Infrastructure/
!src/Swoovr.Infrastructure/**
!containers/
!containers/uat/
!containers/uat/keycloak-entrypoint.sh
!containers/keycloak/
!containers/keycloak/themes/
!containers/keycloak/themes/swoovr/
!containers/keycloak/themes/swoovr/**
!containers/keycloak/contact-policy/
!containers/keycloak/contact-policy/src/
!containers/keycloak/contact-policy/src/**
# Re-exclude local configuration and artifacts inside otherwise allowed trees.
**/bin/
**/obj/
**/.local/
**/.env*
**/appsettings.*.json
**/Properties/
**/*.pfx
**/*.p12
**/*.p8
**/*.pem
**/*.key
**/*.jks
**/*.keystore
**/*.dump
**/*.sql
**/*.db
**/*.sqlite*
**/*.tar
**/*.tar.gz
**/*.zip
**/*.age
