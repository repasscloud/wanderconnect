<?xml version="1.0" encoding="UTF-8" ?>
<!-- Tabs shared with the web (D141, superseding D123): Explore (with destination discovery), Connections, Chats (not
     available until messaging) and Me (the account, profile, matching, Travel planning, verification and notices). Travel
     never appears in Explore's mode control (Q12). -->
<Shell
    x:Class="Swoovr.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Swoovr.Mobile"
    Title="Swoovr">
    <TabBar>
        <ShellContent Title="Explore" AutomationId="TabExplore" ContentTemplate="{DataTemplate local:ExplorePage}" Route="ExplorePage" />
        <ShellContent Title="Connections" AutomationId="TabConnections" ContentTemplate="{DataTemplate local:ConnectionsPage}" Route="ConnectionsPage" />
        <ShellContent Title="Chats" AutomationId="TabChats" ContentTemplate="{DataTemplate local:ChatsPage}" Route="ChatsPage" />
        <ShellContent Title="Me" AutomationId="TabMe" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
    </TabBar>
</Shell>
