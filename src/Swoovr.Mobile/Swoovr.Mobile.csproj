<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Swoovr.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Swoovr</ApplicationTitle>

		<!-- DEFAULT development app identifier; store/signing registration remains unverified. -->
		<ApplicationId>com.swoovr.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>


		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

    <!-- Nonsecret build target. UAT has hosted HTTPS endpoints; local API testing is never a UAT/release artifact. -->
    <PropertyGroup>
        <SwoovrEnvironment Condition="'$(SwoovrEnvironment)' == '' And '$(Configuration)' == 'Debug'">Development</SwoovrEnvironment>
        <SwoovrEnvironment Condition="'$(SwoovrEnvironment)' == ''">Uat</SwoovrEnvironment>
        <ApplicationTitle Condition="'$(SwoovrEnvironment)' == 'Uat'">Swoovr UAT</ApplicationTitle>
        <DefineConstants Condition="'$(SwoovrEnvironment)' == 'Uat'">$(DefineConstants);SWOOVR_UAT</DefineConstants>
        <DefineConstants Condition="'$(SwoovrOwnedApiTest)' == 'true'">$(DefineConstants);SWOOVR_OWNED_API</DefineConstants>
        <ApnsEnvironment Condition="'$(ApnsEnvironment)' == '' And '$(SwoovrEnvironment)' == 'Uat' And '$(Configuration)' == 'Release'">production</ApnsEnvironment>
    </PropertyGroup>
    <Target Name="ValidateSwoovrBuild" BeforeTargets="BeforeBuild">
        <Error Condition="'$(SwoovrEnvironment)' != 'Development' And '$(SwoovrEnvironment)' != 'Uat'" Text="SwoovrEnvironment must be Development or Uat." />
        <Error Condition="'$(SwoovrEnvironment)' == 'Development' And '$(Configuration)' != 'Debug'" Text="Development endpoints require a Debug build." />
        <Error Condition="'$(SwoovrOwnedApiTest)' == 'true' And ('$(Configuration)' != 'Debug' Or '$(SwoovrEnvironment)' != 'Development')" Text="Owned API testing requires a Development Debug build." />
    </Target>

    <!-- Explicit provider builds only; local Debug remains labelled simulation. Credentials/config files are external. -->
    <PropertyGroup Condition="'$(EnableFcmPush)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <DefineConstants>$(DefineConstants);SWOOVR_FCM</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="'$(EnableFcmPush)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="Xamarin.Firebase.Messaging" Version="124.1.2" />
        <GoogleServicesJson Include="$(SwoovrGoogleServicesJson)" Condition="Exists('$(SwoovrGoogleServicesJson)')" />
    </ItemGroup>
    <PropertyGroup Condition="'$(EnableApnsPush)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <DefineConstants>$(DefineConstants);SWOOVR_APNS</DefineConstants>
        <CodesignEntitlements>Platforms/iOS/Push.entitlements</CodesignEntitlements>
        <ApnsEnvironment Condition="'$(ApnsEnvironment)' == ''">development</ApnsEnvironment>
        <CodesignEntitlements Condition="'$(ApnsEnvironment)' == 'production'">Platforms/iOS/Push.Production.entitlements</CodesignEntitlements>
    </PropertyGroup>

    <Target Name="ValidatePushBuild" BeforeTargets="BeforeBuild">
        <Error Condition="'$(EnableApnsPush)' == 'true' And '$(SwoovrEnvironment)' == 'Uat' And '$(Configuration)' == 'Release' And '$(ApnsEnvironment)' != 'production'" Text="UAT Release APNs requires production entitlements." />
        <Error Condition="'$(EnableApnsPush)' == 'true' And '$(ApnsEnvironment)' != 'development' And '$(ApnsEnvironment)' != 'production'" Text="ApnsEnvironment must be development or production." />
        <Error Condition="'$(EnableFcmPush)' == 'true' And ('$(Configuration)' == 'Release' Or '$(SwoovrEnvironment)' == 'Uat') And !Exists('$(SwoovrGoogleServicesJson)')" Text="An external SwoovrGoogleServicesJson file is required for a Release/UAT FCM build." />
    </Target>

	<ItemGroup>
		<!-- App icon (D89): the white Swoovr bird on black. appiconfg.svg is an unchanged copy of swoovr-marketing
		     branding/assets/white/bird.svg. Scales follow that preset's own exports: the bird fills about 72% of the
		     full-bleed app-square tile (iOS) and 44% of the adaptive-foreground canvas, inside Android's safe zone. -->
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.72" Color="#000000" />
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.44" Color="#000000" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0A0A0A" BaseSize="132,112" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Debug only: plain HTTP to the local stack (ATS local networking). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(Configuration)' == 'Debug' And '$(SwoovrEnvironment)' == 'Development'">
		<PartialAppManifest Include="Platforms\iOS\Debug.plist" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Swoovr.Client\Swoovr.Client.csproj" />
	</ItemGroup>

</Project>
