<?xml version="1.0" encoding="UTF-8" ?>
<!-- Base styles: docs/design/reference/UI-STYLE.md. Colours come only from Colors.xaml (generated from
     docs/design/themes.json, Standard scheme); light/dark follows the device. One font family everywhere:
     Helvetica Neue where the platform has it, then Arial, then the platform sans-serif (Android has neither). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <OnPlatform x:Key="SwoovrFont" x:TypeArguments="x:String">
        <On Platform="iOS, MacCatalyst" Value="Helvetica Neue" />
        <On Platform="WinUI" Value="Arial" />
        <On Platform="Android" Value="sans-serif" />
    </OnPlatform>
    <!-- Photo-free profile quote only (UI-STYLE.md Type); Android uses its platform serif. -->
    <OnPlatform x:Key="SwoovrQuoteFont" x:TypeArguments="x:String"><On Platform="iOS, MacCatalyst, WinUI" Value="Georgia" /><On Platform="Android" Value="serif" /></OnPlatform>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <!-- Body: 15 / 400, line-height 1.4. Named styles are BasedOn this, because an explicit style
         replaces the implicit one in MAUI. -->
    <Style TargetType="Label" x:Key="BaseLabel">
        <Setter Property="FontFamily" Value="{StaticResource SwoovrFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource BaseLabel}" />

    <!-- Page title ("Welcome back."): 32 / 700, line-height 1.05, letter-spacing -1 -->
    <Style TargetType="Label" x:Key="PageTitle" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.05" />
        <Setter Property="CharacterSpacing" Value="-1" />
    </Style>

    <!-- Screen title ("Explore"): 28 / 700, letter-spacing -0.5, left aligned -->
    <Style TargetType="Label" x:Key="ScreenTitle" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.1" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
    </Style>

    <Style TargetType="Label" x:Key="SectionHeading" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Label" x:Key="Subtitle" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="FieldLabel" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="0.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="FooterClaims" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="1.6" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource SwoovrFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- Primary button: 54 tall, radius 14, primary fill, 16 / 600 -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="FontFamily" Value="{StaticResource SwoovrFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />

    <!-- Secondary button: same size, surface fill, hairline border, text colour -->
    <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>

    <!-- Link: text colour, 13 (the underline is a separate hairline in the layout) -->
    <Style TargetType="Label" x:Key="Link" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    </Style>

    <!-- Card: surface, hairline, radius 16, no shadow (implicit for every Border). -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style TargetType="Border" BasedOn="{StaticResource Card}" />

    <!-- Input: 56 tall, radius 14, label inside (FieldLabel) above an Entry -->
    <Style TargetType="Border" x:Key="InputBorder" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="14" /></Setter.Value></Setter>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="Padding" Value="16,6" />
    </Style>

    <!-- Chips: radius 20, padding 9×4, 12 / bold. Selected: primary fill. Ruled out: muted, struck through. -->
    <Style TargetType="Border" x:Key="Chip" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="20" /></Setter.Value></Setter>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style TargetType="Border" x:Key="ChipOn" BasedOn="{StaticResource Chip}">
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="20" /></Setter.Value></Setter>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    </Style>
    <Style TargetType="Label" x:Key="ChipLabel" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style TargetType="Label" x:Key="ChipOnLabel" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style TargetType="Label" x:Key="ChipOffLabel" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>

    <!-- Profile tiles: every tile exactly 170 × 270. Photo tile: photo 170 tall, then name, chips, area. Photo-free tile:
         primary fill, quote in SwoovrQuoteFont, name and intentions at the bottom. -->
    <Style TargetType="Border" x:Key="ProfileTile" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="WidthRequest" Value="170" />
        <Setter Property="HeightRequest" Value="270" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style TargetType="Border" x:Key="ProfileTileQuote" BasedOn="{StaticResource ProfileTile}">
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style TargetType="Label" x:Key="TileName" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style TargetType="Label" x:Key="TileQuote" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="{StaticResource SwoovrQuoteFont}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="LineHeight" Value="1.22" />
        <Setter Property="MaxLines" Value="5" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
    </Style>
    <Style TargetType="Label" x:Key="TileArea" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <!-- Chat: their bubble surface + hairline with a 4 bottom-left corner; mine primary with a 4 bottom-right corner.
         Composer: soft pill input and a round primary send button. -->
    <Style TargetType="Border" x:Key="BubbleTheirs" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="20,20,4,20" /></Setter.Value></Setter>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>
    <Style TargetType="Border" x:Key="BubbleMine" BasedOn="{StaticResource BubbleTheirs}">
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="20,20,20,4" /></Setter.Value></Setter>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>
    <Style TargetType="Label" x:Key="BubbleText" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    </Style>
    <Style TargetType="Label" x:Key="BubbleMineText" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
    </Style>
    <Style TargetType="Border" x:Key="ComposerInput" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="22" /></Setter.Value></Setter>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SoftLight}, Dark={StaticResource SoftDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SoftLight}, Dark={StaticResource SoftDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16,4" />
    </Style>
    <Style TargetType="Button" x:Key="SendButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Segmented control: soft track; the selected segment is a surface Border (SegmentOn). -->
    <Style TargetType="Border" x:Key="SegmentTrack" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="12" /></Setter.Value></Setter>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SoftLight}, Dark={StaticResource SoftDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SoftLight}, Dark={StaticResource SoftDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style TargetType="Border" x:Key="SegmentOn" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="10" /></Setter.Value></Setter>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style TargetType="Label" x:Key="SegmentLabel" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SoftTextLight}, Dark={StaticResource SoftTextDark}}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
