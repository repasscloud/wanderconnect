<?xml version="1.0" encoding="utf-8" ?>
<!-- The signed-in account screen: the same API answers as the web account page (session, beta notice, badges, age, coupon). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Swoovr.Mobile.MainPage" Title="Swoovr">
    <ScrollView>
        <VerticalStackLayout Padding="24,30" Spacing="16">
            <Label x:Name="Heading" Text="Swoovr" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1" />
            <Label x:Name="Intro" Style="{StaticResource Subtitle}" />
            <Label x:Name="Status" AutomationId="Status" IsVisible="False" />

            <VerticalStackLayout x:Name="SignedOutPanel" Spacing="12" IsVisible="False">
                <Button x:Name="SignInButton" Text="Sign in" AutomationId="SignIn" Style="{StaticResource PrimaryButton}" Clicked="OnSignIn" />
                <Label Text="You sign in on Swoovr's sign-in page in your phone's browser. Swoovr never sees your password." Style="{StaticResource FooterClaims}" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="AccountPanel" Spacing="16" IsVisible="False">
                <Border x:Name="BetaNotice" Style="{StaticResource Card}" IsVisible="False">
                    <VerticalStackLayout Spacing="6">
                        <Label><Label.FormattedText><FormattedString>
                            <Span Text="Swoovr is in private beta." FontAttributes="Bold" />
                            <Span Text=" You're not on the list yet." />
                        </FormattedString></Label.FormattedText></Label>
                        <Label Text="Ask to join the beta on swoovr.com" Style="{StaticResource Link}" AutomationId="BetaLink">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBetaLink" /></Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" SemanticProperties.Description="Your session">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Signed in with" Style="{StaticResource FieldLabel}" />
                        <Label x:Name="Method" AutomationId="Method" />
                        <Label Text="Email" Style="{StaticResource FieldLabel}" />
                        <Label x:Name="EmailVerified" />
                        <Label Text="18+ confirmation" Style="{StaticResource FieldLabel}" />
                        <Label x:Name="AdultAttested" />
                        <Label Text="Member area" Style="{StaticResource FieldLabel}" />
                        <Label x:Name="MemberArea" AutomationId="MemberArea" />
                        <Label Text="Confirming you're 18+ isn't age verification. ID checks come later." Style="{StaticResource FooterClaims}" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="LockedCard" Style="{StaticResource Card}" IsVisible="False">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="This account is locked." Style="{StaticResource SectionHeading}" />
                        <Label Text="Swoovr is for adults only. If the age you entered was a mistake, contact Swoovr support to have it reviewed." />
                    </VerticalStackLayout>
                </Border>

                <!-- D160: restricted, suspended or terminated: nothing else in the app until it's lifted; notices and appeals stay open. -->
                <Border x:Name="RestrictedCard" Style="{StaticResource Card}" IsVisible="False" AutomationId="RestrictedScreen">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="RestrictedTitle" AutomationId="RestrictedTitle" Style="{StaticResource SectionHeading}" />
                        <Label x:Name="RestrictedBody" />
                        <Button x:Name="RestrictedNotices" Text="Read the notice" AutomationId="RestrictedNotices" Style="{StaticResource PrimaryButton}" Clicked="OnNotices" />
                        <!-- D170: anyone can delete their account or download their data, restricted or not; a pending deletion lands here too. -->
                        <Button Text="Your data and account" AutomationId="RestrictedData" Style="{StaticResource SecondaryButton}" Clicked="OnData" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="MemberSections" Spacing="16" IsVisible="False">
                    <!-- D127: the rest of the app answers age-verification-required until the check passes or support resolves it. -->
                    <Border x:Name="AgeCheckCard" Style="{StaticResource Card}" IsVisible="False" AutomationId="AgeCheckRequired">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Please verify your age" Style="{StaticResource SectionHeading}" />
                            <Label Text="We need to confirm you're 18 or over before you can keep using Swoovr." />
                            <Button Text="Verify my ID" AutomationId="AgeCheckVerify" Style="{StaticResource PrimaryButton}" Clicked="OnVerification" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- D141: profile, settings and Travel planning sit under Me. -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Your Swoovr" Style="{StaticResource SectionHeading}" SemanticProperties.HeadingLevel="Level2" />
                            <Button Text="Your profile" AutomationId="MeProfile" Style="{StaticResource SecondaryButton}" Clicked="OnProfile" />
                            <Button Text="Who I'd like to meet" AutomationId="MeMatching" Style="{StaticResource SecondaryButton}" Clicked="OnMatching" />
                            <Button Text="Travel" AutomationId="MeTravel" Style="{StaticResource SecondaryButton}" Clicked="OnTravel" />
                            <Button Text="ID verification" AutomationId="MeVerification" Style="{StaticResource SecondaryButton}" Clicked="OnVerification" />
                            <Button Text="Notices and reports" AutomationId="MeNotices" Style="{StaticResource SecondaryButton}" Clicked="OnNotices" />
                            <Button Text="Mobile number" AutomationId="MePhone" Style="{StaticResource SecondaryButton}" Clicked="OnPhone" />
                            <Button Text="Your data and account" AutomationId="MeData" Style="{StaticResource SecondaryButton}" Clicked="OnData" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Badges" Style="{StaticResource SectionHeading}" SemanticProperties.HeadingLevel="Level2" />
                            <VerticalStackLayout x:Name="BadgeList" Spacing="6" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Your age" Style="{StaticResource SectionHeading}" SemanticProperties.HeadingLevel="Level2" />
                            <!-- D139: a date of birth is required and never shown; the age shows unless hidden (Who I'd like to meet). -->
                            <Label Text="We need your date of birth to show you in discovery. It's never shown; your age is, unless you hide it. Entering it isn't age verification." Style="{StaticResource FooterClaims}" />
                            <Label Text="Date of birth" Style="{StaticResource FieldLabel}" />
                            <DatePicker x:Name="DateOfBirth" AutomationId="DateOfBirth" SemanticProperties.Description="Date of birth" />
                            <Label x:Name="DateOfBirthVerified" AutomationId="DateOfBirthVerified" Text="Verified with your ID. Contact Swoovr support to change it." Style="{StaticResource FooterClaims}" IsVisible="False" />
                            <Button x:Name="SaveAge" Text="Save" AutomationId="SaveAge" Style="{StaticResource PrimaryButton}" Clicked="OnSaveAge" />
                            <Label x:Name="AgeMessage" AutomationId="AgeMessage" Style="{StaticResource FooterClaims}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Coupon code" Style="{StaticResource SectionHeading}" SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="Founding members: if you've returned to Swoovr, enter the founder code we emailed you to restore your founding status." Style="{StaticResource FooterClaims}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry x:Name="Coupon" Placeholder="FOUNDER-…" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" SemanticProperties.Description="Code" />
                            </Border>
                            <Button x:Name="ApplyCoupon" Text="Apply code" Style="{StaticResource SecondaryButton}" Clicked="OnApplyCoupon" />
                            <Label x:Name="CouponMessage" AutomationId="CouponMessage" Style="{StaticResource FooterClaims}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Sign out" AutomationId="SignOut" Style="{StaticResource SecondaryButton}" Clicked="OnSignOut" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
