@* Me → Privacy & safety (issue 217; earlier Me → Safety, D190/D204). Emergency assistance first for the member's
   country; then the serious-incident entry with the three people they dealt with most recently (the full list and the
   report itself are their own pages), safety resources, "I'm meeting someone" and the privacy controls.
   Country: a choice the member made (kept on this device) wins, then their Home City's country, then the host's
   default. Choosing a country never changes the profile, Home City, Travel or Explore. *@
@inject MemberClient Members
@inject IJSRuntime JS
<div class="me-page-head" data-safety="ready"><div class="me-title-row"><h1>Privacy &amp; safety</h1></div></div>
<section class="me-card me-emergency" aria-labelledby="emergency-title" data-safety-services="@(pack?.Country ?? "none")"
         data-safety-readiness="@(pack?.Readiness ?? "unknown")" data-safety-stale="@(pack?.Stale == true ? "yes" : "no")" data-country-source="@source">
    <div class="me-emergency-head" data-country-form>
        <h2 class="me-card-title" id="emergency-title"><Icon Name="phone" Size="20" />Emergency assistance</h2>
        <label class="visually-hidden" for="safety-country">Country</label>
        <select id="safety-country" class="me-country" value="@(pack?.Country ?? "")" @onchange="ChooseAsync" data-country-select>
            @if (pack?.Country is null) { <option value="">Choose a country</option> }
            @foreach (var option in pack?.Countries ?? []) { <option value="@option.Code">@option.Name@(option.Readiness == "demo" ? " (demo)" : option.Readiness == "not-ready" ? " (not yet checked)" : "")</option> }
        </select>
    </div>
    @if (pack is not null && SafetyText.Warning(pack) is { } warning) { <p class="safety-warning" role="note" data-safety-warning>@warning</p> }
    @if (!packLoaded) { <p role="status" class="me-meta">Loading…</p> }
    else if (Emergency.Count == 0) { <p class="safety-emergency-fallback" data-safety-neutral>@(pack is null ? "Safety contacts couldn't be loaded. If you're in immediate danger, contact your local emergency services now." : SafetyText.Neutral)</p> }
    else
    {
        <ul class="safety-emergency-list">
            @foreach (var r in Emergency)
            {
                <li class="safety-emergency-row" data-service="@r.Name" data-category="@r.Category" data-safety-resource>
                    <div>
                        @if ((r.PhoneDisplay ?? r.Phone) is { } shown) { <p class="safety-emergency-number">@shown</p> }
                        <p class="safety-emergency-name">@r.Name</p>
                        <p class="safety-emergency-text">@r.Description</p>
                    </div>
                    @if (r.Phone is not null) { <a class="safety-call-emergency" href="tel:@r.Phone" data-call="@r.Phone" aria-label="Call @(r.PhoneDisplay ?? r.Phone), @r.Name"><Icon Name="phone" Size="18" />Call @(r.PhoneDisplay ?? r.Phone)</a> }
                </li>
            }
        </ul>
    }
</section>
<div class="me-safety-grid">
    <div class="me-col">
        <section class="me-card" id="serious" aria-labelledby="serious-heading" data-swoovr-actions>
            <h2 class="me-card-title" id="serious-heading"><Icon Name="shield" Size="20" />Report a serious safety incident</h2>
            <p class="me-card-lede">@SafetyText.SeriousPeopleHelp</p>
            @if (!peopleLoaded) { <p role="status" class="me-meta">Loading…</p> }
            else if (people.Count == 0) { <p class="me-empty" data-safety-people="none">No one yet. You can also report from someone's profile or a conversation.</p> }
            else { <SafetyPeopleList People="people.Take(3)" Meeting="meeting" From="hub" /> }
            @if (people.Count > 3)
            {
                <div class="me-card-foot"><span class="me-meta">@people.Count people</span><a class="button button-secondary me-pill-button" href="@SafetyText.PeoplePath(meeting)" data-safety-all-people>See all people</a></div>
            }
        </section>
        <section class="me-card" aria-labelledby="resources-heading">
            <h2 class="me-card-title" id="resources-heading"><Icon Name="book" Size="20" />Safety resources</h2>
            <ul class="me-links">
                <li><a href="@("/safety" + (pack?.Country is { } c ? "?country=" + c : ""))" data-enhance-nav="false">Support services@(pack?.CountryName is { } name ? " in " + name : "")<Icon Name="arrow-right" Size="18" /></a></li>
                <li><a href="/safety/advice">Safety Advice<Icon Name="arrow-right" Size="18" /></a></li>
                <li><a href="/community-guidelines#guidance-2">Reporting and blocking<Icon Name="arrow-right" Size="18" /></a></li>
                <li><a href="/community-guidelines">Community Guidelines<Icon Name="arrow-right" Size="18" /></a></li>
            </ul>
        </section>
    </div>
    <div class="me-col">
        <section class="me-card" aria-labelledby="meeting-heading">
            <h2 class="me-card-title" id="meeting-heading"><Icon Name="clock" Size="20" />I'm meeting someone</h2>
            <p class="me-card-lede">Share your plans with a trusted contact and check in when you're home.</p>
            <a class="button" href="/me/meeting-safety" data-meeting-entry>Set up a meeting check-in</a>
        </section>
        <section class="me-card" aria-labelledby="privacy-heading">
            <h2 class="me-card-title" id="privacy-heading"><Icon Name="lock" Size="20" />Privacy</h2>
            <ul class="me-items me-items-compact">
                <li class="me-item"><div class="me-item-main"><p class="me-item-title">Blocked people</p>@if (blockedCount is { } n) { <p class="me-meta" data-blocked-count="@n">@(n == 1 ? "1 person" : $"{n} people")</p> }</div><a class="button button-secondary me-pill-button me-item-action" href="/connections#blocked-heading">Manage</a></li>
                <li class="me-item"><div class="me-item-main"><p class="me-item-title">Your data</p><p class="me-meta">Download or delete</p></div><a class="button button-secondary me-pill-button me-item-action" href="/account/data">Open</a></li>
                <li class="me-item"><div class="me-item-main"><p class="me-item-title">Privacy Notice</p></div><a class="button button-secondary me-pill-button me-item-action" href="/privacy">Read</a></li>
            </ul>
        </section>
    </div>
</div>
@code {
    /// <summary>The host's default (D153 Cloudflare only where trusted, else the deployment fallback) and where it came from.</summary>
    [Parameter] public string? DefaultCountry { get; set; }
    [Parameter] public string DefaultSource { get; set; } = "unknown";

    private SafetyPack? pack;
    private bool packLoaded, peopleLoaded;
    private string source = "unknown";
    private string? meeting;
    private int? blockedCount;
    private List<SafetyPerson> people = [];
    private IReadOnlyList<SafetyResourceView> Emergency => pack?.Resources.Where(r => r.Category == "emergency").OrderBy(r => r.Order).ToList() ?? [];

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // ?meeting=<id> (from I'm meeting someone) is carried into the report so its details can be included.
        meeting = SafetyText.Query(Navigation.Uri, "meeting") is { } m && Guid.TryParse(m, out var id) ? id.ToString() : null;
        string? remembered = null;
        try { remembered = await JS.InvokeAsync<string?>("localStorage.getItem", SafetyText.ChoiceKey); } catch (JSException) { }
        var home = SafetyText.Manual(remembered) is null ? SafetyText.HomeCountry((await Members.ProfileAsync()).Value?.HomeCity) : null;
        var (country, from) = SafetyText.Choose(remembered, home, DefaultCountry, DefaultSource);
        await LoadPackAsync(country, from);
        people = (await Members.SafetyPeopleAsync()).Value ?? [];
        peopleLoaded = true;
        blockedCount = (await Members.BlocksAsync()).Value?.Count;
    }

    private async Task LoadPackAsync(string? country, string from)
    {
        source = from;
        pack = (await Members.SafetyAsync(country ?? "XX")).Value;
        packLoaded = true;
    }

    private async Task ChooseAsync(ChangeEventArgs e)
    {
        if (SafetyText.Manual(e.Value?.ToString()) is not { } chosen) return;
        try { await JS.InvokeVoidAsync("localStorage.setItem", SafetyText.ChoiceKey, chosen); } catch (JSException) { }
        await LoadPackAsync(chosen, "manual");
    }
}
