@* The Serious Safety Incident report (policy §9, owner Q77, D190), on its own page since issue 217
   (/me/safety/report?type=…&id=…&state=…[&meeting=…][&from=people]). Opened from Privacy & safety, People you've dealt
   with, a profile, a conversation or a meeting; Back and Cancel return to Privacy & safety or the people list. A category,
   what happened, whether they have contacted or want to contact police (optional reference, kept encrypted), messages
   chosen as evidence and an optional block. The other person is never told. Emergency services stay one tap away. *@
@inject MemberClient Members
@inject NavigationManager Navigation
@inject IJSRuntime JS
<div class="me-page-head" data-safety="@(done ? "sent" : "ready")">
    <a class="me-back" href="@BackHref" data-report-back><Icon Name="back" Size="18" />@BackLabel</a>
    <div class="me-title-row"><h1>Report a serious safety incident</h1></div>
</div>
<div class="me-report-layout">
    <section class="me-card" aria-label="Report">
        @if (done)
        {
            <div class="me-report-form" data-serious-done>
                <h2 class="me-card-title">Your report was sent</h2>
                <p role="status">@MemberText.SeriousPromise</p>
                <p class="me-meta">Follow it under Notices and reports. Your report's reference appears under Account standing.</p>
                <div class="me-report-buttons">
                    <a class="button" href="/me/notices">Notices and reports</a>
                    <a class="button button-secondary" href="@BackHref">Back to @BackLabel</a>
                </div>
            </div>
        }
        else if (subjectType is null)
        {
            <div class="me-report-form" data-serious-choose>
                <p>Choose who it's about first.</p>
                <div class="me-report-buttons"><a class="button" href="@SafetyText.PeoplePath(meetingContext?.ToString())">People you've dealt with</a></div>
            </div>
        }
        else
        {
            <form class="me-report-form" @onsubmit="SendAsync" data-serious-form>
                @if (person is not null)
                {
                    <div class="me-report-about" data-serious-person="@person.SubjectId">
                        <span class="me-avatar" aria-hidden="true">@(person.Name.Trim() is { Length: > 0 } n ? char.ToUpperInvariant(n[0]) : '?')</span>
                        <div class="me-item-main"><p class="me-item-title">@person.Name</p>
                            <p class="me-meta">@MemberText.SafetyState(person.State) · last interaction @StandingText.Date(person.LastInteractionAt ?? person.Since)</p></div>
                    </div>
                }
                <p class="me-meta">@MemberText.SeriousPromise</p>
                @if (meetingContext is not null) { <label class="check"><input type="checkbox" @bind="includeMeeting" /><span class="box"><Icon Name="check" Size="15" Stroke="2.5" /></span> Include my meeting times, venue or area and check-in status for staff review. Private feedback and trusted-contact details are excluded.</label> }
                <div class="field"><label for="serious-category">What happened</label>
                    <select id="serious-category" @bind="category" required data-serious-category>
                        <option value="">Choose one</option>
                        @foreach (var c in categories) { <option value="@c.Id">@c.Label</option> }
                    </select></div>
                <div class="field"><label for="serious-text">Details (optional)</label>
                    <textarea id="serious-text" maxlength="2000" rows="5" @bind="text"></textarea></div>
                <fieldset><legend>Police</legend>
                    @foreach (var answer in new[] { "contacted", "will-contact", "not-now" })
                    {
                        <label class="check"><input type="radio" name="police" checked="@(police == answer)" @onchange="() => police = answer" data-police="@answer" /> @MemberText.PoliceAnswer(answer)</label>
                    }
                </fieldset>
                @if (police == "contacted")
                {
                    <div class="field"><label for="police-reference">Police reference (optional)</label>
                        <input id="police-reference" maxlength="100" @bind="policeReference" data-police-reference /></div>
                }
                @if (messages.Count > 0)
                {
                    <fieldset data-choose-messages="@messages.Count"><legend>Messages to include (optional, up to 20)</legend>
                        @foreach (var m in messages.Where(m => !m.Deleted).TakeLast(50))
                        {
                            <label class="check"><input type="checkbox" checked="@chosen.Contains(m.Id)" @onchange="() => Toggle(m.Id)" data-choose="@m.Id" /><span class="box"><Icon Name="check" Size="15" Stroke="2.5" /></span> @(m.Mine ? "You" : "Them"): @(m.Kind == "photo" ? "[photo]" : m.Text)</label>
                        }
                    </fieldset>
                }
                @if (subjectType != "conversation" || personState is not ("blocked" or "deleted"))
                {
                    <label class="check"><input type="checkbox" @bind="block" data-serious-block /><span class="box"><Icon Name="check" Size="15" Stroke="2.5" /></span> Also block them</label>
                }
                <div class="me-report-buttons">
                    <button type="submit" class="button" disabled="@(busy || string.IsNullOrEmpty(category))" data-serious-send>Send serious report</button>
                    <a class="button button-secondary" href="@BackHref" data-serious-cancel>Cancel</a>
                </div>
                <p role="status" aria-live="polite" class="me-meta" data-serious-status="@status">@message</p>
            </form>
        }
    </section>
    <aside class="me-card me-emergency" aria-labelledby="danger-title" data-safety-services="@(pack?.Country ?? "none")">
        <h2 class="me-card-title" id="danger-title"><Icon Name="phone" Size="20" />In immediate danger?</h2>
        @if (Emergency is { Phone: not null } e)
        {
            <a class="safety-call-emergency" href="tel:@e.Phone" data-call="@e.Phone" aria-label="Call @(e.PhoneDisplay ?? e.Phone), @e.Name"><Icon Name="phone" Size="18" />Call @(e.PhoneDisplay ?? e.Phone)</a>
        }
        else if (pack is not null || packLoaded) { <p class="me-empty">Contact your local emergency services now.</p> }
    </aside>
</div>
@code {
    /// <summary>The host's default country (D153), used when the member hasn't chosen one and has no Home City country.</summary>
    [Parameter] public string? DefaultCountry { get; set; }

    private string? subjectType, subjectId, personState, category, text, police, policeReference, status, message, from;
    private bool busy, done, block, includeMeeting = true, packLoaded;
    private Guid? meetingContext;
    private SafetyPerson? person;
    private SafetyPack? pack;
    private List<ReportCategoryView> categories = [];
    private List<MessageView> messages = [];
    private readonly HashSet<Guid> chosen = [];

    private SafetyResourceView? Emergency => pack?.Resources.Where(r => r.Category == "emergency").OrderBy(r => r.Order).FirstOrDefault();
    private string BackHref => from == "people" ? SafetyText.PeoplePath(meetingContext?.ToString()) : "/me/safety" + (meetingContext is { } m ? "?meeting=" + m : "");
    private string BackLabel => from == "people" ? "People you've dealt with" : "Privacy & safety";

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.Uri;
        if (SafetyText.Query(uri, "type") is "profile" or "conversation" or "request" or "message" && SafetyText.Query(uri, "id") is { Length: > 0 } id)
            (subjectType, subjectId, personState) = (SafetyText.Query(uri, "type"), id, SafetyText.Query(uri, "state"));
        if (Guid.TryParse(SafetyText.Query(uri, "meeting"), out var meeting)) meetingContext = meeting;
        from = SafetyText.Query(uri, "from") == "people" ? "people" : "hub";

        string? remembered = null;
        try { remembered = await JS.InvokeAsync<string?>("localStorage.getItem", SafetyText.ChoiceKey); } catch (JSException) { }
        var home = SafetyText.Manual(remembered) is null ? SafetyText.HomeCountry((await Members.ProfileAsync()).Value?.HomeCity) : null;
        pack = (await Members.SafetyAsync(SafetyText.Choose(remembered, home, DefaultCountry, "fallback").Country ?? "XX")).Value;
        packLoaded = true;

        if (subjectType is null) return;
        categories = (await Members.ReportCategoriesAsync(serious: true)).Value ?? [];
        if (Guid.TryParse(subjectId, out var subject))
            person = ((await Members.SafetyPeopleAsync()).Value ?? []).FirstOrDefault(p => p.SubjectId == subject);
        // A conversation the member can still read offers its messages as evidence; a blocked one can't be read, and its
        // latest messages are preserved anyway.
        if (subjectType == "conversation" && Guid.TryParse(subjectId, out var conversation))
            messages = (await Members.MessagesAsync(conversation)).Value?.Items.Reverse().ToList() ?? [];
    }

    private void Toggle(Guid id)
    {
        if (!chosen.Remove(id) && chosen.Count < 20) chosen.Add(id);
    }

    private async Task SendAsync()
    {
        busy = true;
        var result = await Members.ReportAsync(new NewReport(subjectType!, subjectId!, category ?? "", text, block, police, policeReference,
            chosen.Count > 0 ? chosen.ToList() : null, includeMeeting ? meetingContext : null));
        busy = false;
        if (result.Ok) { done = true; return; }
        (status, message) = (result.Code ?? "failed", result.Code == ProblemCodes.NotAvailable
            ? "We couldn't find that conversation or person. Go back and choose them from People you've dealt with."
            : "That report couldn't be sent. If you're in immediate danger, contact your local emergency services.");
    }
}
