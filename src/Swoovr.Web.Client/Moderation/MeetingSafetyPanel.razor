@implements IAsyncDisposable
@inject MemberClient Members
@inject IJSRuntime JS
<div class="page-heading"><p class="breadcrumb"><a href="/me/safety">Safety</a> / Meeting safety</p><h1>I'm meeting someone</h1></div>
<section class="card account-section notice"><p>@MeetingSafetyText.Disclaimer</p><p>No other participant's profile, photos or messages are shared. Your private note and feedback are shown only to you in member features. Never enter another person's identity or a private address in a shared venue/area.</p></section>
<section class="card account-section stack" aria-labelledby="meeting-advice-heading"><h2 id="meeting-advice-heading">Before meeting</h2><ul>@foreach(var advice in SafetyAdvice.BeforeMeeting){<li>@advice</li>}</ul><p><a class="link" href="@SafetyAdvice.Link">More connection and meeting advice</a></p></section>
@if(message is not null){<p role="status" data-meeting-message>@message</p>}
@if(data is null){<p data-meeting-loading>Meeting safety is loading or unavailable. <a href="/safety">Safety &amp; Support</a> remains available.</p>}
else
{
    @if(data.DeliveryMode=="local-simulation-only"){<p class="notice" data-meeting-simulated>Local prototype: email goes to the local sink; SMS and push are simulated. Nothing is confirmed delivered to contacts or devices.</p>}
    <section class="card account-section stack"><h2>Trusted contacts</h2><p>Keep up to three. Each contact must agree before receiving meeting updates. Changing a destination means removing that contact and adding a fresh invitation. Contacts are never used for marketing.</p>
        <form class="stack" @onsubmit="AddContactAsync" @onsubmit:preventDefault data-trusted-contact-form>
            <div class="field"><label for="contact-owner-name">Your first name</label><input id="contact-owner-name" @bind="firstName" maxlength="50" required/></div>
            <div class="field"><label for="contact-name">Contact name</label><input id="contact-name" @bind="contactName" maxlength="80" required/></div>
            <div class="field"><label for="contact-channel">Channel</label><select id="contact-channel" @bind="channel"><option value="email">Email</option><option value="sms">SMS (only when configured; simulated locally)</option></select></div>
            <div class="field"><label for="contact-destination">@(channel=="sms"?"International mobile (+ country code)":"Email address")</label><input id="contact-destination" @bind="destination" maxlength="254" required autocomplete="off"/></div>
            <button class="button" disabled="@busy" type="submit">Invite trusted contact</button>
        </form>
        <ul class="request-list" data-trusted-contacts>
            @foreach(var contact in data.Contacts)
            {<li data-contact="@contact.Id"><strong>@contact.DisplayName</strong> · @contact.DestinationHint · @contact.Consent<br/><span class="field-help">@MeetingSafetyText.Delivery(contact.InvitationStatus)</span><div class="account-actions">@if(contact.Consent=="pending"){<button type="button" class="button button-secondary" disabled="@busy" @onclick="()=>ResendAsync(contact.Id)">Resend invitation</button>}<button type="button" class="button button-secondary" disabled="@busy" @onclick="()=>RemoveAsync(contact.Id)">Remove contact</button></div></li>}
        </ul>
    </section>
    <section class="card account-section stack"><h2>Emergency assistance country</h2><div class="field"><label for="meeting-country">Country for emergency assistance</label><select id="meeting-country" value="@(country??string.Empty)" @onchange="ChooseCountryAsync"><option value="">Choose your country</option>@foreach(var item in pack?.Countries??[]){<option value="@item.Code">@item.Name</option>}</select></div><p>Select the country you are in. The emergency button opens a dialler only; nothing calls automatically.</p></section>
    <section class="card account-section stack"><h2>New meeting safety session</h2><p>This works independently of Swoovr meeting plans or QR confirmation. Times use the time zone you select, regardless of a contact's device zone.</p>
        <form class="stack" @onsubmit="StartAsync" @onsubmit:preventDefault data-meeting-plan-form>
            <div class="field"><label for="meeting-name">Your preferred first name</label><input id="meeting-name" @bind="firstName" maxlength="50" required/></div>
            <div class="field"><label for="meeting-zone">Meeting time zone</label><select id="meeting-zone" @bind="zone">@foreach(var item in TimeZoneInfo.GetSystemTimeZones().OrderBy(t=>t.BaseUtcOffset)){<option value="@item.Id">@item.Id</option>}</select></div>
            <div class="field"><label for="meeting-start">Start in the selected time zone</label><input id="meeting-start" type="datetime-local" value="@start" @onchange="e=>start=e.Value?.ToString()??string.Empty" required/></div>
            <div class="field"><label for="meeting-end">Final check-in / expected end</label><input id="meeting-end" type="datetime-local" value="@end" @onchange="e=>end=e.Value?.ToString()??string.Empty" required/></div>
            <p class="field-help">Each scheduled check-in has a 30-minute grace period. Missed check-ins alert selected confirmed contacts only; no police or other participant is notified automatically.</p>
            @for(var i=0;i<extra.Count;i++){var at=i;<div class="field"><label for="@($"meeting-extra-{at}")">Additional check-in @(at+1)</label><input id="@($"meeting-extra-{at}")" type="datetime-local" value="@extra[at]" @onchange="e=>extra[at]=e.Value?.ToString()??string.Empty"/><button type="button" class="button button-secondary" @onclick="()=>extra.RemoveAt(at)">Remove additional check-in</button></div>}
            <button type="button" class="button button-secondary" disabled="@(extra.Count>=10)" @onclick="()=>extra.Add(end)">Add optional check-in</button>
            <div class="field"><label for="meeting-place">Public venue / area</label><input id="meeting-place" @bind="place" maxlength="160"/></div>
            <label class="check"><input type="checkbox" @bind="sharePlace"/><span class="box" aria-hidden="true"></span>Share this public venue or general area with selected contacts</label>
            <div class="field"><label for="meeting-note">Private note (not shared with contacts)</label><textarea id="meeting-note" @bind="note" maxlength="500"></textarea></div>
            <fieldset><legend>Choose confirmed contacts</legend>@foreach(var contact in data.Contacts.Where(c=>c.Consent=="confirmed")){<label class="check"><input type="checkbox" checked="@selected.Contains(contact.Id)" @onchange="()=>Toggle(contact.Id)"/><span class="box" aria-hidden="true"></span>@contact.DisplayName</label>}</fieldset>
            <button type="submit" class="button" disabled="@busy">Start voluntary monitoring</button>
        </form>
    </section>
    @foreach(var session in data.Sessions)
    {
        <section class="card account-section stack" data-meeting-session="@session.Id" data-meeting-state="@session.Status"><h2>@MeetingSafetyText.Status(session.Status)</h2><p>@MeetingSafetyText.Time(session.StartsAt,session.TimeZoneId) → @MeetingSafetyText.Time(session.FinalCheckInAt,session.TimeZoneId)</p>
            @foreach(var contact in session.Recipients){<p>@contact.DisplayName · @contact.Consent@(contact.Revoked?" (revoked)":"") · @MeetingSafetyText.Delivery(contact.NotificationStatus)</p>}
            @foreach(var check in session.CheckIns){<div data-meeting-check-in="@check.Id"><p>Check-in: @MeetingSafetyText.Time(check.DueAt,session.TimeZoneId). Grace ends: @MeetingSafetyText.Time(check.GraceEndsAt,session.TimeZoneId). @(check.Response??(check.EscalatedAt is not null?"Missed / unconfirmed":"Pending"))</p>@if(check.RespondedAt==null&&session.ClosedAt==null){<div class="account-actions"><button class="button" type="button" disabled="@(busy||check.DueAt>DateTimeOffset.UtcNow)" @onclick='()=>ActAsync(session.Id,"ok",check.Id)'>I'm OK</button><button class="button button-secondary" type="button" disabled="@busy" @onclick='()=>ActAsync(session.Id,"extend",check.Id)'>Extend by 30 minutes</button></div>}</div>}
            @if(session.ClosedAt==null)
            {
                <div class="account-actions"><button type="button" class="button" disabled="@busy" @onclick='()=>ActAsync(session.Id,"home-safe")'>I'm home safe</button><button type="button" class="button button-secondary" disabled="@busy" @onclick='()=>ActAsync(session.Id,"end")'>End meeting</button><button type="button" class="button button-secondary" disabled="@busy" @onclick='()=>ActAsync(session.Id,"cancel")'>Cancel meeting</button><button type="button" class="button button-secondary" disabled="@busy" @onclick='()=>ActAsync(session.Id,"help")'>Need help: notify selected contacts</button></div>
                @if(emergency is{Phone:not null}){<a class="button" href="tel:@emergency.Phone">Open emergency dialler — @emergency.PhoneDisplay</a>}else{<p>No current verified emergency number is selected. <a class="link" href="/safety">Choose your country in Safety &amp; Support</a>.</p>}
                <p>The emergency link opens your device's dialler; it never places a call automatically.</p>
                <label class="check"><input type="checkbox" @bind="includeLocation"/><span class="box" aria-hidden="true"></span>Include a location link in the device SMS only (optional; coordinates are not sent to Swoovr)</label>
                @foreach(var contact in session.Recipients.Where(r=>!r.Revoked&&r.Consent=="confirmed")){var current=data.Contacts.FirstOrDefault(c=>c.Id==contact.ContactId);@if(current?.Channel=="sms"){<button type="button" class="button button-secondary" disabled="@busy" @onclick="()=>ComposeAsync(session,contact.ContactId)">Alert @contact.DisplayName using my SMS composer</button>}}
                <p class="field-help">The device SMS composer needs a confirmed SMS contact. Email contacts still receive eligible server alerts. @MeetingSafetyText.Composer</p>
            }
            @if(session.ShowAfterPrompt)
            {<div data-meeting-after><h3>How did it go? (optional)</h3><div class="field"><label for="@($"feedback-{session.Id}")">Private feedback (your member view)</label><textarea id="@($"feedback-{session.Id}")" maxlength="1000" @onchange="e=>feedbacks[session.Id]=e.Value?.ToString()??string.Empty"></textarea></div><div class="account-actions"><button type="button" class="button button-secondary" @onclick='()=>ActAsync(session.Id,"feedback")'>Save private feedback</button><a class="link" href="@($"/me/safety?meeting={session.Id}#serious")">Report an incident</a><button type="button" class="button button-secondary" @onclick='()=>ActAsync(session.Id,"dismiss")'>Dismiss</button></div><p>Feedback does not affect anyone's reputation. A report is a separate explicit action; the other person is not automatically notified.</p></div>}
            <a class="link" href="@($"/me/safety?meeting={session.Id}#serious")">Report an incident from this meeting</a>
            @if(session.PrivateFeedback is{}saved){<p data-meeting-feedback>Your private feedback: @saved</p>}
        </section>
    }
}
@code{
    private MeetingSafetyDashboard? data;private string? message;private bool busy,sharePlace,includeLocation;private string firstName="",contactName="",channel="email",destination="",zone="UTC",place="",note="";private readonly Dictionary<Guid,string> feedbacks=[];
    private string start=DateTime.UtcNow.AddHours(1).ToString("yyyy-MM-ddTHH:mm"),end=DateTime.UtcNow.AddHours(3).ToString("yyyy-MM-ddTHH:mm");private readonly List<string> extra=[];private readonly HashSet<Guid> selected=[];private SafetyResourceView? emergency;private SafetyPack? pack;private string? country;
    protected override async Task OnInitializedAsync(){await LoadAsync();poller=PollAsync();}
    protected override async Task OnAfterRenderAsync(bool first){if(first){try{var value=await JS.InvokeAsync<DeviceClock>("swoovrMeeting.clock");zone=value.Zone;start=value.Start;end=value.End;country=SafetyText.Manual(await JS.InvokeAsync<string?>("sessionStorage.getItem",SafetyText.ChoiceKey));await LoadCountryAsync();StateHasChanged();}catch(JSException){}}}
    private sealed record DeviceClock(string Zone,string Start,string End);
    private async Task LoadAsync(){try{var result=await Members.MeetingSafetyAsync();data=result.Value;if(!result.Ok)message=MeetingSafetyText.Problem(result.Code);selected.RemoveWhere(id=>data is not null&&!data.Contacts.Any(c=>c.Id==id&&c.Consent=="confirmed"));await LoadCountryAsync();}catch(Exception error)when(error is HttpRequestException or TaskCanceledException){message="Status could not refresh. Do not rely on an unconfirmed alert.";}}
    private async Task LoadCountryAsync(){pack=(await Members.SafetyAsync(country??"XX")).Value;emergency=country is not null&&pack is{Readiness:"ready",Stale:false}?pack.Resources.FirstOrDefault(r=>r.Category=="emergency"&&r.Phone!=null&&r.LastVerifiedOn!=null):null;}
    private async Task ChooseCountryAsync(ChangeEventArgs e){country=SafetyText.Manual(e.Value?.ToString());if(country is not null)try{await JS.InvokeVoidAsync("sessionStorage.setItem",SafetyText.ChoiceKey,country);}catch(JSException){}await LoadCountryAsync();}
    private void Toggle(Guid id){if(!selected.Remove(id))selected.Add(id);}
    private async Task AddContactAsync(){if(busy)return;busy=true;try{var result=await Members.AddTrustedContactAsync(new(contactName,channel,destination,firstName));message=result.Ok?"Invitation queued. Wait for your contact to confirm; acceptance is not delivery.":MeetingSafetyText.Problem(result.Code);if(result.Ok){contactName="";destination="";}await LoadAsync();}catch(Exception error)when(error is HttpRequestException or TaskCanceledException){message="Action outcome unconfirmed. Refresh status before repeating; do not rely on an unconfirmed alert.";}finally{busy=false;}}
    private async Task RemoveAsync(Guid id){busy=true;try{var result=await Members.RemoveTrustedContactAsync(id);message=result.Ok?"Contact removed; their meeting links are revoked.":MeetingSafetyText.Problem(result.Code);selected.Remove(id);await LoadAsync();}catch(Exception error)when(error is HttpRequestException or TaskCanceledException){message="Action outcome unconfirmed. Refresh status before repeating; do not rely on an unconfirmed alert.";}finally{busy=false;}}
    private async Task ResendAsync(Guid id){busy=true;try{var result=await Members.ResendTrustedContactAsync(id);message=result.Ok?"Invitation resend queued; delivery is not confirmed.":MeetingSafetyText.Problem(result.Code);await LoadAsync();}catch(Exception error)when(error is HttpRequestException or TaskCanceledException){message="Action outcome unconfirmed. Refresh status before repeating; do not rely on an unconfirmed alert.";}finally{busy=false;}}
    private async Task StartAsync(){if(busy)return;if(!MeetingSafetyText.TryUtc(start,zone,out var starts)||!MeetingSafetyText.TryUtc(end,zone,out var ends)){message="Check the selected time zone. Daylight-saving skipped or repeated local times need a different clear time.";return;}var times=new List<DateTimeOffset>();foreach(var value in extra){if(!MeetingSafetyText.TryUtc(value,zone,out var time)){message="Check additional check-in times.";return;}times.Add(time);}busy=true;try{var result=await Members.StartMeetingSafetyAsync(new(firstName,starts,ends,zone,place,sharePlace,note,selected.ToList(),times));message=result.Ok?"Voluntary monitoring scheduled. Contact alerts remain unconfirmed until the provider accepts them; arrival is not guaranteed.":MeetingSafetyText.Problem(result.Code);await LoadAsync();}catch(Exception error)when(error is HttpRequestException or TaskCanceledException){message="Action outcome unconfirmed. Refresh status before repeating; do not rely on an unconfirmed alert.";}finally{busy=false;}}
    private async Task ActAsync(Guid session,string action,Guid? check=null){if(busy)return;busy=true;try{var result=await Members.MeetingSafetyActionAsync(session,new(Guid.NewGuid(),action,check,action=="feedback"?feedbacks.GetValueOrDefault(session):null));message=result.Ok?"Meeting safety updated.":MeetingSafetyText.Problem(result.Code);await LoadAsync();}catch(Exception error)when(error is HttpRequestException or TaskCanceledException){message="Action outcome unconfirmed. Refresh status before repeating; do not rely on an unconfirmed alert.";}finally{busy=false;}}
    private async Task ComposeAsync(MeetingSafetySessionView session,Guid contact){if(busy)return;busy=true;try{var result=await Members.TrustedContactComposeAsync(contact);if(result.Value is not{Channel:"sms"} destination){message="This contact has no confirmed SMS destination.";return;}var body=$"I'm meeting someone. Meeting: {MeetingSafetyText.Time(session.StartsAt,session.TimeZoneId)}. Expected check-in: {MeetingSafetyText.Time(session.FinalCheckInAt,session.TimeZoneId)}. Please contact me directly if concerned.";try{await JS.InvokeVoidAsync("swoovrMeeting.compose",destination.Destination,body,includeLocation);message=MeetingSafetyText.Composer;}catch(JSException){message="The SMS composer or optional location was unavailable. Nothing is confirmed sent.";}}catch(Exception error)when(error is HttpRequestException or TaskCanceledException){message="Composer request failed; nothing is confirmed sent.";}finally{busy=false;}}
    private readonly CancellationTokenSource stop=new();private Task? poller;
    private async Task PollAsync()
    {
        using var timer=new PeriodicTimer(TimeSpan.FromSeconds(15));
        try{while(await timer.WaitForNextTickAsync(stop.Token)){if(busy)continue;try{var result=await Members.MeetingSafetyAsync(stop.Token);if(result.Value is{}updated){data=updated;await InvokeAsync(StateHasChanged);}}catch(Exception error)when(error is HttpRequestException||error is TaskCanceledException&&!stop.IsCancellationRequested){message="Status could not refresh. Do not rely on an unconfirmed alert.";await InvokeAsync(StateHasChanged);}}}
        catch(OperationCanceledException)when(stop.IsCancellationRequested){}
    }
    public async ValueTask DisposeAsync(){stop.Cancel();if(poller is not null)await poller;stop.Dispose();}

}
