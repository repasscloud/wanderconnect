@* Notices about actions on the member's account and the status of their own reports (D131, D135). Open even while
   suspended, so a member can read why and appeal: one appeal per action within 30 days. *@
@inject MemberClient Members
<div class="page-heading" data-notices="@(loaded ? "ready" : "loading")">
    <p class="breadcrumb"><a href="/account">Me</a> / Notices and reports</p>
    <h1>Notices and reports</h1>
    @if (!loaded) { <p role="status">Loading…</p> }
</div>
@if (loaded)
{
    <section class="card account-section" aria-labelledby="notices-heading">
        <h2 id="notices-heading">About your account</h2>
        @if (notices.Count == 0) { <p class="field-help" data-notice-list="none">No notices.</p> }
        else
        {
            <ul class="request-list" data-notice-list="@notices.Count">
                @foreach (var n in notices)
                {
                    <li data-notice="@n.Id" data-notice-kind="@n.Kind">
                        <p><strong>@MemberText.NoticeTitle(n.Kind)</strong> <span class="field-help">@n.CreatedAt.ToString("d MMM yyyy")</span></p>
                        @if (n.Sanction is { } s)
                        {
                            <p>@s.Reason</p>
                            @if (s.EndsAt is { } end && s.Live) { <p class="field-help">Until @end.ToString("d MMM yyyy").</p> }
                            @if (s.AppealStatus is { } appeal) { <p class="field-help" data-appeal-status="@appeal">Appeal: @MemberText.AppealStatus(appeal)</p> }
                            else if (MemberText.Appealable(n))
                            {
                                @if (appealing == s.Id)
                                {
                                    <form class="stack" @onsubmit="() => AppealAsync(s.Id)" data-appeal-form>
                                        <div class="field"><label for="appeal-@s.Id">Why should we look again? (optional)</label><textarea id="appeal-@s.Id" maxlength="2000" rows="3" @bind="appealText"></textarea></div>
                                        <button type="submit" class="button" disabled="@busy">Send appeal</button>
                                    </form>
                                }
                                else { <button type="button" class="button button-secondary" @onclick="() => appealing = s.Id" data-appeal-open="@s.Id">Appeal</button> }
                            }
                        }
                    </li>
                }
            </ul>
        }
        <p role="status" aria-live="polite" class="field-help" data-notices-status="@status">@message</p>
    </section>
    <section class="card account-section" aria-labelledby="reports-heading">
        <h2 id="reports-heading">Your reports</h2>
        @if (reports.Count == 0) { <p class="field-help" data-my-reports="none">You haven't reported anything.</p> }
        else
        {
            <ul class="request-list" data-my-reports="@reports.Count">
                @foreach (var r in reports) { <li data-my-report="@r.Id" data-report-state="@r.Status">@r.CreatedAt.ToString("d MMM yyyy"): @MemberText.ReportStatus(r.Status)</li> }
            </ul>
        }
    </section>
}
@code {
    private bool loaded, busy;
    private List<NoticeView> notices = [];
    private List<MyReportView> reports = [];
    private Guid? appealing;
    private string? appealText, status, message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        loaded = true;
        foreach (var n in notices.Where(n => !n.Read)) await Members.ReadNoticeAsync(n.Id);
    }

    private async Task LoadAsync()
    {
        notices = (await Members.NoticesAsync()).Value ?? [];
        // A suspended member can't list reports (their account is barred), so this may be empty.
        reports = (await Members.MyReportsAsync()).Value ?? [];
    }

    private async Task AppealAsync(Guid sanctionId)
    {
        busy = true;
        var result = await Members.AppealAsync(sanctionId, appealText);
        busy = false;
        (status, message) = result.Ok ? ("appealed", "Your appeal was sent. Someone who wasn't involved will review it.") : (result.Code ?? "failed", "That appeal couldn't be sent.");
        (appealing, appealText) = (null, null);
        await LoadAsync();
    }
}
