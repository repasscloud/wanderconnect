@* Download your data and delete your account (D144, D170–D173), Interactive WebAssembly through /bff/. Asking for an
   export or a deletion, cancelling and deleting now need a sign-in within five minutes; when the API answers
   stale-session the panel shows a compact sign-in notice inside the card that was used (issue 258), linking to
   /account/reauthenticate, which returns here. Issue 258 (D343): full-width text, normal-size buttons, deletion as three
   short facts, and the owner's subscription cancellation and refund terms. *@
@inject MemberClient Members
@inject IJSRuntime JS
<div class="data-page">
<div class="data-head" data-data-panel="@(loaded ? (view?.State ?? "error") : "loading")">
    <p class="breadcrumb"><a href="/account">Me</a> / Data and account</p>
    <h1>@(view?.State == "pending" ? DeletionText.PendingTitle(view) : DeletionText.Title)</h1>
    @if (!loaded) { <p role="status">Loading…</p> }
    else if (view?.State == "pending") { <p class="data-pending-body" data-deletion-due="@view.DueAt?.ToString("o")">@DeletionText.PendingBody(view)</p> }
    @* #99: what's kept after deletion and why is in the privacy notice (approved D288/D290). *@
    <p>@DeletionText.Intro Our <a href="/privacy" data-privacy-link>Privacy Notice</a> explains what we keep after deletion, for how long and why.</p>
</div>
@if (loaded && view is null)
{
    <p role="status" class="notice">@DeletionText.Failed</p>
}
else if (view is not null)
{
    @if (view.State == "pending")
    {
        <section class="settings-card data-card" aria-label="Pending deletion" data-pending-deletion="true">
            @if (view.SignedOutEverywhere) { <p class="data-note">You've been signed out on your other devices.</p> }
            @if (view.FounderCodeEmailed) { <p class="data-note" data-founder-code-emailed="true">We've emailed your founder recovery code.</p> }
            @if (view.FinalizingAt is null)
            {
                <div class="data-actions data-actions-start">
                    <button type="button" class="button" disabled="@busy" @onclick="CancelAsync" data-cancel-deletion>Cancel deletion</button>
                    @if (!DeletingNow) { <button type="button" class="button button-secondary" disabled="@busy" @onclick="DeleteNowAsync" data-delete-now>Delete now</button> }
                </div>
                @if (reauth == "delete") { <SignInNotice Text="@DeletionText.SignInAgainContinue" ReturnUrl="@ReturnUrl" /> }
                <p role="status" aria-live="polite" class="data-note" data-delete-result>@deleteMessage</p>
            }
            else
            {
                <p class="data-note" data-deletion-finalizing><a href="@StandingText.SupportUrl">Contact Support</a> · <a href="@("mailto:" + StandingText.SupportEmail)">Email Support</a></p>
            }
        </section>
    }
    <section class="settings-card data-card" aria-labelledby="export-heading">
        <div class="data-card-top">
            <div class="settings-card-head">
                <h2 id="export-heading">@DeletionText.ExportHeading</h2>
                <p>@DeletionText.ExportDescription</p>
            </div>
            <button type="button" class="button button-secondary data-download" disabled="@busy" @onclick="ExportAsync" data-export><Swoovr.Web.Client.UI.Icon Name="download" Size="20" /> Download my data</button>
        </div>
        <ul class="data-meta">
            <li><Swoovr.Web.Client.UI.Icon Name="clock" Size="18" /> @DeletionText.ExportLinkOnce</li>
            <li><Swoovr.Web.Client.UI.Icon Name="calendar" Size="18" /> @DeletionText.ExportDaily</li>
        </ul>
        @if (reauth == "export") { <SignInNotice Text="@DeletionText.SignInAgainExport" ReturnUrl="@ReturnUrl" /> }
        <div role="status" aria-live="polite" data-export-result="@exportResult">
            @if (exportResult == "downloaded")
            {
                <div class="data-done"><Swoovr.Web.Client.UI.Icon Name="check" Size="20" /><div><strong>@DeletionText.ExportDownloaded</strong><span>@exportFile</span></div></div>
            }
            else if (exportMessage is not null)
            {
                <div class="data-inline"><Swoovr.Web.Client.UI.Icon Name="@(exportResult == ProblemCodes.ExportTooSoon ? "clock" : "alert")" Size="20" /><p class="data-inline-text">@exportMessage</p></div>
            }
        </div>
    </section>
    @if (view.State != "pending")
    {
        <section class="settings-card data-card" aria-labelledby="delete-heading" data-delete-form>
            <div class="settings-card-head">
                <h2 id="delete-heading">@DeletionText.DeleteHeading</h2>
                <p>@DeletionText.DeleteIntro</p>
            </div>
            <ul class="data-facts">
                <li><Swoovr.Web.Client.UI.Icon Name="x" Size="20" /><div><strong>@DeletionText.FactOffTitle</strong><span>@DeletionText.FactOffBody</span></div></li>
                <li><Swoovr.Web.Client.UI.Icon Name="calendar" Size="20" /><div><strong>@DeletionText.FactWindowTitle</strong><span>@DeletionText.FactWindowBody</span></div></li>
                <li><Swoovr.Web.Client.UI.Icon Name="shield" Size="20" /><div><strong>@DeletionText.FactKeptTitle</strong><span>@DeletionText.FactKeptBody <a href="/privacy">Privacy Notice</a></span></div></li>
            </ul>
            @if (view.Founder) { <p class="data-note" data-founder-notice="true">@DeletionText.FounderKept</p> }
            <SubscriptionTerms />
            <form class="data-confirm" @onsubmit="RequestAsync">
                <label class="check"><input type="checkbox" @bind="immediately" data-delete-immediately /><span class="box"><Icon Name="check" Size="15" Stroke="2.5" /></span> @DeletionText.DeleteNowOption</label>
                @if (view.Founder) { <label class="check"><input type="checkbox" @bind="deleteFounderToken" data-delete-founder-token /><span class="box"><Icon Name="check" Size="15" Stroke="2.5" /></span> @DeletionText.FounderDeleteOption</label> }
                <label class="check"><input type="checkbox" @bind="confirmed" data-delete-confirm /><span class="box"><Icon Name="check" Size="15" Stroke="2.5" /></span> @DeletionText.Confirm</label>
                @if (reauth == "delete") { <SignInNotice Text="@DeletionText.SignInAgainContinue" ReturnUrl="@ReturnUrl" /> }
                <div class="data-actions"><button type="submit" class="button" disabled="@(busy || !confirmed)" data-delete-account>Delete my account</button></div>
                <p role="status" aria-live="polite" class="data-note" data-delete-result>@deleteMessage</p>
            </form>
        </section>
    }
}
</div>
@code {
    private bool loaded, busy, confirmed, immediately, deleteFounderToken;
    /// <summary>Which card asked for a fresh sign-in ("export" or "delete"); null when none did.</summary>
    private string? reauth;
    private DeletionView? view;
    private string? exportMessage, exportResult, exportFile, deleteMessage;
    private string ReturnUrl => view?.State == "pending" ? "/account/deletion" : "/account/data";
    private bool DeletingNow => view?.DueAt is { } due && due <= DateTimeOffset.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        try { view = (await Members.DeletionAsync()).Value; }
        catch (HttpRequestException) { view = null; }
        loaded = true;
    }

    private async Task ExportAsync()
    {
        (busy, reauth, exportMessage, exportResult) = (true, null, null, null);
        try
        {
            var ticket = await Members.RequestExportAsync();
            if (ticket.Value is null) { Refused(ticket.Code, "export", m => exportMessage = m); exportResult = ticket.Code ?? "failed"; return; }
            var file = await Members.DownloadExportAsync(ticket.Value);
            if (file.Value is null) { Refused(file.Code, "export", m => exportMessage = m); exportResult = file.Code ?? "failed"; return; }
            exportFile = $"swoovr-data-{DateTime.UtcNow:yyyy-MM-dd}.json";
            await JS.InvokeAsync<bool>("swoovrDownload.save", exportFile, "application/json", Convert.ToBase64String(file.Value));
            exportResult = "downloaded";
        }
        finally { busy = false; }
    }

    private async Task RequestAsync()
    {
        (busy, reauth, deleteMessage) = (true, null, null);
        var result = await Members.RequestDeletionAsync(new DeletionRequest(confirmed, immediately, deleteFounderToken));
        busy = false;
        if (result.Value is null) { Refused(result.Code, "delete", m => deleteMessage = m); return; }
        view = result.Value;
    }

    private async Task CancelAsync() => await ChangeAsync(Members.CancelDeletionAsync);
    private async Task DeleteNowAsync() => await ChangeAsync(Members.DeleteNowAsync);

    private async Task ChangeAsync(Func<CancellationToken, Task<ApiResult<DeletionView>>> call)
    {
        (busy, reauth, deleteMessage) = (true, null, null);
        var result = await call(default);
        busy = false;
        if (result.Value is null) { Refused(result.Code, "delete", m => deleteMessage = m); return; }
        view = result.Value;
        // Cancelled: the rest of the app opens again, so go back to the account page.
        if (view.State == "none") deleteMessage = "Deletion cancelled. Your account is back.";
    }

    private void Refused(string? code, string card, Action<string> show)
    {
        if (DeletionText.Refusal(code) is { } message) show(message);
        else reauth = card;
    }
}
