@* Account settings (issue 180; Interactive WebAssembly, D59). Personal information, contact information and security
   only: badges live under Verification and the coupon under Membership & billing. Account-state gates (D127, D160,
   D170, D300) and setup steps (D148, D139) are unchanged. Account management (sign out, data, delete) is rendered by
   the static host page so sign-out keeps its antiforgery token. *@
@inject MemberClient Members
<div class="settings-page-head" data-account-panel="@(loaded ? "ready" : "loading")" data-member-area="@(session?.MemberArea == true ? "true" : "false")" data-adult-attested="@(session?.AdultAttested == true ? "true" : "false")">
    <h1>Account settings</h1>
    <p>Manage your personal information, security and account preferences.</p>
</div>
@if (!loaded)
{
    <p role="status" class="settings-status">Loading your account…</p>
}
else
{
    <EmailChangeNotice Problem="@session?.EmailChangeProblem" />
    @if (session is null)
    {
        <p role="status" class="notice">We couldn't load your account. Try signing in again.</p>
    }
    else if (BetaBlocked)
    {
        @* D77: same words whatever the reason, so the page never says whether an address was ever enrolled. *@
        <div class="notice" role="status" data-beta="@session.Beta">
            <p><strong>Swoovr is currently invite-only.</strong> You're not on the list yet.</p>
            <p><a class="link" href="@AccountText.BetaUrl">Ask to join the beta on swoovr.com</a></p>
        </div>
    }
    @if (locked)
    {
        <section class="settings-card" aria-label="Account locked" data-account-locked="true">
            <h2>This account is locked.</h2>
            <p>Swoovr is for adults only. If the age you entered was a mistake, contact Swoovr support to have it reviewed.</p>
        </section>
    }
    else if (me is not null && me.AccountState == "pendingDeletion")
    {
        @* D170: a pending deletion closes the rest of the app; the deletion screen offers cancel and delete now. *@
        <section class="settings-card" aria-label="Account being deleted" data-pending-deletion="true">
            <h2>Your account is being deleted</h2>
            <p>Open deletion details to check the status and whether recovery is still available.</p>
            <p><a class="button button-small" href="/account/deletion">See deletion details</a></p>
        </section>
    }
    else if (me is not null && me.AccountState != "active")
    {
        @* D160: restricted, suspended or terminated: nothing else in the app until it's lifted; notices and appeals stay open. *@
        <section class="settings-card" aria-label="Account restricted" data-restricted-screen="@me.AccountState">
            <h2>@(me.AccountState switch { "suspended" => "Your account is suspended", "terminated" => "Your account has been closed", _ => "Your account is restricted" })</h2>
            <p>You can't use Swoovr until this is lifted. Read the notice to see why; you can appeal within 30 days.</p>
            <p><a class="button button-small" href="/me/notices">Read the notice</a></p>
        </section>
    }
    else if (me is not null)
    {
        @if (me.RegisteredNamesRequired) { <p class="notice" role="status" data-registered-name-gate>Confirm your registered name below to continue. Your data, account notices and support remain available.</p> }
        else if (me.PolicyRequired) { <p class="notice" role="status" data-policy-gate>Please review the required policies. <a href="/account/policies">Review and choose whether to accept</a></p> }
        <DobCorrectionPrompt Account="me" Changed="Corrected" />
        @if (!me.PhoneRequired && !me.RegisteredNamesRequired && me.DateOfBirth is not null) { <FirstUseSafetyAdvice /> }
        @if (me.AgeStatus == "needsVerification")
        {
            @* D127: the rest of the app answers age-verification-required until the check passes or support resolves it. *@
            <section class="settings-card" aria-label="Age check needed" data-age-check-required="true">
                <h2>Please verify your age</h2>
                <p>We need to confirm you're 18 or over before you can keep using Swoovr.</p>
                <p><a class="button button-small" href="/me/verification">Verify my ID</a></p>
            </section>
        }
        @if (me.PhoneRequired) { <p class="settings-step" data-setup-step="phone">Step 1 of 2 · Verify your mobile number</p> }
        else if (!me.RegisteredNamesRequired && me.DateOfBirth is null) { <p class="settings-step" data-setup-step="age">@(me.PhoneGateEnabled ? "Step 2 of 2" : "Step 1 of 1") · Confirm your date of birth</p> }
        <div class="settings-grid">
            <section class="settings-card" aria-labelledby="personal-title" id="personal">
                <div class="settings-card-head"><h2 id="personal-title">Personal information</h2></div>
                <RegisteredNamesPanel Changed="NamesChangedAsync" />
                @if (!me.PhoneRequired)
                {
                    <div id="setup-age" class="settings-dob">
                        @* D139: a date of birth is required and never shown; your age shows unless you hide it (Who I'd like to meet). *@
                        @if (me.DobCheck != "none")
                        {
                            <div class="settings-row"><div class="settings-row-text"><p class="settings-row-label">Date of birth</p>
                                <p class="settings-row-help" data-dob-locked="@me.DobCheck">@(me.DobCheck == "correctionNeeded" ? "Set your date of birth in the prompt above to finish ID verification." : "Swoovr is checking your date of birth, so it can't be changed for now.")</p></div></div>
                        }
                        else if (me.DateOfBirth is not null && !(me.DateOfBirthCorrectionUntil > DateTimeOffset.UtcNow))
                        {
                            <div class="settings-row" data-dob-locked="saved">
                                <div class="settings-row-text"><p class="settings-row-label">Date of birth</p>
                                    <p class="settings-row-value">@me.DateOfBirth.Value.ToString("d MMMM yyyy")<span class="settings-tag settings-tag-quiet">Locked</span>@if (me.DateOfBirthVerified) { <span class="settings-tag" data-dob-verified="true">Verified with ID</span> }</p></div>
                                <a class="settings-row-action" href="@StandingText.SupportUrl" rel="noopener" aria-label="Request a date of birth correction">Request a correction</a>
                            </div>
                        }
                        else
                        {
                            <form class="settings-form" @onsubmit="SaveAgeAsync" data-age-form>
                                <p class="settings-row-label">Date of birth</p>
                                <p class="settings-row-help">Your date of birth is never shown; your age is, unless you hide it.</p>
                                <div class="field"><label for="dob">Date of birth</label><input id="dob" type="date" required @bind="dateOfBirth" max="@Today" /></div>
                                @if (me.DateOfBirthCorrectionUntil is { } until) { <p class="settings-row-help">You can correct it once until @until.ToString("d MMMM yyyy").</p> }
                                <label class="settings-check"><input type="checkbox" @bind="dobConfirmed" required /> I confirm this date is correct. It will be locked after saving.</label>
                                <button type="submit" class="button button-small" disabled="@(busy || dateOfBirth is null || !dobConfirmed)">Save date of birth</button>
                                <p role="status" aria-live="polite" class="settings-status" data-age-status="@AgeStatus">@ageMessage</p>
                            </form>
                        }
                    </div>
                }
            </section>
            <section class="settings-card" aria-labelledby="contact-title" id="contact">
                <div class="settings-card-head"><h2 id="contact-title">Contact information</h2></div>
                <div class="settings-row">
                    <div class="settings-row-text"><p class="settings-row-label">Email address</p>
                        <p class="settings-row-value" data-email-verified="@(session?.EmailVerified == true ? "true" : "false")">@if (session?.EmailVerified == true) { <text>Verified email address</text> } else { <text>Email address</text><span class="settings-tag settings-tag-quiet">Not verified</span> }</p></div>
                    @* Q126 A: Keycloak's update-email step verifies the new address; the API then re-checks it (banned
                       identifiers, contact history) and keeps the old address if that fails (EmailChangeNotice). *@
                    <a class="settings-row-action" href="/account/action/email" data-enhance-nav="false" data-email-change>Change</a>
                </div>
                <div id="setup-phone"><PhonePanel Changed="PhoneChanged" /></div>
            </section>
            <section class="settings-card" aria-labelledby="security-title" id="security">
                <div class="settings-card-head"><h2 id="security-title">Security &amp; access</h2></div>
                <div class="settings-row">
                    <div class="settings-row-text"><p class="settings-row-label">Password</p><p class="settings-row-value">Change the password you sign in with.</p></div>
                    <a class="settings-row-action" href="/account/action/password" data-enhance-nav="false" data-password-change>Change</a>
                </div>
                <div class="settings-row">
                    <div class="settings-row-text"><p class="settings-row-label">Passkeys</p><p class="settings-row-value">Sign in with your face, fingerprint or device PIN.</p></div>
                    <a class="settings-row-action" href="/account/action/passkey" data-enhance-nav="false" data-passkey-add>Add a passkey</a>
                </div>
                @if (session is not null)
                {
                    <div class="settings-row">
                        <div class="settings-row-text"><p class="settings-row-label">Signed in with</p>
                            <p class="settings-row-value" data-session-method="@session.Method">@AccountText.MethodLabel(session.Method)@(session.MultiFactor ? " and a one-time code" : "")</p></div>
                    </div>
                }
            </section>
        </div>
    }
}
@code {
    private bool loaded, busy, locked, dobConfirmed;
    private SessionSummary? session;
    private MemberAccount? me;
    private DateOnly? dateOfBirth;
    private string? ageMessage;
    private bool BetaBlocked => AccountText.BetaBlocked(session);
    private string AgeStatus => me?.AgeStatus ?? "";
    private static string Today => DateTime.UtcNow.ToString("yyyy-MM-dd");

    private async Task PhoneChanged(PhoneView view) { Show(await Members.MeAsync()); }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            session = (await Members.SessionAsync()).Value;
            if (session is { MemberArea: true }) Show(await Members.MeAsync());
            else if (session is not null && (await Members.MeAsync()).Code == ProblemCodes.AccountLocked) locked = true;
        }
        catch (HttpRequestException) { session = null; }
        loaded = true;
    }

    private void Show(ApiResult<MemberAccount> result)
    {
        if (result.Code == ProblemCodes.AccountLocked) { (locked, me) = (true, null); return; }
        if (result.Value is not { } account) return;
        me = account;
        dateOfBirth = account.DateOfBirth;
        dobConfirmed = false;
    }

    private async Task SaveAgeAsync()
    {
        busy = true;
        var result = await Members.SaveAgeAsync(new AgeUpdate(dateOfBirth, null, dobConfirmed));
        busy = false;
        if (result.Code is ProblemCodes.InvalidAge or ProblemCodes.DateOfBirthRequired) { ageMessage = AccountText.InvalidAge; return; }
        if (result.Code == ProblemCodes.DateOfBirthLocked) { ageMessage = "Your saved date of birth is locked. Request a correction at https://swoovr.com/support."; return; }
        if (result.Code == ProblemCodes.DobConfirmationRequired) { ageMessage = "Confirm the date is correct before saving."; return; }
        Show(result);
        ageMessage = locked ? null : AccountText.AgeSaved(me);
    }

    private async Task NamesChangedAsync() => Show(await Members.MeAsync());

    private void Corrected(MemberAccount updated) => (me, dateOfBirth, ageMessage) = (updated, updated.DateOfBirth,
        updated.DateOfBirthVerified ? "Thanks. Your date of birth now matches your ID." : "Thanks. It still differs from your ID, so Swoovr's team will check it.");
}
