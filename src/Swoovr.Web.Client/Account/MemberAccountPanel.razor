@* The signed-in account page (Interactive WebAssembly, D59). Everything here comes from the API through the
   host's backend-for-frontend: session, beta gate (D62), badges (D55), age entry (D69) and the coupon code
   screen for founder codes (D65). The host page keeps sign-in, sign-out and settings links static. *@
@inject MemberClient Members
<div class="page-heading" data-account-panel="@(loaded ? "ready" : "loading")">
    <p class="breadcrumb"><a href="/">Me</a> / Account</p>
    @if (!loaded)
    {
        <h1>Hello, @Name.</h1>
        <p role="status">Loading your account…</p>
    }
    else if (session is not null && BetaBlocked)
    {
        <h1>Almost there, @Name.</h1>
        <p>You're signed in. The Swoovr app opens once your email is on the private beta list.</p>
    }
    else
    {
        <h1>You're in, @Name.</h1>
        <p>Manage your Swoovr account, profile and connections.</p>
    }
</div>
@if (loaded)
{
    <EmailChangeNotice Problem="@session?.EmailChangeProblem" />
    <section class="card account-session" aria-label="Your session">
        @if (session is null)
        {
            <p role="status">We couldn't confirm your session with the Swoovr API. Try signing in again.</p>
        }
        else
        {
            @if (BetaBlocked)
            {
                @* D77: same words whatever the reason, so the page never says whether an address was ever enrolled. *@
                <div class="notice" role="status" data-beta="@session.Beta">
                    <p><strong>Swoovr is in private beta.</strong> You're not on the list yet.</p>
                    <p><a class="link" href="@AccountText.BetaUrl">Ask to join the beta on swoovr.com</a></p>
                </div>
            }
            <dl>
                <div><dt>Signed in with</dt><dd data-session-method="@session.Method">@AccountText.MethodLabel(session.Method)@(session.MultiFactor ? " + one-time code" : "")</dd></div>
                <div><dt>Email</dt><dd>@(session.EmailVerified ? "Verified" : "Not verified yet")</dd></div>
                <div><dt>18+ confirmation</dt><dd data-adult-attested="@(session.AdultAttested ? "true" : "false")">@(session.AdultAttested ? "Confirmed when you joined" : "Not recorded")</dd></div>
                <div><dt>Member area</dt><dd data-member-area="@(session.MemberArea ? "true" : "false")">@(session.MemberArea ? "Allowed" : "Not allowed")</dd></div>
            </dl>
            <p class="field-help">Confirming you're 18+ isn't age verification. ID checks come later.</p>
        }
    </section>
    @if (locked)
    {
        <section class="card account-section" aria-label="Account locked" data-account-locked="true">
            <h2>This account is locked.</h2>
            <p>Swoovr is for adults only. If the age you entered was a mistake, contact Swoovr support to have it reviewed.</p>
        </section>
    }
    else if (me is not null && me.AccountState == "pendingDeletion")
    {
        @* D170: a pending deletion closes the rest of the app; the deletion screen offers cancel and delete now. *@
        <section class="card account-section" aria-label="Account being deleted" data-pending-deletion="true">
            <h2>Your account is being deleted</h2>
            <p>Open deletion details to check the status and whether recovery is still available.</p>
            <p><a class="button" href="/account/deletion">See deletion details</a></p>
        </section>
    }
    else if (me is not null && me.AccountState != "active")
    {
        @* D160: restricted, suspended or terminated: nothing else in the app until it's lifted; notices and appeals stay open. *@
        <section class="card account-section" aria-label="Account restricted" data-restricted-screen="@me.AccountState">
            <h2>@(me.AccountState switch { "suspended" => "Your account is suspended", "terminated" => "Your account has been closed", _ => "Your account is restricted" })</h2>
            <p>You can't use Swoovr until this is lifted. Read the notice to see why; you can appeal within 30 days.</p>
            <p><a class="button" href="/me/notices">Read the notice</a></p>
        </section>
    }
    else if (me is not null)
    {
        <DobCorrectionPrompt Account="me" Changed="Corrected" />
        @* D148: the mobile number step (first when the gate is on). *@
        <PhonePanel />
        @if (me.AgeStatus == "needsVerification")
        {
            @* D127: the rest of the app answers age-verification-required until the check passes or support resolves it. *@
            <section class="card account-section" aria-label="Age check needed" data-age-check-required="true">
                <h2>Please verify your age</h2>
                <p>We need to confirm you're 18 or over before you can keep using Swoovr.</p>
                <p><a class="button" href="/me/verification">Verify my ID</a></p>
            </section>
        }
        <section class="card account-section" aria-labelledby="badges-heading">
            <h2 id="badges-heading">Badges</h2>
            @if (me.Badges.Count == 0)
            {
                <p class="field-help" data-badges="none">No badges yet. Each badge shows one check, such as a photo or ID check, once it's done.</p>
            }
            else
            {
                <ul class="badge-list" data-badges="@string.Join(" ", me.Badges.Select(b => b.Badge))">
                    @foreach (var badge in me.Badges)
                    {
                        <li><Badge Kind="@AccountText.BadgeKind(badge.Badge)" Size="20" /> @AccountText.BadgeLabel(badge.Badge)@(badge.CheckedAt is { } at ? $" · checked {at:d MMM yyyy}" : "")</li>
                    }
                </ul>
            }
        </section>

        <section class="card account-section" aria-labelledby="age-heading">
            <h2 id="age-heading">Your age</h2>
            @* D139: a date of birth is required and never shown; your age shows unless you hide it (Me → Who I'd like to meet). *@
            <p class="field-help">We need your date of birth to show you in discovery. It's never shown; your age is, unless you hide it. Entering it isn't age verification.</p>
            @if (me.DobCheck != "none")
            {
                <p class="field-help" data-dob-locked="@me.DobCheck">@(me.DobCheck == "correctionNeeded" ? "Set your date of birth in the prompt above to finish ID verification." : "Swoovr is checking your date of birth, so it can't be changed for now.")</p>
            }
            else
            {
            <form class="stack" @onsubmit="SaveAgeAsync" data-age-form>
                <div class="field"><label for="dob">Date of birth</label><input id="dob" type="date" required @bind="dateOfBirth" max="@Today" /></div>
                @if (me.DateOfBirthVerified) { <p class="field-help" data-dob-verified="true">Verified with your ID. Contact Swoovr support to change it.</p> }
                <button type="submit" class="button" disabled="@(busy || dateOfBirth is null)">Save</button>
                <p role="status" aria-live="polite" class="field-help" data-age-status="@AgeStatus">@ageMessage</p>
            </form>
            }
        </section>

        <section class="card account-section" aria-labelledby="coupon-heading">
            <h2 id="coupon-heading">Coupon code</h2>
            <p class="field-help">Founding members: if you've returned to Swoovr, enter the founder code we emailed you to restore your founding status.</p>
            <form class="stack" @onsubmit="RedeemAsync" data-coupon-form>
                <div class="field"><label for="coupon">Code</label><input id="coupon" type="text" autocomplete="off" spellcheck="false" @bind="coupon" @bind:event="oninput" placeholder="FOUNDER-…" /></div>
                <button type="submit" class="button button-secondary" disabled="@(busy || string.IsNullOrWhiteSpace(coupon))">Apply code</button>
                <p role="status" aria-live="polite" class="field-help" data-coupon-result="@couponResult">@couponMessage</p>
            </form>
        </section>
    }
}
@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    private bool loaded, busy, locked;
    private SessionSummary? session;
    private MemberAccount? me;
    private DateOnly? dateOfBirth;
    private string? ageMessage, coupon, couponMessage, couponResult;
    private bool BetaBlocked => AccountText.BetaBlocked(session);
    private string AgeStatus => me?.AgeStatus ?? "";
    private static string Today => DateTime.UtcNow.ToString("yyyy-MM-dd");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            session = (await Members.SessionAsync()).Value;
            if (session is { MemberArea: true }) Show(await Members.MeAsync());
            else if (session is not null && (await Members.MeAsync()).Code == ProblemCodes.AccountLocked) locked = true;
        }
        catch (HttpRequestException) { session = null; }
        loaded = true;
    }

    private void Show(ApiResult<MemberAccount> result)
    {
        if (result.Code == ProblemCodes.AccountLocked) { (locked, me) = (true, null); return; }
        if (result.Value is not { } account) return;
        me = account;
        dateOfBirth = account.DateOfBirth;
    }

    private async Task SaveAgeAsync()
    {
        busy = true;
        var result = await Members.SaveAgeAsync(new AgeUpdate(dateOfBirth, null));
        busy = false;
        if (result.Code is ProblemCodes.InvalidAge or ProblemCodes.DateOfBirthRequired) { ageMessage = AccountText.InvalidAge; return; }
        if (result.Code == ProblemCodes.DateOfBirthLocked) { ageMessage = "Your age was confirmed by ID verification. Contact Swoovr support to change it."; return; }
        Show(result);
        ageMessage = locked ? null : AccountText.AgeSaved(me);
    }

    private void Corrected(MemberAccount updated) => (me, dateOfBirth, ageMessage) = (updated, updated.DateOfBirth,
        updated.DateOfBirthVerified ? "Thanks. Your date of birth now matches your ID." : "Thanks. It still differs from your ID, so Swoovr's team will check it.");

    private async Task RedeemAsync()
    {
        busy = true;
        var result = await Members.RedeemAsync(coupon ?? "");
        busy = false;
        (couponResult, couponMessage) = AccountText.Coupon(result);
        if (result.Value is not null) { Show(result); coupon = null; }
    }
}
