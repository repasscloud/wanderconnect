@* issue 180: a short one-time message; the full advice lives at /safety/advice and under Safety & Support. Dismissal is
   saved on the account (the existing acknowledgement API), so it doesn't come back on other devices either. *@
@inject MemberClient Members
@if(loaded && !acknowledged)
{
    <aside class="settings-banner" role="note" aria-labelledby="connect-title" data-safety-advice>
        <Icon Name="shield" Size="22" />
        <div class="settings-banner-text">
            <p id="connect-title" class="settings-banner-title">Connect with confidence</p>
            <p>Stay in control of who you connect with. You can block, report or disconnect from another member at any time.</p>
            <a href="/safety/advice">Read safety advice</a>
        </div>
        <button type="button" class="button button-secondary button-small" disabled="@busy" @onclick="DismissAsync" data-advice-dismiss>Got it</button>
    </aside>
    @if(error is not null){<p role="status" class="field-help">@error</p>}
}
@code {
    private bool loaded,acknowledged,busy;private string? error;
    protected override async Task OnInitializedAsync()
    {
        try { var r=await Members.SafetyAdviceAsync();if(r.Value is{}v){acknowledged=v.Acknowledged;loaded=true;} }
        catch(Exception e) when(e is HttpRequestException or TaskCanceledException) { }
    }
    private async Task DismissAsync()
    {
        busy=true;
        try { var r=await Members.AcknowledgeSafetyAdviceAsync();if(r.Value?.Acknowledged==true)acknowledged=true;else error="We couldn't save that. Please try again."; }
        catch(Exception e) when(e is HttpRequestException or TaskCanceledException) {error="We couldn't save that. Please try again.";}
        finally{busy=false;}
    }
}
