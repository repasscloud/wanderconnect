@* ID verification (D126–D129, Interactive WebAssembly). Optional and free; one self-service attempt. The API creates the
   Didit session and returns its hosted link, which opens in a new browser tab: the check happens on Didit, not here.
   Returning to /me/verification/return re-reads the result from Didit through the API (D152); the status Didit puts in
   the return address is never trusted. Didit's test mode is always labelled (D147): it is not a live check. *@
@inject MemberClient Members
<div class="page-heading" data-verification="@(loaded ? (view is null ? "refused" : "ready") : "loading")">
    <p class="breadcrumb"><a href="/account">Me</a> / ID verification</p>
    <h1>ID verification</h1>
    @if (!loaded) { <p role="status">Loading…</p> }
    else if (view is null) { <p role="status" data-verification-refused="@refused">@(refused == ProblemCodes.BetaNotEnrolled ? "ID verification opens once your email is on the private beta list." : "We couldn't load your ID verification.")</p> }
</div>
@if (view is not null)
{
    @if (view.TestMode)
    {
        <p class="notice" role="note" data-verification-mode="test"><strong>Test mode.</strong> ID checks run in Didit's test environment. They aren't live verification yet.</p>
    }
    @if (view.AgeCheckRequired)
    {
        <section class="card account-section" data-age-check-required="true">
            <h2>Please verify your age</h2>
            <p>We need to confirm you're 18 or over before you can keep using Swoovr. Verify your ID below, or contact Swoovr support.</p>
        </section>
    }
    <section class="card account-section" aria-labelledby="id-heading">
        <h2 id="id-heading">Your ID check</h2>
        <p class="field-help">Optional and free. Didit checks a government photo ID and a live selfie. Swoovr keeps only the result, never your document or photos. The ID Verified badge says your ID was checked; it doesn't say your profile photos show you.</p>
        <p data-id-status="@view.IdStatus" data-attempt-state="@(view.AttemptState ?? "none")">@StatusText</p>
        @if (view.Url is not null)
        {
            <p><a class="button" href="@view.Url" target="_blank" rel="noopener noreferrer" data-verification-link>Continue on Didit</a></p>
            <p class="field-help">When you're done, come back here and choose Check result.</p>
            <button type="button" class="button button-secondary" disabled="@busy" @onclick="RefreshAsync" data-verification-refresh>Check result</button>
        }
        else if (view.CanStart)
        {
            <button type="button" class="button" disabled="@(busy || !view.Available)" @onclick="StartAsync" data-verification-start>Verify my ID</button>
            @if (!view.Available) { <p class="field-help" data-verification-unavailable>ID verification isn't available right now.</p> }
        }
        else if (view.Refusal == "attemptUsed")
        {
            <p class="field-help" data-verification-used>You've used your ID check. Contact Swoovr support if you'd like another.</p>
        }
        <p role="status" aria-live="polite" class="field-help" data-verification-message="@messageCode">@message</p>
    </section>
}
@code {
    private bool loaded, busy;
    private IdVerificationView? view;
    private string? refused, message, messageCode;

    private string StatusText => MemberText.VerificationState(view!);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        loaded = true;
    }

    private async Task LoadAsync()
    {
        var result = await Members.VerificationAsync();
        (view, refused) = (result.Value, result.Code ?? (result.Ok ? null : "error"));
    }

    private async Task StartAsync()
    {
        busy = true;
        var result = await Members.StartVerificationAsync("web");
        busy = false;
        if (result.Value is { } started) { (view, messageCode, message) = (started, "started", "Your check is ready. It opens on Didit in a new tab."); return; }
        messageCode = result.Code;
        message = MemberText.VerificationProblem(result.Code);
        await LoadAsync();
    }

    private async Task RefreshAsync()
    {
        busy = true;
        await LoadAsync();
        busy = false;
        (messageCode, message) = ("refreshed", "Updated.");
    }
}
