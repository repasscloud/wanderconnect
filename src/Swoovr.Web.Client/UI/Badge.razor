@* Verification and status badges (UI-STYLE.md Badges): 16px, right after a name, same colours in every scheme
   (--badge-* tokens generated from docs/design/brand-colours.json). Each badge describes one check; on fictional
   preview people the label says the check is simulated, never live. The shapes come from BadgeArtwork in
   Swoovr.Client, which the app draws too (D141). *@
<svg class="badge badge-@Kind" width="@Size" height="@Size" viewBox="@BadgeArtwork.ViewBox(Shape)" role="img" aria-label="@AccessibleLabel" data-badge="@Kind"><title>@AccessibleLabel</title>@if (IsBird)
{
    @foreach (var stroke in Shape.Strokes) { <path class="badge-@stroke.Part" fill-rule="evenodd" transform="@BadgeArtwork.SvgTransform(stroke)" d="@stroke.Data" /> }
}
else
{
    <g fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">@foreach (var stroke in Shape.Strokes) { <path class="badge-@stroke.Part" d="@stroke.Data" /> }</g>
}</svg>
@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter] public int Size { get; set; } = 16;
    [Parameter] public bool Simulated { get; set; }

    private BadgeShape Shape => BadgeArtwork.Shape(Kind);
    private bool IsBird => Kind is "founding" or "staff" or "bot";
    private string AccessibleLabel => Simulated ? $"{BadgeArtwork.Label(Kind)} (simulated in this preview)" : BadgeArtwork.Label(Kind);
}
