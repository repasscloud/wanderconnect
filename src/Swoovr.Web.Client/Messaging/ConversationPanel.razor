@* One conversation (D143, Interactive WebAssembly): text and photos (#41), newest at the bottom, sent through /bff/ (so every send
   passes the API's checks) and received live through the web host's relay hub. Delete for both within five minutes (it
   then shows as deleted, Q59), hide a message or the whole conversation for yourself, report a message or the conversation.
   #41: photos go through the quarantine (the other person sees one only once approved; the sender sees its state);
   starters from shared intention chips while the chat is empty; ending politely without blocking (Q85).
   Issue 300 (D380): once the member reaches the other person's unanswered-message limit the composer is disabled with a
   neutral line, and opens again as soon as their reply arrives live (or the chat is reopened). *@
@inject MemberClient Members
@inject NavigationManager Navigation
@inject UnreadNotifications Unread
@inject IJSRuntime JS
@implements IAsyncDisposable
@* Issue 542 (26 November 2026 UAT review): a compact header (thumbnail, name and published age, the chat's mode, badges; it
   opens their profile in that mode) with Report always visible and the other conversation actions in one menu; the thread
   scrolls on its own between the sticky header and composer, opening at the first unread message or the newest; each
   message's actions sit in its own menu (the ⋯ button, right-click, or a long press), not on every bubble; and a + menu for
   attachments (today: a photo). Urgent safety actions stay one tap away: Report in the header, Block and Serious safety
   incident first in the menu. *@
<div class="chat-layout" @onkeydown="MenuKey" data-conversation="@(loaded ? (conversation is null ? "unavailable" : "ready") : "loading")" data-live="@(live ? "on" : "off")">
<div class="chat-head">
    @if (conversation is not null)
    {
        <a class="chat-icon-button chat-back" href="/chats" aria-label="Back to Chats" data-chat-back><Icon Name="back" Size="20" /></a>
        @if (conversation.Person.Id != Guid.Empty)
        {
            <a class="chat-who" href="@ProfileLink" data-chat-profile>
                @if (conversation.Person.Photo is { } photo) { <img class="cx-thumb" src="@PhotoText.Web(photo.Link)" alt="" loading="lazy" draggable="false" @oncontextmenu:preventDefault="true" @ondragstart:preventDefault="true" data-photo-guard data-head-photo /> }
                else { <span class="cx-thumb" aria-hidden="true">@Initial(conversation.Person.DisplayName)</span> }
                <span class="cx-who">
                    <h1 class="chat-name">@(conversation.Person.DisplayName ?? "Someone")@if (conversation.Person.Age is { } age) { <span class="cx-age" data-head-age>, @age</span> }</h1>
                    <span class="cx-meta">@if (conversation.ModeId is { } mode) { <span class="chip cx-mode" data-head-mode="@mode">@ModeLabel(mode)</span> }<BadgeRow Badges="conversation.Person.Badges" /></span>
                </span>
            </a>
        }
        else { <span class="chat-who"><span class="cx-thumb" aria-hidden="true">?</span><h1 class="chat-name">@conversation.Person.DisplayName</h1></span> }
        <div class="chat-head-actions">
            <button type="button" class="button button-secondary chat-head-button" @onclick="ReportConversation" data-report-conversation><Icon Name="flag" Size="16" />Report</button>
            <button type="button" class="chat-icon-button" aria-label="More actions for this chat" aria-expanded="@(chatMenu ? "true" : "false")" aria-controls="chat-menu" @onclick="() => { chatMenu = !chatMenu; menuFor = null; attachMenu = false; }" data-chat-menu><Icon Name="more" Size="20" /></button>
            @if (chatMenu)
            {
                <div class="chat-menu" id="chat-menu" data-chat-menu-open>
                    @if (conversation.Person.Id != Guid.Empty)
                    {
                        @if (confirmBlock) { <button type="button" class="chat-menu-item button-destructive" @onclick="BlockAsync" data-block-confirm><Icon Name="ban" Size="16" />Block @(conversation.Person.DisplayName ?? "them")</button> }
                        else { <button type="button" class="chat-menu-item" @onclick="() => confirmBlock = true" data-block-conversation><Icon Name="ban" Size="16" />Block</button> }
                    }
                    <a class="chat-menu-item" href="@($"/me/safety/report?type=conversation&id={Id}")" data-serious-link><Icon Name="shield" Size="16" />Serious safety incident</a>
                    <button type="button" class="chat-menu-item" @onclick="HideConversationAsync" data-hide-conversation><Icon Name="eye-off" Size="16" />Hide this chat</button>
                    @if (conversation.CanSend) { <button type="button" class="chat-menu-item" @onclick="OpenEnding" data-end-open><Icon Name="x" Size="16" />End conversation</button> }
                </div>
            }
        </div>
    }
    else if (loaded) { <h1>Chat not available</h1> }
</div>
@if (conversation is not null)
{
    <div class="chat-scroll" @ref="thread" tabindex="0" role="region" aria-label="Messages" data-chat-scroll>
    @if (conversation.Closed)
    {
        <section class="card stack" role="status" data-closed-conversation>
            <h2>@PhotoText.ClosedTitle</h2>
            <p>@PhotoText.ClosedBody</p>
            <p class="field-help">@PhotoText.ClosedSafety</p>
        </section>
    }
    @if (more) { <button type="button" class="link-button chat-older" @onclick="OlderAsync" data-older>Earlier messages</button> }
    <ul class="chat-thread" aria-live="polite" data-messages="@messages.Count">
        @foreach (var m in messages)
        {
            <li class="@(m.Kind == "system" ? "chat-system" : "bubble" + (m.Mine ? " mine" : "") + (m.Kind == "meetup" ? " meetup" : m.Kind == "location" && m.Location is not null ? " meetup location" : "") + (m.Deleted ? " deleted" : "") + (menuFor == m.Id ? " has-menu" : ""))" data-message-kind="@m.Kind" data-message="@m.Id" data-mine="@(m.Mine ? "true" : "false")" data-deleted="@(m.Deleted ? "true" : "false")"
                @oncontextmenu="() => OpenMessageMenu(m)" @oncontextmenu:preventDefault="@(m.Kind != "system")">
                <span class="visually-hidden">@(m.Kind == "system" ? "Swoovr" : m.Mine ? "You" : conversation.Person.DisplayName): </span>
                @if (m.Kind == "farewell") { <p class="field-help">Predefined farewell</p> }
                @if (m.Deleted) { <p>This message was deleted</p> }
                else if (m.Kind == "photo")
                {
                    @* Issue 467 (owner): right-click and drag are blocked on chat photos, including explicit media once revealed
                       (issue 431, which renders through this element); it only stops casual saving. *@
                    @if (m.Photo is { } adult && m.Explicit == true)
                    {
                        @* D423/D451 (issue 546): an adult photo opens blurred with Show, for both, even when opted in (182.6). A
                           photo that couldn't be delivered stays blurred for its sender, who can look at it in a dialog. *@
                        var shown = revealed.Contains(m.Id) && m.PhotoState != "not-accepted";
                        <span class="chat-explicit @(shown ? null : "is-blurred")" data-chat-explicit="@(shown ? "shown" : "hidden")">
                            <img class="chat-photo" src="@PhotoText.Web(adult.Link)" alt="@(shown ? $"Photo from {(m.Mine ? "you" : conversation.Person.DisplayName)}" : "Adult photo, hidden")" loading="lazy" draggable="false" @oncontextmenu:preventDefault="true" @ondragstart:preventDefault="true" data-photo-guard data-chat-photo="@adult.Id" />
                            @if (!shown)
                            {
                                <button type="button" class="chat-explicit-show" @onclick="() => Reveal(m)" data-explicit-show>
                                    <span class="chat-explicit-label">Adult content</span><span class="chat-explicit-action">@(m.PhotoState == "not-accepted" ? "View your photo" : "Show")</span>
                                </button>
                            }
                        </span>
                    }
                    else if (m.Photo is { } photo) { <img class="chat-photo" src="@PhotoText.Web(photo.Link)" alt="Photo from @(m.Mine ? "you" : conversation.Person.DisplayName)" loading="lazy" draggable="false" @oncontextmenu:preventDefault="true" @ondragstart:preventDefault="true" data-photo-guard data-chat-photo="@photo.Id" /> }
                    else if (m.Explicit == true && !m.Mine) { <p class="field-help" data-explicit-unavailable>This adult photo isn't available.</p> }
                    @if (m.Mine && m.PhotoState is { } state && state != "approved") { <p class="field-help" data-photo-state="@state">@PhotoText.ChatState(state)</p> }
                }
                else if (m.Kind == "meetup")
                {
                    @* Issue 545 (D430): the invitation's card; its note is part of the card. *@
                    @if (m.Meetup is { } plan)
                    {
                        <MeetupCard Meetup="plan" Busy="busy" Answer="a => AnswerMeetupAsync(plan, a)" Suggest="() => OpenPlan(plan)" Calendar="() => CalendarAsync(plan)" />
                    }
                    else { <p class="field-help" data-meetup-gone>This meet-up is no longer available.</p> }
                }
                else if (m.Kind == "location")
                {
                    @* Issue 544 (D455): a shared place; deleted for both or removed shows no place. *@
                    @if (m.Location is { } place) { <LocationCard Place="place" /> }
                    else { <p class="field-help" data-location-gone>@(m.Deleted ? "" : "This location is no longer available.")</p> }
                }
                else { <p>@m.Text</p> }
                @if (m.Kind != "system")
                {
                    <span class="bubble-foot"><time class="bubble-time" datetime="@m.SentAt.ToString("O")">@m.SentAt.ToLocalTime().ToString("HH:mm")</time>
                        <button type="button" class="bubble-more" aria-label="Options for this message" aria-expanded="@(menuFor == m.Id ? "true" : "false")" @onclick="() => ToggleMessageMenu(m)" data-message-menu="@m.Id"><Icon Name="more" Size="16" /></button></span>
                    @if (menuFor == m.Id)
                    {
                        <span class="bubble-menu" data-message-menu-open="@m.Id">
                            @if (m.CanDelete) { <button type="button" class="chat-menu-item button-destructive" @onclick="() => DeleteAsync(m)" data-delete="@m.Id">Delete for both</button> }
                            <button type="button" class="chat-menu-item" @onclick="() => HideAsync(m)" data-hide="@m.Id">Hide for me</button>
                            @if (!m.Mine && !m.Deleted) { <button type="button" class="chat-menu-item" @onclick="() => ReportMessage(m)" data-report-message="@m.Id">Report</button> }
                        </span>
                    }
                }
            </li>
        }
    </ul>
    @if (reporting is { } reported)
    {
        <div data-chat-report-message><ReportForm SubjectType="message" SubjectId="@reported.ToString()" Name="@(conversation.Person.DisplayName ?? "this person")" Submitted="() => reportSent=true" Blocked="Closed" /></div>
    }
    @if (conversation.CanSend && messages.Count == 0 && starters.Count > 0)
    {
        <div class="starters" data-starters="@starters.Count">
            <p class="field-help">Something to start with:</p>
            @foreach (var s in starters) { <button type="button" class="chip" @onclick="() => draft = s.Text" data-starter="@s.Chip">@s.Text</button> }
        </div>
    }
    @if (ending)
    {
        <form class="card stack" @onsubmit="EndAsync" data-end-form>
            <h2>End this conversation</h2>
            <p class="field-help">@PhotoText.EndHelp</p>
            <fieldset class="stack">
                <legend>Send a closing message?</legend>
                @foreach (var (closingId, label) in PhotoText.Closings)
                {
                    <label class="check"><input type="radio" name="closing" checked="@(closing == closingId)" @onchange="() => closing = closingId" data-closing="@closingId" /> @label</label>
                }
                <label class="check"><input type="radio" name="closing" checked="@(closing is null)" @onchange="() => closing = null" data-closing="none" /> No farewell message</label>
            </fieldset>
            <p class="chat-form-actions">
                <button type="submit" class="button" disabled="@busy" data-end-confirm>End conversation</button>
                <button type="button" class="button button-secondary" @onclick="() => ending = false">Keep chatting</button>
            </p>
        </form>
    }
    @if (reportingConversation)
    {
        <div data-chat-report-conversation><ReportForm SubjectType="conversation" SubjectId="@Id.ToString()" Name="@(conversation.Person.DisplayName ?? "this person")" Submitted="() => reportSent=true" Blocked="Closed" /></div>
    }
    </div>
    @if (conversation.CanSend)
    {
        var awaiting = conversation.AwaitingReply;
        <div class="chat-compose">
            @if (awaiting) { <p class="field-help" role="status" data-awaiting-reply>@MessageText.AwaitingReply</p> }
            @if (attachMenu)
            {
                <div class="chat-menu attach-menu" id="attach-menu" data-attach-menu-open>
                    <label class="chat-menu-item" for="chat-photo" aria-disabled="@(awaiting ? "true" : "false")" data-attach-photo><Icon Name="image" Size="16" />Send a photo</label>
                    @* Issue 545 (D430): a private 1-on-1 meet-up. *@
                    <button type="button" class="chat-menu-item" disabled="@awaiting" @onclick="() => OpenPlan(null)" data-attach-meetup><Icon Name="calendar" Size="16" />Plan a meet-up</button>
                    @* Issue 544 (D455): one chosen place, never live. *@
                    <button type="button" class="chat-menu-item" disabled="@awaiting" @onclick="OpenLocation" data-attach-location><Icon Name="pin" Size="16" />Share a location</button>
                    <p class="field-help">@PhotoText.ChatRules</p>
                </div>
            }
            <InputFile id="chat-photo" class="visually-hidden" aria-label="Send a photo" OnChange="SendPhotoAsync" accept="image/jpeg,image/png,image/webp" disabled="@(busy || awaiting)" data-chat-photo-input />
            <form class="composer" @onsubmit="SendAsync" data-composer data-composer-state="@(awaiting ? "awaiting-reply" : "open")">
                <button type="button" class="chat-icon-button" aria-label="Attach" aria-expanded="@(attachMenu ? "true" : "false")" aria-controls="attach-menu" disabled="@awaiting" @onclick="() => { attachMenu = !attachMenu; chatMenu = false; menuFor = null; }" data-attach><Icon Name="plus" Size="20" /></button>
                <label class="visually-hidden" for="message">Message</label>
                <input id="message" class="composer-input" maxlength="2000" autocomplete="off" @bind="draft" @bind:event="oninput" placeholder="Message" disabled="@awaiting" data-message-input />
                <button class="button composer-send" type="submit" disabled="@(busy || awaiting || string.IsNullOrWhiteSpace(draft))" data-send>Send</button>
            </form>
        </div>
    }
    else if (!conversation.Closed) { <p class="field-help chat-compose" data-cannot-send>You can't send messages here right now.</p> }
    @* D423 (issue 546): the sender's own photo that couldn't be delivered, revealed only to them. *@
    <MemberDialog Kind="own-photo" Title="Your photo" Open="ownPhoto is not null" Closed="() => ownPhoto = null">
        @if (ownPhoto?.Photo is { } own)
        {
            <img class="chat-own-photo" src="@PhotoText.Web(own.Link)" alt="Your photo" draggable="false" @oncontextmenu:preventDefault="true" @ondragstart:preventDefault="true" data-photo-guard data-own-photo="@own.Id" />
            <p class="field-help">@PhotoText.ChatState("not-accepted"). It wasn't delivered, and they weren't told.</p>
        }
    </MemberDialog>
    <MemberDialog Kind="location" Title="@($"Share a location with {conversation.Person.DisplayName}")" Open="locating" Closed="() => locating = false">
        @if (locating)
        {
            <LocationForm Busy="busy" Message="@locationMessage" Submit="ShareLocationAsync" Cancel="() => locating = false" />
        }
    </MemberDialog>
    <MemberDialog Kind="meetup" Title="@(suggesting is null ? $"Plan a meet-up with {conversation.Person.DisplayName}" : "Suggest changes")" Open="planning" Closed="() => planning = false">
        @if (planning)
        {
            <MeetupForm Mode="@conversation.ModeId" Initial="suggesting" Busy="busy" Message="@planMessage" Submit="PlanAsync" Cancel="() => planning = false" />
        }
    </MemberDialog>
}
</div>
@* Outside the conversation block, so "This chat is closed." still shows once a block or disconnect closes it (#82). *@
<p role="status" aria-live="polite" class="field-help" data-chat-status="@status">@message</p>
@if(reportSent && conversation is null){<p role="status">@ReportFollowUpText.Confirmation</p><ReportSupport />}
@code {
    [Parameter, EditorRequired] public Guid Id { get; set; }
    private bool loaded, busy, more, live, reportingConversation, confirmBlock, ending, reportSent;
    private string? draft, status, message, closing;
    private List<ConversationStarter> starters = [];
    private Guid? reporting;
    private DateTimeOffset? before;
    private ConversationView? conversation;
    private List<MessageView> messages = [];
    private readonly HashSet<Guid> removedMessages=[];
    private MessageView Project(MessageView value)=>MessageText.ApplyKnownRemoval(value,removedMessages);
    private MessagesHubClient? hub;
    // Issue 542: the thread's own scroll area, the open menus, and where to start reading.
    private ElementReference thread;
    // Issue 545: the meet-up form (a new plan, or suggested changes to one).
    private bool planning;
    private MeetupView? suggesting;
    private string? planMessage;
    private bool chatMenu, attachMenu, started, followNew;
    private Guid? menuFor;
    // Issue 546: explicit photos this member chose to show (for this visit only), and their own undelivered one in the dialog.
    private readonly HashSet<Guid> revealed = [];
    private MessageView? ownPhoto;
    private void Reveal(MessageView m) { if (m.PhotoState == "not-accepted") ownPhoto = m; else revealed.Add(m.Id); }
    private int? keepFrom;
    private string? firstUnread;
    // PR 579 review: Report and End conversation add their form below the thread; scroll it into view and focus it.
    private string? reveal;
    private List<ConnectionModeView> modes = [];
    private bool reconciling,disposed;
    private readonly List<MessageView> refreshArrivals=[];
    private readonly SemaphoreSlim refreshGate=new(1,1);

    protected override async Task OnInitializedAsync()
    {
        conversation = (await Members.ConversationAsync(Id)).Value;
        if (conversation is not null)
        {
            if (await Members.ModesAsync() is { Ok: true } catalogue) modes = catalogue.Value!.ToList();
            var page = (await Members.MessagesAsync(Id)).Value;
            (messages, more, before) = (page?.Items.Reverse().Select(Project).ToList() ?? [], page?.More ?? false, page?.Before);
            // Issue 542: open at the first message that was unread, else the newest. PR 579 review: the API names it (a
            // photo that passed late can sit above messages already read); when it's on an earlier page, load earlier
            // pages until it's in (up to MaxUnreadPages more); past that, open at the oldest loaded message.
            var unreadId = page?.FirstUnread;
            for (var pages = 0; unreadId is { } wanted && messages.All(m => m.Id != wanted) && more && pages < MaxUnreadPages; pages++)
            {
                var older = (await Members.MessagesAsync(Id, before)).Value;
                if (older is null) break;
                messages.InsertRange(0, older.Items.Reverse().Select(Project));
                (more, before) = (older.More, older.Before);
            }
            firstUnread = unreadId is not { } found || messages.Count == 0 ? null
                : messages.Any(m => m.Id == found) ? found.ToString() : messages[0].Id.ToString();
            hub = new MessagesHubClient(new Uri(Navigation.BaseUri + "bff/hubs/messages"));
            // A photo's state changes arrive as the same message again (#41): replace it in place.
            // PR 583 review: a meet-up card re-sent for a state change isn't a new reply; only a card new to this chat ends the wait.
            hub.Message += m => { if (m.ConversationId == Id) _ = InvokeAsync(async () => { followNew = await AtEndAsync(); var fresh = m.Kind != "meetup" || !messages.Any(x => x.Id == m.Id); Upsert(m); if (fresh) Replied(m); if (!m.Mine) _ = ReadLiveAsync(); StateHasChanged(); }); };
            hub.Deleted += d => { if (d.ConversationId == Id) { MarkDeleted(d.MessageId); _ = InvokeAsync(StateHasChanged); } };
            hub.Reconnected += () => _ = InvokeAsync(Closed);
            hub.Closed += c => { if (c.ConversationId == Id) _ = InvokeAsync(Closed); };
            // Issue 300: they loosened their limit; read whether this member may write again.
            hub.Released += r => { if (r.ConversationId == Id) _ = InvokeAsync(async () => { await RecheckAwaitingAsync(); StateHasChanged(); }); };
            try { await hub.StartAsync(); live = true; }
            catch (Exception error) when (error is HttpRequestException or InvalidOperationException) { live = false; }
            // Anything sent while the live connection was opening: read the latest page again and merge.
            foreach (var m in (await Members.MessagesAsync(Id)).Value?.Items.Reverse() ?? [])
                Upsert(m);
            // Issue 300: a reply (or a looser limit) between the first read and the live connection doesn't arrive live.
            await RecheckAwaitingAsync();
            if (messages.Count == 0 && conversation.CanSend) starters = (await Members.StartersAsync(Id)).Value ?? [];
            // Issue 541: opening the chat read it (the API recorded that); the Chats badge drops now, not at the next poll.
            _ = Unread.ChangedByMemberAsync();
        }
        loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (conversation is null) return;
        try
        {
            if (!started && loaded) { started = true; await JS.InvokeVoidAsync("SwoovrChat.start", thread, firstUnread); }
            else if (keepFrom is { } height) { keepFrom = null; await JS.InvokeVoidAsync("SwoovrChat.keep", thread, height); }
            else if (followNew) { followNew = false; await JS.InvokeVoidAsync("SwoovrChat.toEnd", thread); }
            if (reveal is { } selector) { reveal = null; await JS.InvokeVoidAsync("SwoovrChat.reveal", thread, selector); }
        }
        catch (Exception error) when (error is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private async Task<bool> AtEndAsync()
    {
        try { return await JS.InvokeAsync<bool>("SwoovrChat.atEnd", thread); }
        catch (Exception error) when (error is JSException or InvalidOperationException or TaskCanceledException) { return true; }
    }

    private const int MaxUnreadPages = 10;
    private void ReportConversation() { (reportingConversation, chatMenu, reveal) = (true, false, "[data-chat-report-conversation]"); }
    private void OpenEnding() { (ending, chatMenu, reveal) = (true, false, "[data-end-form]"); }
    private void ReportMessage(MessageView m) { (reporting, menuFor, reveal) = (m.Id, null, "[data-chat-report-message]"); }

    private string ProfileLink => conversation is { ModeId: { } mode } ? $"/people/{conversation.Person.Id}?mode={mode}" : $"/people/{conversation?.Person.Id}";
    private string ModeLabel(string id) => modes.FirstOrDefault(m => m.Id == id)?.Label ?? id;
    private static string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private bool locating;
    private string? locationMessage;
    private void OpenLocation() => (locating, locationMessage, attachMenu, chatMenu, menuFor) = (true, null, false, false, null);

    private async Task ShareLocationAsync(ShareLocation request)
    {
        busy = true;
        var result = await Members.ShareLocationAsync(Id, request);
        busy = false;
        if (result.Value is { } sent) { Upsert(sent); followNew = true; locating = false; return; }
        if (result.Code == ProblemCodes.UnansweredLimit) { locating = false; AwaitReply(); await RecheckAwaitingAsync(); return; }
        locationMessage = result.Code switch
        {
            ProblemCodes.InvalidLocation => "Check the place and keep the label to one short line.",
            ProblemCodes.TooManyRequests => "That's a lot of messages. Slow down a little.",
            ProblemCodes.Restricted => "You can't send messages right now.",
            _ => "That couldn't be sent.",
        };
    }

    private void OpenPlan(MeetupView? plan) => (planning, suggesting, planMessage, attachMenu, chatMenu, menuFor) = (true, plan, null, false, false, null);

    private async Task PlanAsync(MeetupRequest request)
    {
        busy = true;
        var result = suggesting is { } plan ? await Members.SuggestMeetupAsync(plan.Id, request) : await Members.ProposeMeetupAsync(Id, request);
        busy = false;
        if (result.Value is { } sent) { Upsert(sent); followNew = true; planning = false; suggesting = null; return; }
        if (result.Code == ProblemCodes.UnansweredLimit) { planning = false; AwaitReply(); await RecheckAwaitingAsync(); return; }
        planMessage = result.Code switch
        {
            ProblemCodes.MeetupPending => "There's already an invitation waiting in this chat.",
            ProblemCodes.MeetupNotOpen => "This invitation can't be changed any more.",
            ProblemCodes.InvalidMeetup => "Check what, where and when (from 15 minutes to 90 days from now).",
            ProblemCodes.TooManyRequests => "That's a lot of messages. Slow down a little.",
            _ => "That couldn't be sent.",
        };
    }

    private async Task AnswerMeetupAsync(MeetupView plan, string action)
    {
        busy = true;
        var result = await Members.AnswerMeetupAsync(plan.Id, action);
        busy = false;
        if (result.Value is { } updated) Upsert(updated);
        else (status, message) = ("failed", "This invitation can't be changed any more.");
    }

    // Issue 545 (D430 After acceptance A): the calendar file is made here and saved by the browser; nothing is sent.
    private async Task CalendarAsync(MeetupView plan)
    {
        var file = MeetupText.Calendar(plan, conversation?.Person.DisplayName, DateTimeOffset.UtcNow);
        try { await JS.InvokeAsync<bool>("swoovrDownload.save", "swoovr-meetup.ics", "text/calendar", Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(file))); }
        catch (Exception error) when (error is JSException or InvalidOperationException) { (status, message) = ("failed", "The calendar file couldn't be saved."); }
    }

    // Issue 542: one message's actions at a time; right-click or a long press opens them too.
    private void ToggleMessageMenu(MessageView m) { menuFor = menuFor == m.Id ? null : m.Id; chatMenu = attachMenu = false; }
    private void OpenMessageMenu(MessageView m) { if (m.Kind == "system") return; menuFor = m.Id; chatMenu = attachMenu = false; }
    private void MenuKey(KeyboardEventArgs e) { if (e.Key == "Escape") { menuFor = null; chatMenu = attachMenu = false; } }

    // Issue 541 DEFAULT: a message that arrives while this chat is open counts as read (the member's own count only).
    private async Task ReadLiveAsync()
    {
        try { await Members.ReadConversationAsync(Id); await Unread.ChangedByMemberAsync(); }
        catch (Exception error) when (error is HttpRequestException or TaskCanceledException) { }
    }

    private async Task OlderAsync()
    {
        var page = (await Members.MessagesAsync(Id, before)).Value;
        if (page is null) return;
        // Issue 542: stay on the message the member was reading while the older ones are added above it.
        try { keepFrom = await JS.InvokeAsync<int>("SwoovrChat.height", thread); } catch (JSException) { }
        messages.InsertRange(0, page.Items.Reverse().Select(Project));
        (more, before) = (page.More, page.Before);
    }

    private async Task SendAsync()
    {
        busy = true;
        var result = await Members.SendMessageAsync(Id, draft ?? "");
        busy = false;
        if (result.Value is { } sent)
        {
            if (messages.All(x => x.Id != sent.Id)) messages.Add(sent);
            followNew = true;
            (draft, status, message) = (null, "sent", null);
            return;
        }
        // Issue 300: a reply may have arrived live while this refusal was on its way; the API's answer decides.
        if (result.Code == ProblemCodes.UnansweredLimit) { AwaitReply(); await RecheckAwaitingAsync(); }
        (status, message) = (result.Code ?? "failed", result.Code switch
        {
            ProblemCodes.UnansweredLimit => null, // the line above the composer says it
            ProblemCodes.ArrivalRequired => "You can reply, or write first once you've confirmed you've arrived.",
            ProblemCodes.BotCannotInitiate => "This account can't start conversations.",
            ProblemCodes.InvalidMessage => "Write 1 to 2,000 characters.",
            ProblemCodes.TooManyRequests => "That's a lot of messages. Slow down a little.",
            _ => "That message couldn't be sent.",
        });
    }

    // Issue 300: their reply, arriving live, ends the wait without reopening the chat.
    private void Replied(MessageView m)
    {
        if (conversation is { AwaitingReply: true } && MessageText.IsReply(m)) conversation = conversation with { AwaitingReply = false };
    }

    // Issue 300: the API's answer is authoritative; only asked while the composer is locked.
    private async Task RecheckAwaitingAsync()
    {
        if (conversation is not { AwaitingReply: true }) return;
        if ((await Members.ConversationAsync(Id)).Value is { } fresh && conversation is not null) conversation = conversation with { AwaitingReply = fresh.AwaitingReply };
    }

    private void AwaitReply()
    {
        if (conversation is not null) conversation = conversation with { AwaitingReply = true };
    }

    private void Upsert(MessageView m)
    {
        if(reconciling)refreshArrivals.Add(m);
        m=Project(m);
        var index = messages.FindIndex(x => x.Id == m.Id);
        if (index >= 0) messages[index] = m; else messages.Add(m);
    }

    private async Task SendPhotoAsync(InputFileChangeEventArgs e)
    {
        busy = true;
        try
        {
            if (e.File.Size > 10 * 1024 * 1024) { (status, message) = ("photo-too-big", PhotoText.Refusal("photo-too-big")); return; }
            using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var result = await Members.SendChatPhotoAsync(Id, buffer.ToArray(), e.File.Name, e.File.ContentType);
            // A live screening/deletion event may precede the older upload response. Preserve that event.
            if (result.Value is { } sent) { if (messages.All(m => m.Id != sent.Id)) messages.Add(sent); followNew = true; attachMenu = false; (status, message) = ("photo-sent", null); }
            else if (result.Code == ProblemCodes.UnansweredLimit) { AwaitReply(); await RecheckAwaitingAsync(); (status, message) = (result.Code, null); }
            else (status, message) = (result.Code ?? "failed", PhotoText.Refusal(result.Code));
        }
        finally { busy = false; }
    }

    private async Task EndAsync()
    {
        busy = true;
        var result = await Members.EndConversationAsync(Id, closing);
        busy = false;
        if (!result.Ok) { (status, message) = ("failed", "That didn't work. Try again."); return; }
        ending = false;
        await Closed();
        (status, message) = ("ended", "You ended this conversation.");
    }

    private async Task DeleteAsync(MessageView m)
    {
        var code = await Members.DeleteMessageAsync(m.Id);
        if (code == 204) MarkDeleted(m.Id);
        menuFor = null;
        (status, message) = code == 204 ? ("deleted", "Deleted for both of you.") : ("failed", "Messages can be deleted for both of you within five minutes.");
    }

    // Q59, D167: a message deleted for both stays in the thread as deleted.
    private void MarkDeleted(Guid id)
    {
        var index = messages.FindIndex(x => x.Id == id);
        if (index >= 0) messages[index] = messages[index] with { Deleted = true, Text = "", CanDelete = false };
    }

    private async Task HideAsync(MessageView m)
    {
        if (await Members.HideMessageAsync(m.Id) == 204) messages.RemoveAll(x => x.Id == m.Id);
        menuFor = null;
    }

    // The block closes the conversation; the API pushes "closed" (#82), and this window closes it at once either way.
    private async Task BlockAsync()
    {
        if (conversation is null) return;
        var code = await Members.BlockAsync(conversation.Person.Id);
        if (code == 204) await Closed();
        else (status, message) = ("failed", "That didn't work. Try again.");
    }

    private async Task HideConversationAsync()
    {
        if (await Members.HideConversationAsync(Id) == 204) Navigation.NavigateTo("/chats");
    }

    private async Task Closed()
    {
        await refreshGate.WaitAsync();
        try
        {
            if(disposed)return;
            reconciling=true;refreshArrivals.Clear();messages.Clear();live=false;StateHasChanged();
            conversation=(await Members.ConversationAsync(Id)).Value;
            if(conversation is not null)
            {
                var page=(await Members.MessagesAsync(Id)).Value;
                var arrivals=refreshArrivals.ToArray();reconciling=false;
                (messages,more,before)=(page?.Items.Reverse().Select(Project).ToList()??[],page?.More??false,page?.Before);
                foreach(var item in arrivals)Upsert(item);
                live=hub?.Connected==true;
            }
            else messages.Clear();
            (status,message)=conversation is null||conversation.Closed?("closed",conversation is null?"This chat is closed.":PhotoText.ClosedBody):(null,null);
        }
        catch(Exception error)when(error is HttpRequestException or TaskCanceledException)
        {messages.Clear();(status,message)=("refresh-unconfirmed","Chat history could not refresh. Reopen this chat to try again.");}
        finally{reconciling=false;refreshGate.Release();if(!disposed)StateHasChanged();}
    }

    public async ValueTask DisposeAsync()
    {
        disposed=true;
        if (hub is not null) await hub.DisposeAsync();
    }
}
