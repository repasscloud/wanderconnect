@* One conversation (D143, Interactive WebAssembly): text and photos (#41), newest at the bottom, sent through /bff/ (so every send
   passes the API's checks) and received live through the web host's relay hub. Delete for both within five minutes (it
   then shows as deleted, Q59), hide a message or the whole conversation for yourself, report a message or the conversation.
   #41: photos go through the quarantine (the other person sees one only once approved; the sender sees its state);
   starters from shared intention chips while the chat is empty; ending politely without blocking (Q85). *@
@inject MemberClient Members
@inject NavigationManager Navigation
@implements IAsyncDisposable
<div class="chat-head" data-conversation="@(loaded ? (conversation is null ? "unavailable" : "ready") : "loading")" data-live="@(live ? "on" : "off")">
    @if (conversation is not null)
    {
        <div>
            <p class="chat-name"><a href="@($"/people/{conversation.Person.Id}")">@(conversation.Person.DisplayName ?? "Someone")</a><BadgeRow Badges="conversation.Person.Badges" /></p>
            <p class="chat-sub"><a class="link" href="/chats">Chats</a></p>
        </div>
    }
    else if (loaded) { <h1>Chat not available</h1> }
</div>
@if (conversation is not null)
{
    @if (conversation.Closed)
    {
        <section class="card stack" role="status" data-closed-conversation>
            <h1>@PhotoText.ClosedTitle</h1>
            <p>@PhotoText.ClosedBody</p>
            <p class="field-help">@PhotoText.ClosedSafety</p>
        </section>
    }
    @if (more) { <button type="button" class="link-button" @onclick="OlderAsync" data-older>Earlier messages</button> }
    <ul class="chat-thread" aria-live="polite" data-messages="@messages.Count">
        @foreach (var m in messages)
        {
            <li class="@(m.Kind == "system" ? "chat-system" : "bubble" + (m.Mine ? " mine" : "") + (m.Deleted ? " deleted" : ""))" data-message-kind="@m.Kind" data-message="@m.Id" data-mine="@(m.Mine ? "true" : "false")" data-deleted="@(m.Deleted ? "true" : "false")">
                <span class="visually-hidden">@(m.Kind == "system" ? "Swoovr" : m.Mine ? "You" : conversation.Person.DisplayName): </span>
                @if (m.Kind == "farewell") { <p class="field-help">Predefined farewell</p> }
                @if (m.Deleted) { <p>This message was deleted</p> }
                else if (m.Kind == "photo")
                {
                    @if (m.Photo is { } photo) { <img class="chat-photo" src="@PhotoText.Web(photo.Link)" alt="Photo from @(m.Mine ? "you" : conversation.Person.DisplayName)" loading="lazy" data-chat-photo="@photo.Id" /> }
                    @if (m.Mine && m.PhotoState is { } state && state != "approved") { <p class="field-help" data-photo-state="@state">@PhotoText.ChatState(state)</p> }
                }
                else { <p>@m.Text</p> }
                @if (m.Kind != "system")
                {
                <span class="request-actions">
                    @if (m.CanDelete) { <button type="button" class="link-button" @onclick="() => DeleteAsync(m)" data-delete="@m.Id">Delete for both</button> }
                    <button type="button" class="link-button" @onclick="() => HideAsync(m)" data-hide="@m.Id">Hide</button>
                    @if (!m.Mine && !m.Deleted) { <button type="button" class="link-button" @onclick="() => reporting = m.Id" data-report-message="@m.Id">Report</button> }
                </span>
                }
            </li>
        }
    </ul>
    @if (reporting is { } reported)
    {
        <ReportForm SubjectType="message" SubjectId="@reported.ToString()" Name="@(conversation.Person.DisplayName ?? "this person")" Blocked="Closed" />
    }
    @if (conversation.CanSend && messages.Count == 0 && starters.Count > 0)
    {
        <div class="starters" data-starters="@starters.Count">
            <p class="field-help">Something to start with:</p>
            @foreach (var s in starters) { <button type="button" class="chip" @onclick="() => draft = s.Text" data-starter="@s.Chip">@s.Text</button> }
        </div>
    }
    @if (conversation.CanSend)
    {
        <div class="composer-photo">
            <label class="link-button" for="chat-photo">Send a photo</label>
            <InputFile id="chat-photo" class="visually-hidden" OnChange="SendPhotoAsync" accept="image/jpeg,image/png,image/webp" disabled="@busy" data-chat-photo-input />
            <span class="field-help">@PhotoText.ChatRules</span>
        </div>
        <form class="composer" @onsubmit="SendAsync" data-composer>
            <label class="visually-hidden" for="message">Message</label>
            <input id="message" class="composer-input" maxlength="2000" autocomplete="off" @bind="draft" @bind:event="oninput" placeholder="Message" data-message-input />
            <button class="button" type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(draft))" data-send>Send</button>
        </form>
    }
    else if (!conversation.Closed) { <p class="field-help" data-cannot-send>You can't send messages here right now.</p> }
    @* Policy §7: Report and Block straight from the conversation, and the Serious Safety Incident pathway (D190). *@
    <p class="account-actions">
        <button type="button" class="button button-secondary" @onclick="HideConversationAsync" data-hide-conversation>Hide this chat</button>
        <button type="button" class="button button-secondary" @onclick='() => reportingConversation = true' data-report-conversation>Report this chat</button>
        @if (conversation.Person.Id != Guid.Empty)
        {
            @if (confirmBlock) { <button type="button" class="button" @onclick="BlockAsync" data-block-confirm>Block @(conversation.Person.DisplayName ?? "them")</button> }
            else { <button type="button" class="button button-secondary" @onclick="() => confirmBlock = true" data-block-conversation>Block</button> }
        }
        <a class="button button-secondary" href="@($"/me/safety?type=conversation&id={Id}")" data-serious-link>Serious safety incident</a>
        @if (conversation.CanSend) { <button type="button" class="button button-secondary" @onclick="() => ending = true" data-end-open>End conversation</button> }
    </p>
    @if (ending)
    {
        <form class="card stack" @onsubmit="EndAsync" data-end-form>
            <h2>End this conversation</h2>
            <p class="field-help">@PhotoText.EndHelp</p>
            <fieldset class="stack">
                <legend>Send a closing message?</legend>
                @foreach (var (closingId, label) in PhotoText.Closings)
                {
                    <label class="check"><input type="radio" name="closing" checked="@(closing == closingId)" @onchange="() => closing = closingId" data-closing="@closingId" /> @label</label>
                }
                <label class="check"><input type="radio" name="closing" checked="@(closing is null)" @onchange="() => closing = null" data-closing="none" /> No farewell message</label>
            </fieldset>
            <p class="account-actions">
                <button type="submit" class="button" disabled="@busy" data-end-confirm>End conversation</button>
                <button type="button" class="button button-secondary" @onclick="() => ending = false">Keep chatting</button>
            </p>
        </form>
    }
    @if (reportingConversation)
    {
        <ReportForm SubjectType="conversation" SubjectId="@Id.ToString()" Name="@(conversation.Person.DisplayName ?? "this person")" Blocked="Closed" />
    }
}
@* Outside the conversation block, so "This chat is closed." still shows once a block or disconnect closes it (#82). *@
<p role="status" aria-live="polite" class="field-help" data-chat-status="@status">@message</p>
@code {
    [Parameter, EditorRequired] public Guid Id { get; set; }
    private bool loaded, busy, more, live, reportingConversation, confirmBlock, ending;
    private string? draft, status, message, closing;
    private List<ConversationStarter> starters = [];
    private Guid? reporting;
    private DateTimeOffset? before;
    private ConversationView? conversation;
    private List<MessageView> messages = [];
    private MessagesHubClient? hub;

    protected override async Task OnInitializedAsync()
    {
        conversation = (await Members.ConversationAsync(Id)).Value;
        if (conversation is not null)
        {
            var page = (await Members.MessagesAsync(Id)).Value;
            (messages, more, before) = (page?.Items.Reverse().ToList() ?? [], page?.More ?? false, page?.Before);
            hub = new MessagesHubClient(new Uri(Navigation.BaseUri + "bff/hubs/messages"));
            // A photo's state changes arrive as the same message again (#41): replace it in place.
            hub.Message += m => { if (m.ConversationId == Id) { Upsert(m); _ = InvokeAsync(StateHasChanged); } };
            hub.Deleted += d => { if (d.ConversationId == Id) { MarkDeleted(d.MessageId); _ = InvokeAsync(StateHasChanged); } };
            hub.Closed += c => { if (c.ConversationId == Id) _ = InvokeAsync(Closed); };
            try { await hub.StartAsync(); live = true; }
            catch (Exception error) when (error is HttpRequestException or InvalidOperationException) { live = false; }
            // Anything sent while the live connection was opening: read the latest page again and merge.
            foreach (var m in (await Members.MessagesAsync(Id)).Value?.Items.Reverse() ?? [])
                if (messages.All(x => x.Id != m.Id)) messages.Add(m);
            if (messages.Count == 0 && conversation.CanSend) starters = (await Members.StartersAsync(Id)).Value ?? [];
        }
        loaded = true;
    }

    private async Task OlderAsync()
    {
        var page = (await Members.MessagesAsync(Id, before)).Value;
        if (page is null) return;
        messages.InsertRange(0, page.Items.Reverse());
        (more, before) = (page.More, page.Before);
    }

    private async Task SendAsync()
    {
        busy = true;
        var result = await Members.SendMessageAsync(Id, draft ?? "");
        busy = false;
        if (result.Value is { } sent)
        {
            if (messages.All(x => x.Id != sent.Id)) messages.Add(sent);
            (draft, status, message) = (null, "sent", null);
            return;
        }
        (status, message) = (result.Code ?? "failed", result.Code switch
        {
            ProblemCodes.ArrivalRequired => "You can reply, or write first once you've confirmed you've arrived.",
            ProblemCodes.BotCannotInitiate => "This account can't start conversations.",
            ProblemCodes.InvalidMessage => "Write 1 to 2,000 characters.",
            ProblemCodes.TooManyRequests => "That's a lot of messages. Slow down a little.",
            _ => "That message couldn't be sent.",
        });
    }

    private void Upsert(MessageView m)
    {
        var index = messages.FindIndex(x => x.Id == m.Id);
        if (index >= 0) messages[index] = m; else messages.Add(m);
    }

    private async Task SendPhotoAsync(InputFileChangeEventArgs e)
    {
        busy = true;
        try
        {
            if (e.File.Size > 10 * 1024 * 1024) { (status, message) = ("photo-too-big", PhotoText.Refusal("photo-too-big")); return; }
            using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var result = await Members.SendChatPhotoAsync(Id, buffer.ToArray(), e.File.Name, e.File.ContentType);
            // A live screening/deletion event may precede the older upload response. Preserve that event.
        if (result.Value is { } sent) { if (messages.All(m => m.Id != sent.Id)) messages.Add(sent); (status, message) = ("photo-sent", null); }
            else (status, message) = (result.Code ?? "failed", PhotoText.Refusal(result.Code));
        }
        finally { busy = false; }
    }

    private async Task EndAsync()
    {
        busy = true;
        var result = await Members.EndConversationAsync(Id, closing);
        busy = false;
        if (!result.Ok) { (status, message) = ("failed", "That didn't work. Try again."); return; }
        ending = false;
        await Closed();
        (status, message) = ("ended", "You ended this conversation.");
    }

    private async Task DeleteAsync(MessageView m)
    {
        var code = await Members.DeleteMessageAsync(m.Id);
        if (code == 204) MarkDeleted(m.Id);
        (status, message) = code == 204 ? ("deleted", "Deleted for both of you.") : ("failed", "Messages can be deleted for both of you within five minutes.");
    }

    // Q59, D167: a message deleted for both stays in the thread as deleted.
    private void MarkDeleted(Guid id)
    {
        var index = messages.FindIndex(x => x.Id == id);
        if (index >= 0) messages[index] = messages[index] with { Deleted = true, Text = "", CanDelete = false };
    }

    private async Task HideAsync(MessageView m)
    {
        if (await Members.HideMessageAsync(m.Id) == 204) messages.RemoveAll(x => x.Id == m.Id);
    }

    // The block closes the conversation; the API pushes "closed" (#82), and this window closes it at once either way.
    private async Task BlockAsync()
    {
        if (conversation is null) return;
        var code = await Members.BlockAsync(conversation.Person.Id);
        if (code == 204) await Closed();
        else (status, message) = ("failed", "That didn't work. Try again.");
    }

    private async Task HideConversationAsync()
    {
        if (await Members.HideConversationAsync(Id) == 204) Navigation.NavigateTo("/chats");
    }

    private async Task Closed()
    {
        conversation = (await Members.ConversationAsync(Id)).Value;
        if (conversation is not null)
        {
            var page = (await Members.MessagesAsync(Id)).Value;
            (messages, more, before) = (page?.Items.Reverse().ToList() ?? [], page?.More ?? false, page?.Before);
        }
        else messages.Clear();
        (status, message) = ("closed", conversation is null ? "This chat is closed." : PhotoText.ClosedBody);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (hub is not null) await hub.DisposeAsync();
    }
}
