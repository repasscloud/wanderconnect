@* The member's own profile (D92, Interactive WebAssembly): one core profile shared by every mode, then each mode on
   its own card. Turning a mode on or off changes only that mode. Each mode offers its own intention chips (Q16); the
   member picks up to the API's limit, shown as "n of 5", and the API enforces it again. Choices stay when a mode is off. *@
@inject MemberClient Members
@inject IJSRuntime JS
<div class="rd-page">
<div class="page-heading" data-profile-editor="@(loaded ? "ready" : "loading")">
    <p class="breadcrumb"><a href="/me/profile">Me</a> / Profile</p>
    <h1>Your profile</h1>
    @if (!loaded) { <p role="status">Loading…</p> }
    else if (refused is not null) { <p role="status" data-profile-refused="@refused">@(refused == ProblemCodes.BetaNotEnrolled ? "Your profile opens once your email is on the invitation list." : "We couldn't load your profile.")</p> }
    else { <p class="field-help">What people see in every mode. Each mode below can use its own name and about.</p> }
</div>
@if (loaded && refused is null && profile is not null)
{
    @* Issue 422 (owner-approved mockup): name and home city side by side, a full-width about, and the save on the right. *@
    <section class="rd-card" aria-labelledby="core-heading">
        <h2 id="core-heading">About you</h2>
        <form @onsubmit="SaveProfileAsync" data-core-form>
            <div class="rd-grid">
                <div class="field"><label for="display-name">Display name</label><input id="display-name" maxlength="40" @bind="displayName" autocomplete="nickname" /></div>
                <div class="rd-home-city">
                    <CitySearch InputId="home-city" Label="Home city · only you see this" @bind-Selected="homeCity" />
                    @if (profile.HomeCity is not null)
                    {
                        @* D150/D349: optional. The browser asks for one reading; Swoovr keeps only whether it matched, never where you are.
                           Issue 437: it sits with the Home city it checks; the long explanation and the photos link are gone. *@
                        <p class="field-help rd-home-check"><button type="button" class="link-button" disabled="@busy" @onclick="HomeCheckAsync" data-home-check>Check my location matches</button>
                            <span data-home-check-result="@homeCheck">@(homeCheck is null ? "" : MemberText.HomeCheck(homeCheck))</span></p>
                    }
                </div>
            </div>
            @if (string.IsNullOrWhiteSpace(profile.DisplayName))
            {
                <p class="field-help" data-needs-name>Add a display name so people can find you.</p>
            }
            <div class="field"><label for="about">About me <span class="rd-count" data-about-length>· @(about?.Length ?? 0)/500</span></label>
                <textarea id="about" class="rd-large" maxlength="500" rows="6" @bind="about" @bind:event="oninput"
                          placeholder="A few words about you, what you enjoy and what you're looking for."></textarea></div>
            <div class="rd-row rd-row-end">
                <div class="rd-actions">
                    <p role="status" aria-live="polite" class="field-help rd-status" data-core-status="@coreStatus">@coreMessage</p>
                    <button type="submit" class="button" disabled="@busy">Save profile</button>
                </div>
            </div>
        </form>
    </section>

    <ProfileIdentity />
    <ProfileOnlineStatus />

    @* D382 (Q181.5 A), PR 392 review: the text picture from onboarding stays editable and removable here. *@
    <section class="rd-card" aria-labelledby="picture-text-heading" data-picture-text-settings>
        @* Issue 507: a full-width box, then the rules on the left of the buttons. *@
        <h2 id="picture-text-heading">Text picture</h2>
        <form @onsubmit="SavePictureTextAsync" data-picture-text-form>
            <div class="field"><label for="picture-text">What would you like your picture to say? <span class="rd-count" data-picture-text-count>· @(pictureText?.Length ?? 0)/100</span></label>
                <input id="picture-text" maxlength="100" placeholder="Optional" aria-describedby="picture-text-help" @bind="pictureText" @bind:event="oninput" /></div>
            <div class="rd-row rd-text-picture-foot">
                <p class="field-help" id="picture-text-help" data-picture-text-help>No phone numbers, email addresses, social handles or other contact details. Your words are checked like the rest of your profile.</p>
                <div class="rd-actions">
                    @if (profile.PictureText is not null)
                    {
                        <button type="button" class="link-button" disabled="@busy" @onclick="RemovePictureTextAsync" data-picture-text-remove>Remove</button>
                    }
                    <button type="submit" class="button button-secondary" disabled="@(busy || string.IsNullOrWhiteSpace(pictureText) || pictureText.Trim() == profile.PictureText)" data-picture-text-save>Save text picture</button>
                </div>
            </div>
            <p role="status" aria-live="polite" class="field-help rd-status" data-picture-text-status="@pictureTextStatus">@pictureTextMessage</p>
        </form>
    </section>

    @* Issue 422: one folding row per mode. Closed, a mode shows only "Viewable" when it's on and people can see it
       (owner: no On/Off and no counts; the switch already says it's on). Changes save as they're made. *@
    <section class="rd-card" aria-labelledby="modes-heading">
        <div class="rd-row rd-row-baseline">
            <h2 id="modes-heading">Connection modes</h2>
            <p class="field-help">Turn on any combination. Each mode keeps its own settings.</p>
        </div>
        @foreach (var mode in modes)
        {
            var setting = profile.Modes.FirstOrDefault(m => m.Id == mode.Id) ?? new MyModeView(mode.Id, false, false, []);
            var open = expanded.Contains(mode.Id);
            <article class="rd-mode" data-mode-card="@mode.Id" data-mode-enabled="@(setting.Enabled ? "true" : "false")" data-mode-visible="@(setting.Visible ? "true" : "false")" data-mode-open="@(open ? "true" : "false")">
                <div class="rd-mode-head">
                    <div class="rd-mode-name"><strong>@mode.Label</strong>
                        @if (!open && setting.Enabled && setting.Visible) { <span class="field-help" data-mode-summary>Viewable</span> }</div>
                    <label class="rd-switch"><input type="checkbox" class="ph-switch" checked="@setting.Enabled" disabled="@busy" @onchange="e => UseModeAsync(mode.Id, e.Value is true, setting)" /><span>Use @mode.Label</span></label>
                    @if (open && setting.Enabled)
                    {
                        <label class="rd-switch"><input type="checkbox" class="ph-switch" checked="@setting.Visible" disabled="@busy" @onchange="e => SaveModeAsync(mode.Id, setting.Enabled, e.Value is true, setting.Intentions, setting.About)" /><span>Show my profile<span class="visually-hidden"> in @mode.Label</span></span></label>
                    }
                    <button type="button" class="button button-secondary button-xs" aria-expanded="@(open ? "true" : "false")" aria-controls="@($"mode-body-{mode.Id}")" @onclick="() => Fold(mode.Id)" data-mode-toggle="@mode.Id">@(open ? "Close" : "Edit")<span class="visually-hidden"> @mode.Label</span></button>
                </div>
                <div class="rd-mode-body" id="@($"mode-body-{mode.Id}")" hidden="@(!open)">
                    @if (mode.Intentions.Count > 0)
                    {
                        var picked = setting.Intentions.Count(id => mode.Intentions.Any(i => i.Id == id));
                        <div class="chip-picker" data-chip-picker="@mode.Id">
                            <p class="field-help" id="@($"chips-{mode.Id}")"><span>What you're here for</span> <span data-chip-count="@picked">@picked of @mode.MaxIntentions</span></p>
                            <ul class="chip-row" aria-labelledby="@($"chips-{mode.Id}")">
                                @foreach (var intention in mode.Intentions)
                                {
                                    var on = setting.Intentions.Contains(intention.Id);
                                    <li><button type="button" class="chip @(on ? "is-on" : null)" aria-pressed="@(on ? "true" : "false")" data-chip="@intention.Id"
                                                disabled="@(busy || !on && picked >= mode.MaxIntentions)"
                                                @onclick="() => SaveModeAsync(mode.Id, setting.Enabled, setting.Visible, Toggle(setting.Intentions, intention.Id), setting.About)">@intention.Label</button></li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="field" data-mode-name="@mode.Id">
                        <label for="@($"name-{mode.Id}")">Name in @mode.Label <span class="field-help">(optional)</span></label>
                        <input id="@($"name-{mode.Id}")" maxlength="40" autocomplete="nickname" value="@setting.DisplayName" placeholder="@profile.DisplayName" disabled="@busy"
                               @onchange="e => SaveModeAsync(mode.Id, setting.Enabled, setting.Visible, setting.Intentions, setting.About, displayName: e.Value as string ?? string.Empty)" />
                        <p class="field-help">Blank uses your display name. Your registered name is never used here.</p>
                    </div>
                    @* D175: an about for this mode only; people in other modes never see it. #91: the main about shows here only if you say so.
                       Issue 422: a large box, since people write a lot here. *@
                    <div class="field" data-mode-about="@mode.Id">
                        <label for="@($"about-{mode.Id}")">About me in @mode.Label <span class="field-help">(optional, only shown in @mode.Label)</span></label>
                        <textarea id="@($"about-{mode.Id}")" class="rd-large" maxlength="500" rows="7" disabled="@busy" placeholder="@(setting.ShareCoreAbout ? "Uses your main about" : "Empty: no about shows in " + mode.Label)"
                                  @onchange="e => SaveModeAsync(mode.Id, setting.Enabled, setting.Visible, setting.Intentions, e.Value as string)">@setting.About</textarea>
                    </div>
                    <div class="rd-row">
                        <label class="rd-switch"><input type="checkbox" class="ph-switch" data-share-core="@mode.Id" checked="@setting.ShareCoreAbout" disabled="@busy"
                            @onchange="e => SaveModeAsync(mode.Id, setting.Enabled, setting.Visible, setting.Intentions, setting.About, e.Value is true)" /><span>Show my main about when this is empty</span></label>
                        @if (modeSaved == mode.Id) { <p role="status" class="field-help" data-mode-saved="@mode.Id">@modeMessage</p> }
                    </div>
                </div>
            </article>
        }
        <p role="status" aria-live="polite" class="visually-hidden" data-mode-status>@modeMessage</p>
    </section>
    @* Issue 448 (D457): optional details, published per mode; only the modes the member uses can be chosen. *@
    <ProfileDetailsEditor Modes="@(modes.Where(m => profile.Modes.Any(x => x.Id == m.Id && x.Enabled)).Select(m => (m.Id, m.Label)).ToList())"
                          AllModes="@(modes.Select(m => (m.Id, m.Label)).ToList())" />
}
</div>
@code {
    private bool loaded, busy;
    private string? refused, displayName, about, coreMessage, coreStatus, modeMessage, pictureText, pictureTextMessage, pictureTextStatus;
    private PlaceView? homeCity;
    private string? homeCheck, modeSaved;
    // Issue 422: which mode rows are open. The first mode that's on opens on load; turning a mode on opens it.
    private readonly HashSet<string> expanded = [];
    private void Fold(string modeId) { if (!expanded.Remove(modeId)) expanded.Add(modeId); }
    private Task UseModeAsync(string modeId, bool enabled, MyModeView setting)
    {
        if (enabled) expanded.Add(modeId);
        return SaveModeAsync(modeId, enabled, setting.Visible || enabled, setting.Intentions, setting.About);
    }

    private async Task HomeCheckAsync()
    {
        busy = true;
        LocationCheck? reading = null;
        try { reading = await JS.InvokeAsync<LocationCheck?>("swoovrLocation.read"); }
        catch (JSException) { }
        var result = reading is null ? null : await Members.HomeCheckAsync(reading);
        homeCheck = result?.Value?.Outcome ?? "unusable";
        if (homeCheck == "unusable") homeCheck = null;
        busy = false;
    }
    private List<ConnectionModeView> modes = [];
    private MyProfileView? profile;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var catalogue = await Members.ModesAsync();
            var own = await Members.ProfileAsync();
            if (catalogue.Value is null || own.Value is null) refused = catalogue.Code ?? own.Code ?? "unavailable";
            else
            {
                modes = catalogue.Value; Show(own.Value);
                if (modes.FirstOrDefault(m => own.Value.Modes.Any(x => x.Id == m.Id && x.Enabled)) is { } first) expanded.Add(first.Id);
            }
        }
        catch (HttpRequestException) { refused = "unavailable"; }
        loaded = true;
    }

    private void Show(MyProfileView value) => (profile, displayName, about, homeCity, pictureText) = (value, value.DisplayName, value.About, value.HomeCity, value.PictureText);

    private Task SavePictureTextAsync() => PictureTextAsync(pictureText, "Saved.");
    private Task RemovePictureTextAsync() => PictureTextAsync(null, "Removed.");

    // Blank removes it (PUT /api/me/picture-text); the API refuses contact details and keeps the profile otherwise unchanged.
    private async Task PictureTextAsync(string? text, string done)
    {
        busy = true;
        var result = await Members.SavePictureTextAsync(text);
        busy = false;
        if (result.Value is { } saved) { profile = saved; pictureText = saved.PictureText; (pictureTextStatus, pictureTextMessage) = ("saved", done); return; }
        (pictureTextStatus, pictureTextMessage) = (result.Code ?? "failed", result.Code switch
        {
            ProblemCodes.PictureTextContact => "Remove phone numbers, email addresses, links and handles, then try again.",
            ProblemCodes.InvalidProfile => "Keep it to 100 characters on one line.",
            _ => "That didn't work. Try again.",
        });
    }

    private async Task SaveProfileAsync()
    {
        busy = true;
        var result = await Members.SaveProfileAsync(new ProfileUpdate(displayName, about, homeCity?.Id));
        busy = false;
        if (result.Value is { } saved) { Show(saved); (coreStatus, coreMessage) = ("saved", "Saved."); }
        else (coreStatus, coreMessage) = ("invalid", "Check the fields: no special characters, and keep within the lengths shown.");
    }

    private async Task SaveModeAsync(string modeId, bool enabled, bool visible, IReadOnlyList<Guid> intentions, string? about, bool? shareCoreAbout = null, string? displayName = null)
    {
        busy = true;
        var result = await Members.SaveModeAsync(modeId, new ModeUpdate(enabled, visible, intentions, about, shareCoreAbout, displayName));
        busy = false;
        modeSaved = modeId;
        if (result.Value is { } saved) { profile = saved; modeMessage = $"{modes.FirstOrDefault(m => m.Id == modeId)?.Label ?? "Mode"} settings saved."; }
        else modeMessage = result.Code == ProblemCodes.TooManyIntentions ? "You can pick up to five in each mode." : "That change wasn't saved. Try again.";
    }

    private static IReadOnlyList<Guid> Toggle(IReadOnlyList<Guid> current, Guid id) =>
        current.Contains(id) ? current.Where(x => x != id).ToList() : [.. current, id];
}
