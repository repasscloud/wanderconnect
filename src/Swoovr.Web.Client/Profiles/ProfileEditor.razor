@* The member's own profile (D92, Interactive WebAssembly): one core profile shared by every mode, then each mode on
   its own card. Turning a mode on or off changes only that mode. Each mode offers its own intention chips (Q16); the
   member picks up to the API's limit, shown as "n of 5", and the API enforces it again. Choices stay when a mode is off. *@
@inject MemberClient Members
@inject IJSRuntime JS
<div class="page-heading" data-profile-editor="@(loaded ? "ready" : "loading")">
    <p class="breadcrumb"><a href="/account">Me</a> / Profile</p>
    <h1>Your profile</h1>
    @if (!loaded) { <p role="status">Loading…</p> }
    else if (refused is not null) { <p role="status" data-profile-refused="@refused">@(refused == ProblemCodes.BetaNotEnrolled ? "Your profile opens once your email is on the private beta list." : "We couldn't load your profile.")</p> }
</div>
@if (loaded && refused is null && profile is not null)
{
    <Swoovr.Web.Client.Moderation.SafetyAdviceCard />
    <section class="card account-section" aria-labelledby="core-heading">
        <h2 id="core-heading">About you</h2>
        <p class="field-help">The same in every mode. Others see it only in modes you show yourself in.</p>
        <form class="stack" @onsubmit="SaveProfileAsync" data-core-form>
            <div class="field"><label for="display-name">Display name</label><input id="display-name" maxlength="40" @bind="displayName" autocomplete="nickname" /></div>
            <div class="field"><label for="area">Area</label><input id="area" maxlength="60" @bind="area" placeholder="For example, Adelaide CBD" /></div>
            <CitySearch InputId="home-city" Label="Home city" @bind-Selected="homeCity" />
            <p class="field-help">Only you see your home city. It decides who counts as local when people visit (Travel).</p>
            @if (profile.HomeCity is not null)
            {
                @* D150: optional. The browser asks for one reading; Swoovr keeps only whether it matched, never where you are. *@
                <p class="field-help"><button type="button" class="link-button" disabled="@busy" @onclick="HomeCheckAsync" data-home-check>Check my location matches</button>
                    <span data-home-check-result="@homeCheck">@(homeCheck is null ? "" : MemberText.HomeCheck(homeCheck))</span></p>
            }
            <p class="field-help"><a class="link" href="/me/photos" data-photos-link>Your photos</a>: a main photo for every mode, and photos for each mode.</p>
            <div class="field"><label for="about">About me</label><textarea id="about" maxlength="500" rows="4" @bind="about"></textarea></div>
            <button type="submit" class="button" disabled="@busy">Save</button>
            <p role="status" aria-live="polite" class="field-help" data-core-status="@coreStatus">@coreMessage</p>
        </form>
        @if (string.IsNullOrWhiteSpace(profile.DisplayName))
        {
            <p class="field-help" data-needs-name>Add a display name so people can find you.</p>
        }
    </section>

    <section aria-labelledby="modes-heading" class="mode-settings">
        <h2 id="modes-heading">Connection modes</h2>
        <p class="field-help">Turn on any combination. Each mode keeps its own settings.</p>
        @foreach (var mode in modes)
        {
            var setting = profile.Modes.FirstOrDefault(m => m.Id == mode.Id) ?? new MyModeView(mode.Id, false, false, []);
            <article class="card account-section" data-mode-card="@mode.Id" data-mode-enabled="@(setting.Enabled ? "true" : "false")" data-mode-visible="@(setting.Visible ? "true" : "false")">
                <h3>@mode.Label</h3>
                <label class="option"><input type="checkbox" checked="@setting.Enabled" disabled="@busy" @onchange="e => SaveModeAsync(mode.Id, e.Value is true, setting.Visible || e.Value is true, setting.Intentions, setting.About)" /> Use @mode.Label</label>
                <label class="option"><input type="checkbox" checked="@setting.Visible" disabled="@(busy || !setting.Enabled)" @onchange="e => SaveModeAsync(mode.Id, setting.Enabled, e.Value is true, setting.Intentions, setting.About)" /> Show my profile in @mode.Label</label>
                @if (mode.Intentions.Count > 0)
                {
                    var picked = setting.Intentions.Count(id => mode.Intentions.Any(i => i.Id == id));
                    <div class="chip-picker" data-chip-picker="@mode.Id">
                        <p class="field-help" id="@($"chips-{mode.Id}")"><span>What you're here for</span> <span data-chip-count="@picked">@picked of @mode.MaxIntentions</span></p>
                        <ul class="chip-row" aria-labelledby="@($"chips-{mode.Id}")">
                            @foreach (var intention in mode.Intentions)
                            {
                                var on = setting.Intentions.Contains(intention.Id);
                                <li><button type="button" class="chip @(on ? "is-on" : null)" aria-pressed="@(on ? "true" : "false")" data-chip="@intention.Id"
                                            disabled="@(busy || !on && picked >= mode.MaxIntentions)"
                                            @onclick="() => SaveModeAsync(mode.Id, setting.Enabled, setting.Visible, Toggle(setting.Intentions, intention.Id), setting.About)">@intention.Label</button></li>
                            }
                        </ul>
                    </div>
                }
                @* D175: an about for this mode only; people in other modes never see it. #91: the main about shows here only if you say so. *@
                <div class="field" data-mode-about="@mode.Id">
                    <label for="@($"about-{mode.Id}")">About me in @mode.Label <span class="field-help">(optional, only shown in @mode.Label)</span></label>
                    <textarea id="@($"about-{mode.Id}")" maxlength="500" rows="3" disabled="@busy" placeholder="@(setting.ShareCoreAbout ? "Uses your main about" : "Empty: no about shows in " + mode.Label)"
                              @onchange="e => SaveModeAsync(mode.Id, setting.Enabled, setting.Visible, setting.Intentions, e.Value as string)">@setting.About</textarea>
                    <label class="option"><input type="checkbox" data-share-core="@mode.Id" checked="@setting.ShareCoreAbout" disabled="@busy"
                        @onchange="e => SaveModeAsync(mode.Id, setting.Enabled, setting.Visible, setting.Intentions, setting.About, e.Value is true)" /> Show my main about in @mode.Label when this is empty</label>
                </div>
            </article>
        }
        <p role="status" aria-live="polite" class="field-help" data-mode-status>@modeMessage</p>
    </section>
}
@code {
    private bool loaded, busy;
    private string? refused, displayName, area, about, coreMessage, coreStatus, modeMessage;
    private PlaceView? homeCity;
    private string? homeCheck;

    private async Task HomeCheckAsync()
    {
        busy = true;
        LocationCheck? reading = null;
        try { reading = await JS.InvokeAsync<LocationCheck?>("swoovrLocation.read"); }
        catch (JSException) { }
        var result = reading is null ? null : await Members.HomeCheckAsync(reading);
        homeCheck = result?.Value?.Outcome ?? "unusable";
        if (homeCheck == "unusable") homeCheck = null;
        busy = false;
    }
    private List<ConnectionModeView> modes = [];
    private MyProfileView? profile;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var catalogue = await Members.ModesAsync();
            var own = await Members.ProfileAsync();
            if (catalogue.Value is null || own.Value is null) refused = catalogue.Code ?? own.Code ?? "unavailable";
            else { modes = catalogue.Value; Show(own.Value); }
        }
        catch (HttpRequestException) { refused = "unavailable"; }
        loaded = true;
    }

    private void Show(MyProfileView value) => (profile, displayName, area, about, homeCity) = (value, value.DisplayName, value.Area, value.About, value.HomeCity);

    private async Task SaveProfileAsync()
    {
        busy = true;
        var result = await Members.SaveProfileAsync(new ProfileUpdate(displayName, area, about, homeCity?.Id));
        busy = false;
        if (result.Value is { } saved) { Show(saved); (coreStatus, coreMessage) = ("saved", "Saved."); }
        else (coreStatus, coreMessage) = ("invalid", "Check the fields: no special characters, and keep within the lengths shown.");
    }

    private async Task SaveModeAsync(string modeId, bool enabled, bool visible, IReadOnlyList<Guid> intentions, string? about, bool? shareCoreAbout = null)
    {
        busy = true;
        var result = await Members.SaveModeAsync(modeId, new ModeUpdate(enabled, visible, intentions, about, shareCoreAbout));
        busy = false;
        if (result.Value is { } saved) { profile = saved; modeMessage = null; }
        else modeMessage = result.Code == ProblemCodes.TooManyIntentions ? "You can pick up to five in each mode." : "That change wasn't saved. Try again.";
    }

    private static IReadOnlyList<Guid> Toggle(IReadOnlyList<Guid> current, Guid id) =>
        current.Contains(id) ? current.Where(x => x != id).ToList() : [.. current, id];
}
