@* Explore (D92, Interactive WebAssembly): the four-mode segmented control, then the people the API returns for the
   selected mode. Labels and order come from the API's mode records; the API decides who appears (both have the mode
   on, the person made it visible, adult, on the beta) and which badges each tile shows (Q11). Travel is not a mode and
   has its own screen. *@
@inject MemberClient Members
<div class="page-heading" data-explore="@(loaded ? "ready" : "loading")">
    <h1>Explore</h1>
    <p class="field-help"><a class="link" href="/travel" data-travel-link>Travel</a>: plan trips and see who's visiting.</p>
    @if (!loaded) { <p role="status">Loading…</p> }
    else if (refused is not null) { <p role="status" data-explore-refused="@refused">@RefusedText</p> }
</div>
@if (loaded && refused is null)
{
    <nav class="segmented explore-modes" aria-label="Connection mode" data-modes="@string.Join(" ", modes.Select(m => m.Id))">
        @foreach (var mode in modes)
        {
            <button type="button" class="segment" aria-pressed="@(mode.Id == selected ? "true" : "false")" aria-current="@(mode.Id == selected ? "page" : null)"
                    data-mode="@mode.Id" @onclick="() => SelectAsync(mode.Id)">@mode.Label</button>
        }
    </nav>
    <section class="explore-results" aria-live="polite" data-explore-mode="@selected" data-explore-state="@state">
        @if (state == "off")
        {
            <div class="card notice">
                <p>@Label(selected) is off for you, so you can't see who's here.</p>
                <p><a class="link" href="/me/profile">Turn it on in your profile</a></p>
            </div>
        }
        else if (state == "loading") { <p role="status">Loading…</p> }
        else if (people.Count == 0)
        {
            <p class="field-help" data-explore-empty>No one is showing in @Label(selected) yet.</p>
        }
        else
        {
            <div class="people-grid">
                @foreach (var person in people)
                {
                    <ProfileTile Name="@person.DisplayName" Href="@($"/people/{person.Id}")" Area="@(person.Area ?? "")"
                                 Intentions="person.Intentions" Quote="@Quote(person.About)">
                        <Badges><BadgeRow Badges="person.Badges" /></Badges>
                    </ProfileTile>
                }
            </div>
        }
    </section>
}
@code {
    private bool loaded;
    private string? refused;
    private string selected = "";
    private string state = "loading";
    private List<ConnectionModeView> modes = [];
    private MyProfileView? mine;
    private IReadOnlyList<ProfileCard> people = [];

    private string RefusedText => refused switch
    {
        ProblemCodes.BetaNotEnrolled => "Explore opens once your email is on the private beta list.",
        ProblemCodes.AccountLocked => "This account is locked.",
        _ => "We couldn't load Explore. Try again later.",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var catalogue = await Members.ModesAsync();
            var profile = await Members.ProfileAsync();
            if (catalogue.Value is null || profile.Value is null) refused = catalogue.Code ?? profile.Code ?? "unavailable";
            else
            {
                (modes, mine) = (catalogue.Value, profile.Value);
                // Start on the first mode the member has on, else the first one shown.
                selected = mine.Modes.FirstOrDefault(m => m.Enabled)?.Id ?? modes.FirstOrDefault()?.Id ?? "";
            }
        }
        catch (HttpRequestException) { refused = "unavailable"; }
        loaded = true;
        if (refused is null && selected.Length > 0) await SelectAsync(selected);
    }

    private async Task SelectAsync(string modeId)
    {
        (selected, state, people) = (modeId, "loading", []);
        var result = await Members.ExploreAsync(modeId);
        (state, people) = result.Code == ProblemCodes.ModeNotEnabled ? ("off", []) : ("ready", (IReadOnlyList<ProfileCard>?)result.Value?.People ?? []);
    }

    private string Label(string id) => modes.FirstOrDefault(m => m.Id == id)?.Label ?? id;

    // Photo-free tiles show a short quote (UI-STYLE.md); photos are not part of profiles yet.
    private static string Quote(string? about) => about is null ? "No about yet." : about.Length <= 90 ? about : about[..89].TrimEnd() + "…";
}
