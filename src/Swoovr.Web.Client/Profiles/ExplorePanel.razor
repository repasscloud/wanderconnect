@* Explore (D92, Interactive WebAssembly): the four-mode segmented control, then the people the API returns for the
   selected mode. Labels and order come from the API's mode records; the API decides who appears (both have the mode
   on, the person made it visible, adult, on the beta, both living in the same open market, D125) and which badges each
   tile shows (Q11). Without a home city, or outside every open market, the API refuses and the page says why. Travel is
   not a mode and has its own screen. *@
@inject MemberClient Members
<div class="page-heading" data-explore="@(loaded ? "ready" : "loading")">
    <h1>Explore</h1>
    @if (market is not null) { <p class="field-help" data-explore-market>People in @market</p> }
    <p class="field-help"><a class="link" href="/travel" data-travel-link>Travel</a>: plan trips and see who's visiting.</p>
    @if (!loaded) { <p role="status">Loading…</p> }
    else if (refused is not null) { <p role="status" data-explore-refused="@refused">@RefusedText</p> }
</div>
@if (loaded && refused is null)
{
    <nav class="segmented explore-modes" aria-label="Connection mode" data-modes="@string.Join(" ", modes.Select(m => m.Id))">
        @foreach (var mode in modes)
        {
            <button type="button" class="segment" aria-pressed="@(mode.Id == selected ? "true" : "false")" aria-current="@(mode.Id == selected ? "page" : null)"
                    data-mode="@mode.Id" @onclick="() => SelectAsync(mode.Id)">@mode.Label</button>
        }
    </nav>
    <section class="explore-results" aria-live="polite" data-explore-mode="@selected" data-explore-state="@state">
        @if (state == "off")
        {
            <div class="card notice">
                <p>@Label(selected) is off for you, so you can't see who's here.</p>
                <p><a class="link" href="/me/profile">Turn it on in your profile</a></p>
            </div>
        }
        else if (state == ProblemCodes.DateOfBirthRequired)
        {
            <div class="card notice" data-explore-local="date-of-birth-required">
                <p>Add your date of birth to discover people. It's never shown.</p>
                <p><a class="link" href="/account">Add your date of birth</a></p>
            </div>
        }
        else if (state == ProblemCodes.DatingDetailsRequired)
        {
            <div class="card notice" data-explore-local="dating-details-required">
                <p>Dating needs your gender and who you'd like to see.</p>
                <p><a class="link" href="/me/matching">Set who you'd like to meet</a></p>
            </div>
        }
        else if (state == ProblemCodes.HomeCityRequired)
        {
            <div class="card notice" data-explore-local="home-city-required">
                <p>Add your home city to discover people in your community.</p>
                <p><a class="link" href="/me/profile">Add your home city</a></p>
            </div>
        }
        else if (state == ProblemCodes.MarketNotOpen)
        {
            <div class="card notice" data-explore-local="market-not-open" data-interest="@(interested ? "on" : "off")">
                <p>Swoovr isn't available in your area yet. We're expanding to new cities.</p>
                @if (interested)
                {
                    <p>We'll let you know when Swoovr opens near you.</p>
                    <button type="button" class="button button-secondary" disabled="@busy" @onclick="() => InterestAsync(false)">Stop telling me</button>
                }
                else
                {
                    <button type="button" class="button" disabled="@busy" @onclick="() => InterestAsync(true)">Tell me when it opens</button>
                }
                <p class="field-help">You can still plan <a class="link" href="/travel">trips</a> to a Swoovr city.</p>
            </div>
        }
        else if (state == "loading") { <p role="status">Loading…</p> }
        else if (people.Count == 0)
        {
            <p class="field-help" data-explore-empty>No one is showing in @Label(selected) yet.</p>
        }
        else
        {
            <div class="people-grid">
                @foreach (var person in people)
                {
                    @* #90: a rounded distance band between home cities, never a distance. *@
                    <ProfileTile Name="@person.DisplayName" Href="@($"/people/{person.Id}?mode={selected}")" Area="@string.Join(" · ", new[] { person.Area, person.DistanceBand }.Where(x => !string.IsNullOrEmpty(x)))"
                                 Intentions="person.Intentions" Quote="@Quote(person.About)" Photo="@(person.Photo is { } photo ? TilePhoto(photo, person.DisplayName) : null)">
                        <Badges><BadgeRow Badges="person.Badges" /></Badges>
                    </ProfileTile>
                }
            </div>
        }
    </section>
}
@code {
    private bool loaded;
    private string? refused;
    private string? market;
    private bool interested, busy;
    private string selected = "";
    private string state = "loading";
    private List<ConnectionModeView> modes = [];
    private MyProfileView? mine;
    private IReadOnlyList<ProfileCard> people = [];

    private string RefusedText => refused switch
    {
        ProblemCodes.BetaNotEnrolled => "Explore opens once your email is on the private beta list.",
        ProblemCodes.AccountLocked => "This account is locked.",
        _ => "We couldn't load Explore. Try again later.",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var catalogue = await Members.ModesAsync();
            var profile = await Members.ProfileAsync();
            if (catalogue.Value is null || profile.Value is null) refused = catalogue.Code ?? profile.Code ?? "unavailable";
            else
            {
                (modes, mine, interested) = (catalogue.Value, profile.Value, profile.Value.MarketInterest);
                // Start on the first mode the member has on, else the first one shown.
                selected = mine.Modes.FirstOrDefault(m => m.Enabled)?.Id ?? modes.FirstOrDefault()?.Id ?? "";
            }
        }
        catch (HttpRequestException) { refused = "unavailable"; }
        loaded = true;
        if (refused is null && selected.Length > 0) await SelectAsync(selected);
    }

    private async Task SelectAsync(string modeId)
    {
        (selected, state, people) = (modeId, "loading", []);
        var result = await Members.ExploreAsync(modeId);
        (state, people, market) = result.Code switch
        {
            ProblemCodes.ModeNotEnabled => ("off", [], market),
            ProblemCodes.HomeCityRequired or ProblemCodes.MarketNotOpen or ProblemCodes.DateOfBirthRequired or ProblemCodes.DatingDetailsRequired => (result.Code, [], null),
            _ => ("ready", (IReadOnlyList<ProfileCard>?)result.Value?.People ?? [], result.Value?.Market),
        };
    }

    private async Task InterestAsync(bool on)
    {
        busy = true;
        if (await Members.MarketInterestAsync(on) == 204) interested = on;
        busy = false;
    }

    private string Label(string id) => modes.FirstOrDefault(m => m.Id == id)?.Label ?? id;

    // Photo-free tiles show a short quote (UI-STYLE.md); photos are not part of profiles yet.
    private static string Quote(string? about) => about is null ? "No about yet." : about.Length <= 90 ? about : about[..89].TrimEnd() + "…";

    // D203: an approved photo through its short-lived link.
    private static RenderFragment TilePhoto(PhotoView photo, string name) => builder =>
    {
        builder.OpenElement(0, "img");
        builder.AddAttribute(1, "src", PhotoText.Web(photo.Link));
        builder.AddAttribute(2, "alt", $"{name}'s photo");
        builder.AddAttribute(3, "loading", "lazy");
        builder.AddAttribute(4, "data-tile-photo", photo.Id.ToString());
        builder.CloseElement();
    };
}
