@* Profile tile (UI-STYLE.md Layout, source/ui.tsx ProfileTile): every tile is the same 170 × 270, photo or not.
   Photo tile: photo 170 tall, then name + badges, intention chips, area. Photo-free tile: primary-colour block with the
   serif quote (data-font="quote"), name and intentions at the bottom. The whole tile is the name link's target. *@
<article class="profile-tile person-card @(Photo is null ? "is-quote" : "is-photo")" data-tile="@(Photo is null ? "quote" : "photo")">
    @if (Photo is not null)
    {
        <div class="tile-photo">@Photo</div>
        <div class="tile-body">
            <div class="tile-name"><h2><a href="@Href">@Name, @Age</a></h2>@Badges</div>
            <div class="tile-chips">@foreach (var intention in Intentions) { <span class="chip">@intention</span> }</div>
            <p class="tile-area"><Icon Name="pin" Size="11" />@Area</p>
            @ChildContent
        </div>
    }
    else
    {
        <span class="tile-quote-mark" aria-hidden="true" data-font="quote">&ldquo;</span>
        <div class="tile-quote-box"><p class="tile-quote" data-font="quote">@Quote</p></div>
        <div class="tile-name"><h2><a href="@Href">@Name, @Age</a></h2>@Badges</div>
        <p class="tile-intentions">@string.Join(" · ", Intentions)</p>
        @ChildContent
    }
</article>
@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public int Age { get; set; }
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter] public IReadOnlyList<string> Intentions { get; set; } = [];
    [Parameter] public string Area { get; set; } = "";
    [Parameter] public string? Quote { get; set; }
    [Parameter] public RenderFragment? Photo { get; set; }
    [Parameter] public RenderFragment? Badges { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
