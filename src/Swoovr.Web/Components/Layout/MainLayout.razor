@inherits LayoutComponentBase
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation
<div class="@(SignedIn ? "member-layout" : "public-layout")">
<header class="app-header">
    <a class="wordmark" href="/">Swoovr</a>
    @* Bottom tab bar on phones, top navigation on wider screens (UI-STYLE.md Layout). Connections lists requests and connections (D112); Chats is real messaging (D143). *@
    @if (SignedIn)
    {
    <nav class="tab-bar" aria-label="Main">
        @Tab("Explore", "search", "/explore", Path.StartsWith("/explore") || Path.StartsWith("/travel") || Path.StartsWith("/people/") || Path.StartsWith("/prototype/people"))
        @Tab("Connections", "users", "/connections", Path.StartsWith("/connections"))
        @Tab("Chats", "chat", "/chats", Path.StartsWith("/chats") || Path.StartsWith("/prototype/conversation"))
        @Tab("Me", "user", "/account", Path.StartsWith("/account") || Path.StartsWith("/settings") || Path.StartsWith("/me/"))
    </nav>
    }
    else
    {
    <ModeToggle />
    }
</header>
<main id="main-content" tabindex="-1">@Body</main>
<footer class="app-footer"><nav aria-label="Information"><a href="/terms">Terms</a> <a href="/community-guidelines">Community Guidelines</a> <a href="/privacy">Privacy Notice</a> <a href="/safety/advice">Safety Advice</a> @if (SignedIn) { <a href="/settings/appearance">Appearance</a> } <a href="https://swoovr.com/support">Support</a></nav><small class="app-version">Version @BuildVersion</small></footer>
</div>
@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private static string BuildVersion => typeof(Swoovr.Web.Components.App).Assembly.GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false).Cast<System.Reflection.AssemblyInformationalVersionAttribute>().FirstOrDefault()?.InformationalVersion is{}v ? (v.Contains('+') ? v.Split('+')[0]+" · build "+v.Split('+')[1][..Math.Min(8,v.Split('+')[1].Length)] : v) : "1.0.0";
    private bool SignedIn => HttpContext?.User.Identity?.IsAuthenticated == true;
    private bool Prototype => Environment.IsDevelopment() && Configuration.GetValue<bool>("Prototype:Enabled");
    private string Path => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    private static RenderFragment Tab(string label, string icon, string? href, bool active) => href is null
        ? @<span class="tab is-unbuilt" data-tab="@label"><Icon Name="@icon" /><span>@label</span><span class="visually-hidden"> (not built yet)</span></span>
        : @<a class="tab" href="@href" data-tab="@label" aria-current="@(active ? "page" : null)"><Icon Name="@icon" /><span>@label</span></a>;
}
