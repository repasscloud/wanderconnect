@inherits LayoutComponentBase
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
<header class="app-header">
    <a class="wordmark" href="/">Swoovr</a>
    <nav aria-label="Site navigation">@if (Environment.IsDevelopment() && Configuration.GetValue<bool>("Prototype:Enabled")) { <a href="/prototype/people">People preview</a><a href="/prototype/conversation">Connection preview</a> } <a href="/settings/appearance">Appearance</a></nav>
</header>
<main id="main-content">@Body</main>
<footer class="app-footer">A connection platform in progress. Sign-in and member experiences are not connected.</footer>
