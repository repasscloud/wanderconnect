@page "/me/matching"
<PageTitle>Who I'd like to meet — Swoovr</PageTitle>
<div class="column">
@if (!signedIn)
{
    <div class="page-heading"><h1>Who I'd like to meet</h1><p>Sign in to set your preferences.</p></div>
    <p class="account-actions"><a class="primary-link" href="/account/sign-in">Sign in</a></p>
}
else
{
    <MatchingPanel @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
}
</div>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool signedIn;
    protected override void OnInitialized() => signedIn = HttpContext.User.Identity?.IsAuthenticated == true;
}
