@page "/account"
@inject IConfiguration Configuration
<PageTitle>Account — Swoovr</PageTitle>
<div class="column">
@if (!signedIn)
{
    <div class="page-heading">
        <p class="breadcrumb"><a href="/">Me</a> / Account</p>
        <h1>Sign in to Swoovr.</h1>
        <p>Use your email and password or a passkey. Apple and Google sign-in arrive once their developer registrations exist.</p>
    </div>
    @if (!configured)
    {
        <p role="status" class="field-help">Sign-in isn't configured on this server. See docs/delivery/LOCAL-DEVELOPMENT.md.</p>
    }
    else
    {
        <p class="account-actions"><a class="primary-link" href="/account/sign-in">Sign in</a> <a class="button button-secondary" href="/account/create">Create an account</a></p>
    }
}
else
{
    @* Signed-in content runs as Interactive WebAssembly (D59) and reads the API through /bff/. Not prerendered:
       the server never renders member data into HTML, and no Interactive Server circuit is used. *@
    <MemberAccountPanel Name="@name" @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <form method="post" action="/account/sign-out" class="account-sign-out">
        <AntiforgeryToken />
        <button type="submit" class="quiet-button">Sign out</button>
    </form>
}
<nav class="card settings-list" aria-label="Settings"><a href="/settings/appearance">Appearance <Icon Name="back" Size="18" /></a></nav>
</div>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool configured, signedIn;
    private string name = "there";

    protected override void OnInitialized()
    {
        configured = Swoovr.Web.Auth.MemberSignIn.IsConfigured(Configuration);
        signedIn = HttpContext.User.Identity?.IsAuthenticated == true;
        if (signedIn) name = HttpContext.User.Identity!.Name ?? "there";
    }
}
