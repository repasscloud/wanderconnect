@page "/safety/advice"
<PageTitle>Safety Advice — Swoovr</PageTitle>
<PolicyReader Title="@SafetyAdvice.Title" Eyebrow="Safety Advice" Current="/safety/advice" Lede="@SafetyAdvice.Introduction"
              Meta="@PolicyReading.Describe(SafetyAdvice.Version)" Sections="@Sections" SectionExtra="@Extra"
              Note="This educational advice is separate from the terms of use and privacy notice." data-safety-advice-page />
@code {
    private static readonly IReadOnlyList<PolicyReading.Section> Sections =
    [
        new("before-connecting", "1", "Before connecting", [], SafetyAdvice.BeforeConnecting),
        new("before-meeting", "2", "Before meeting", [], SafetyAdvice.BeforeMeeting),
    ];
    private static RenderFragment? Extra(string id) => id == "before-meeting"
        ? @<div class="policy-callout"><p>@SafetyAdvice.Responsibility</p><a class="policy-callout-link" href="/safety">Country-specific Safety &amp; Support<Icon Name="arrow-right" Size="18" /></a></div>
        : null;
}
