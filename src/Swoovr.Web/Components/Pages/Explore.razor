@page "/explore"
<PageTitle>Explore — Swoovr</PageTitle>
<div class="column">
@if (!signedIn)
{
    <div class="page-heading"><h1>Explore</h1><p>Sign in to see who's on Swoovr.</p></div>
    <p class="account-actions"><a class="primary-link" href="/account/sign-in" data-enhance-nav="false">Sign in</a></p>
}
else
{
    @* Signed in: Interactive WebAssembly through /bff/, not prerendered (D59, D85). *@
    <ExplorePanel @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
}
</div>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool signedIn;
    protected override void OnInitialized() => signedIn = HttpContext.User.Identity?.IsAuthenticated == true;
}
