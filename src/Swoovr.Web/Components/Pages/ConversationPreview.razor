@page "/prototype/conversation"
@inject PrototypeConversationClient Client
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation
<PageTitle>Connection preview — Swoovr</PageTitle>
<div class="column">
<div class="page-heading"><p class="breadcrumb"><a href="/">Home</a> / Connection preview</p><h1>A conversation starts with a choice.</h1><p>One invitation. Room to decide. A conversation only when both agree.</p></div>
<aside class="notice prototype-notice"><strong>Fictional adult scenario</strong><p>Alex and Jamie, their verification and their location are simulated. Role switching is a demo control, not sign-in. Only sample messages can be sent. Scenarios expire and are not saved as member conversations.</p></aside>
@if (!Enabled)
{
    <section class="empty-state"><h2>This local preview is off</h2><p>No messaging service is connected.</p></section>
}
else if (!QueryValid || (ScenarioId.HasValue && Result is null))
{
    <section class="empty-state"><h2>Scenario unavailable</h2><p>The fictional scenario may have expired or the local service may be offline.</p><a class="link" href="/prototype/conversation">Start over</a></section>
}
else
{
    @if (Error is not null) { <p role="status" class="notice">@Error</p> }
    @if (Result is null)
    {
        <section class="conversation-panel"><h2>Try both sides of an invitation</h2><p class="subtitle">Start a separate, disposable Alex and Jamie scenario. Resetting a demo does not change the no-repeat-after-decline rule within a conversation.</p>
        <form method="post" @onsubmit="Apply" @formname="ScenarioAction" class="conversation-controls">
            <AntiforgeryToken />
            <div class="field filter-select"><label for="scenario-presence">Simulated presence</label><select id="scenario-presence" name="Input.Travel"><option value="local">Local</option><option value="upcoming">Visiting soon</option><option value="arrived">Arrived (demo)</option></select><span class="field-chevron"><Icon Name="back" Size="18" /></span></div>
            <button class="primary-button" name="Input.Action" value="create">Start fictional scenario</button>
        </form></section>
    }
    else
    {
        <section class="conversation-panel" aria-label="Fictional conversation">
            <div class="chat-head">
                <span class="avatar" aria-hidden="true">@OtherName[..1]</span>
                <div><p class="chat-name">@OtherName <Badge Kind="id" Size="16" Simulated /></p><p class="chat-sub field-help">Viewing as fictional @(Actor == "alex" ? "Alex" : "Jamie")</p></div>
            </div>
            <nav class="segmented conversation-roles" aria-label="Demo role switch"><a class="segment" href="@Url(Result.Id,"alex")" aria-current="@(Actor=="alex" ? "page" : null)">View as fictional Alex</a><a class="segment" href="@Url(Result.Id,"jamie")" aria-current="@(Actor=="jamie" ? "page" : null)">View as fictional Jamie</a></nav>
            <h2 class="chat-state">@Heading</h2>
            <p class="field-help">@Explanation</p>
            @if (Result.CanRead)
            {
                <ol class="conversation-messages chat-thread" aria-label="Sample messages">
                    @foreach (var message in Result.Messages) { <li class="conversation-message bubble @(message.Sender == ActorName ? "mine" : "")"><span class="visually-hidden">@message.Sender: </span><p>@message.Text</p></li> }
                </ol>
            }
            @if (Result.State is "None" or "Pending" or "Accepted")
            {
                <form method="post" @onsubmit="Apply" @formname="ScenarioAction" class="conversation-controls">
                    <AntiforgeryToken /><input type="hidden" name="Input.Revision" value="@Result.Revision" />
                    @if (Result.State is "None" or "Accepted")
                    {
                        var action = Result.State == "None" ? "request" : "send";
                        var label = Result.State == "None" ? "Send sample request" : "Send sample reply";
                        <div class="composer"><span class="composer-input">@(Result.State == "None" ? "Sample request (fixed in this demo)" : "Sample reply (fixed in this demo)")</span><button class="send-button" name="Input.Action" value="@action" aria-label="@label" title="@label"><Icon Name="send" Size="20" /></button></div>
                    }
                    @if (Result.State=="Pending" && Actor!=Requester) { <div class="button-row"><button class="primary-button" name="Input.Action" value="accept">Accept request</button><button class="quiet-button" name="Input.Action" value="decline">Decline request</button></div> }
                    <div class="secondary-actions">
                        @if (Result.State is "Pending" or "Accepted") { <button class="quiet-button button-small" name="Input.Action" value="close">Close conversation</button> }
                        <button class="quiet-button button-small" name="Input.Action" value="block">Block in this scenario</button>
                    </div>
                </form>
            }
            @if (Result.CanReport) { <p class="field-help">Prior-interaction reporting eligibility is retained in the demo rules. No report is submitted here.</p> }
            <p><a class="link" href="/prototype/conversation">Start a separate fictional scenario</a></p>
        </section>
    }
}
</div>
@code {
    [SupplyParameterFromQuery(Name="id")] public string[]? IdInput {get;set;}
    [SupplyParameterFromQuery(Name="actor")] public string[]? ActorInput {get;set;}
    [SupplyParameterFromForm(FormName="ScenarioAction")] private ScenarioInput? Input {get;set;}
    [CascadingParameter] private HttpContext? RequestContext {get;set;}
    public sealed class ScenarioInput {public string? Action {get;set;} public string? Revision {get;set;} public string? Travel {get;set;}}
    private bool Enabled=>Environment.IsDevelopment() && Configuration.GetValue<bool>("Prototype:Enabled");
    private Guid? ScenarioId=>IdInput is [var value] && Guid.TryParse(value,out var id) && id!=Guid.Empty ? id : null;
    private string Actor=>ActorInput is [var value] ? value : "alex";
    private bool QueryValid=>(IdInput is null || IdInput.Length==0 || ScenarioId.HasValue)
        && (ActorInput is null || ActorInput.Length<=1) && Actor is "alex" or "jamie"
        && (RequestContext?.Request.Query.Keys.All(key=>key is "id" or "actor") ?? true);
    private PrototypeConversation? Result;
    private string? Error;
    private static string Url(Guid id,string actor)=>$"/prototype/conversation?id={id}&actor={actor}";
    private string ActorName=>Actor=="alex" ? "Alex" : "Jamie";
    private string OtherName=>Actor=="alex" ? "Jamie" : "Alex";
    private string Requester=>Result?.Messages.FirstOrDefault()?.Sender.ToLowerInvariant() ?? "alex";
    private string Heading=>Result?.State switch {"None"=>"Ready for an invitation","Pending"=>Actor==Requester ? $"Waiting for {OtherName}" : $"An invitation from {OtherName}","Accepted"=>"Conversation accepted","Declined"=>"Request declined","Closed"=>"Conversation closed",_=>"Conversation unavailable"};
    private string Explanation=>Result?.State switch {
        "None"=>"Send one sample request. Until it is accepted, there are no further messages or attachments.",
        "Pending"=>Actor==Requester ? $"{OtherName} decides whether to accept. Another request or reply is not available while you wait." : "Accept to open this fictional conversation, or decline without allowing repeat requests.",
        "Accepted"=>"Both fictional participants can now send the sample reply. Ordinary discovery changes do not end an accepted chat; a block prevents further access.",
        "Declined"=>"This request cannot be sent again in this scenario.","Closed"=>"This conversation is closed. No further messages or requests are available.",_=>"Message history is hidden for both fictional participants. No further messages are available."};
    protected override async Task OnParametersSetAsync()
    {
        Input??=new();Result=null;Error=null;
        if(!Enabled || !QueryValid || !ScenarioId.HasValue)return;
        try{Result=await Client.GetAsync(ScenarioId.Value,Actor);}
        catch(Exception error) when(SafeFailure(error)){Error="The local scenario is unavailable. Start over or try again when the service is running.";}
    }
    private async Task Apply()
    {
        if(!Enabled || !QueryValid || Input is null)return;
        var fields=RequestContext?.Request.Form;
        if(fields is null || fields.Any(p=>p.Value.Count!=1 || p.Key is not ("_handler" or "__RequestVerificationToken" or "Input.Action" or "Input.Revision" or "Input.Travel")))
        {Error="Choose one of the listed demo actions and try again.";return;}
        try
        {
            PrototypeConversation next;
            if(!ScenarioId.HasValue && Input.Action=="create" && Input.Travel is "local" or "upcoming" or "arrived")next=await Client.CreateAsync(Input.Travel);
            else if(ScenarioId.HasValue && Input.Action is "request" or "accept" or "decline" or "send" or "close" or "block"
                && long.TryParse(Input.Revision,System.Globalization.NumberStyles.None,System.Globalization.CultureInfo.InvariantCulture,out var revision))
                next=await Client.ActAsync(ScenarioId.Value,new(Actor,Input.Action,revision));
            else{Error="Choose one of the listed demo actions and try again.";return;}
            Navigation.NavigateTo(Url(next.Id,next.Actor));
        }
        catch(Exception error) when(SafeFailure(error)){Error="The scenario changed or this action is unavailable. Review the current state and try an available action.";}
    }
    private static bool SafeFailure(Exception error)=>error is HttpRequestException or TaskCanceledException or InvalidOperationException or ArgumentException or System.Text.Json.JsonException;
}
