@page "/me/photos"
<PageTitle>Photos — Swoovr</PageTitle>
<SettingsShell Current="photos">
<div class="collection-page member-settings">
@if (!signedIn)
{
    <div class="page-heading"><h1>Your photos</h1><p>Sign in to manage your photos.</p></div>
    <p class="account-actions"><a class="primary-link" href="/account/sign-in" data-enhance-nav="false">Sign in</a></p>
}
else
{
    <PhotosPanel @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
}
</div>
</SettingsShell>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool signedIn;
    protected override void OnInitialized() => signedIn = HttpContext.User.Identity?.IsAuthenticated == true;
}
