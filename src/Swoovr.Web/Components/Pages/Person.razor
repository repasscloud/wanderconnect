@page "/people/{Id:guid}"
<PageTitle>Profile — Swoovr</PageTitle>
<div class="column">
@if (!signedIn)
{
    <div class="page-heading"><h1>Profile</h1><p>Sign in to see profiles.</p></div>
    <p class="account-actions"><a class="primary-link" href="/account/sign-in" data-enhance-nav="false">Sign in</a></p>
}
else
{
    <PersonPanel Id="Id" Mode="@Mode" @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
}
</div>
@code {
    [Parameter] public Guid Id { get; set; }
    // D175: the mode the profile was opened from (Explore, Traveller Search, Who's visiting, Connections).
    [SupplyParameterFromQuery] public string? Mode { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool signedIn;
    protected override void OnInitialized() => signedIn = HttpContext.User.Identity?.IsAuthenticated == true;
}
