@page "/chats"
<PageTitle>Chats — Swoovr</PageTitle>
<div class="collection-page chats-page">
@if (!signedIn)
{
    <div class="page-heading"><h1>Chats</h1><p>Sign in to see your chats.</p></div>
    <p class="account-actions"><a class="primary-link" href="/account/sign-in" data-enhance-nav="false">Sign in</a></p>
}
else
{
    <Swoovr.Web.Client.Account.MemberSetupGate Page="chats" @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
}
</div>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool signedIn;
    protected override void OnInitialized() => signedIn = HttpContext.User.Identity?.IsAuthenticated == true;
}
