@page "/privacy"
@* #99, #22: the member-facing privacy notice (D288/D290 operative reader). Text shared with the app (PrivacyNotice). *@
<PageTitle>Privacy Notice — Swoovr</PageTitle>
<PolicyReader Title="Privacy Notice" Eyebrow="Legal" Current="/privacy"
              Lede="How Swoovr collects, uses, shares and protects your information, and the choices you have."
              Meta="@PolicyReading.Describe(PrivacyNotice.Version)" Sections="@Sections" SectionAttribute="data-privacy-section"
              HeadingAttributes="@Heading" SectionExtra="@Extra" />
@code {
    private static readonly IReadOnlyDictionary<string, object> Heading = new Dictionary<string, object> { ["data-privacy-notice"] = true };
    private static readonly IReadOnlyList<PolicyReading.Section> Sections =
        PrivacyNotice.Sections.Select((s, i) => new PolicyReading.Section(
            s.Id, (i + 1).ToString(System.Globalization.CultureInfo.InvariantCulture), s.Title, s.Paragraphs, [])).ToList();
    private static RenderFragment? Extra(string id) => id switch
    {
        "law-enforcement" => @<a class="policy-callout-link" href="/law-enforcement">Information for law enforcement<Icon Name="arrow-right" Size="18" /></a>,
        "choices" => @<a class="policy-callout-link" href="/account/data">Your data and account<Icon Name="arrow-right" Size="18" /></a>,
        _ => null,
    };
}
