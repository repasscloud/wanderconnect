@page "/welcome"
@* Issue 254 (D342): dedicated onboarding screens for a new (or returning, unfinished) member: name, mobile number,
   code, then date of birth. RestrictionGate sends every other signed-in page here until the API's setupStep is done,
   so signing out and in again lands back on the same step. The steps run as Interactive WebAssembly (D59) through /bff/;
   sign-out is static here so it keeps its antiforgery token. *@
<PageTitle>Welcome to Swoovr</PageTitle>
@if (!signedIn)
{
    <div class="account-page">
        <div class="page-heading"><h1>Sign in to Swoovr.</h1></div>
        <p class="account-actions"><a class="primary-link" href="/account/sign-in" data-enhance-nav="false">Sign in</a></p>
    </div>
}
else
{
    <div class="onboarding-page">
        <Swoovr.Web.Client.Account.OnboardingFlow @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
        <div class="onboarding-exit" data-onboarding-exit>
            <a href="@SupportTicketText.MemberPath">Contact support</a>
            <form method="post" action="/account/sign-out">
                <AntiforgeryToken />
                <button type="submit" class="link-button" data-onboarding-sign-out>Sign out</button>
            </form>
        </div>
    </div>
}
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool signedIn;
    protected override void OnInitialized() => signedIn = HttpContext.User.Identity?.IsAuthenticated == true;
}
