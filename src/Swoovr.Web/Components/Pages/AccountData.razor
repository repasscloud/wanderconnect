@page "/account/data"
@page "/account/deletion"
@* D144, D170–D173: download your data and delete your account. Under /account so restricted members and members with a
   pending deletion can reach it (RestrictionGate keeps /account open). The API decides everything; this only hosts the panel. *@
<PageTitle>Your data and account — Swoovr</PageTitle>
<SettingsShell Current="account">
<div class="column">
@if (!signedIn)
{
    <div class="page-heading"><h1>Your data and account</h1><p>Sign in to download your data or delete your account.</p></div>
    <p class="account-actions"><a class="primary-link" href="/account/sign-in" data-enhance-nav="false">Sign in</a></p>
}
else
{
    @* Issue 258 (D343): no full-width Sign out bar here; Sign out stays under Account management on Account settings. *@
    <DataAndDeletionPanel @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
}
</div>
</SettingsShell>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool signedIn;
    protected override void OnInitialized() => signedIn = HttpContext.User.Identity?.IsAuthenticated == true;
}
