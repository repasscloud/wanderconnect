@page "/me/verification"
@page "/me/verification/return"
<PageTitle>ID verification — Swoovr</PageTitle>
<div class="column">
@if (!signedIn)
{
    <div class="page-heading"><h1>ID verification</h1><p>Sign in to verify your ID.</p></div>
    <p class="account-actions"><a class="primary-link" href="/account/sign-in" data-enhance-nav="false">Sign in</a></p>
}
else
{
    @* /return is where Didit sends the member back (D152); the panel re-reads the result through the API either way. *@
    <VerificationPanel @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
}
</div>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool signedIn;
    protected override void OnInitialized() => signedIn = HttpContext.User.Identity?.IsAuthenticated == true;
}
