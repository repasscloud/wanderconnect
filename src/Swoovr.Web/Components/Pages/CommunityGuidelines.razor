@page "/community-guidelines"
<PageTitle>Community Guidelines — Swoovr</PageTitle>
<PolicyReader Title="@Document.Title" Eyebrow="Community" Current="/community-guidelines"
              Lede="@Document.Paragraphs.FirstOrDefault()" Meta="@PolicyReading.Describe(PublicPolicies.Version)" Sections="@Sections"
              Note="@PublicPolicies.ReadingNote"
              data-public-policy="community" data-policy-version="@PublicPolicies.Version" data-policy-status="@PublicPolicies.Status" />
@code {
    private static PublicPolicies.Document Document => PublicPolicies.Community;
    // Section headings are presentation labels only (DEFAULT, owner review 4 November 2026); the approved wording is unchanged.
    private static readonly IReadOnlyList<PolicyReading.Section> Sections =
    [
        new("standards", "1", "Our standards", [], Document.Rules),
        .. Document.Paragraphs.Skip(1).Select((p, i) => new PolicyReading.Section(
            $"guidance-{i + 2}", (i + 2).ToString(System.Globalization.CultureInfo.InvariantCulture), i == 0 ? "Reporting concerns" : "More guidance", [p], [])),
    ];
}
