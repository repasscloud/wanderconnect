@page "/me/notifications"
<PageTitle>Notifications — Swoovr</PageTitle>
<SettingsShell Current="notifications">
<div class="reading-page">
@if (!signedIn)
{
    <div class="page-heading"><h1>Notifications</h1><p>Sign in to see your notifications.</p></div>
    <p class="account-actions"><a class="primary-link" href="/account/sign-in" data-enhance-nav="false">Sign in</a></p>
}
else
{
    <NotificationsPanel @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
}
</div>
</SettingsShell>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool signedIn;
    protected override void OnInitialized() => signedIn = HttpContext.User.Identity?.IsAuthenticated == true;
}
