@page "/"
<PageTitle>Swoovr — Your kind of connection</PageTitle>
<div class="home">
    <div class="page-heading home-heading">
        <p class="eyebrow">Dating, friendship and activities</p>
        <h1>Your kind of connection.</h1>
        <p class="home-lede">Friendship, conversation, romance, or a shared afternoon. Find room for the way you want to connect.</p>
        <div class="home-actions">
        @if (HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            <a class="primary-button" href="/explore">Explore</a><a class="button button-secondary" href="/account">Your account</a>
        }
        else
        {
            <a class="primary-button" href="/account/sign-in" data-enhance-nav="false">Sign in</a><a class="button button-secondary" href="/account/create" data-enhance-nav="false">Create account</a>
        }
        </div>
        <p class="field-help">For adults aged 18 and over.</p>
    </div>
    <section class="card welcome-context" aria-labelledby="connection-options"><h2 id="connection-options">Ways to connect</h2><dl><dt>Dating</dt><dd>Be clear about the connection you're looking for.</dd><dt>Friendship</dt><dd>Make room for new people in your everyday life.</dd><dt>Activities</dt><dd>Find a shared interest and something to do together.</dd></dl></section>
</div>
@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
}
