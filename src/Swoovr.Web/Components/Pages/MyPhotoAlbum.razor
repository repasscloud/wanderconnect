@page "/me/photos/albums/{AlbumId:guid}"
<PageTitle>Album — Swoovr</PageTitle>
<SettingsShell Current="photos">
<div class="collection-page member-settings">
@if (!signedIn)
{
    <div class="page-heading"><h1>Album</h1><p>Sign in to manage your photos.</p></div>
    <p class="account-actions"><a class="primary-link" href="/account/sign-in" data-enhance-nav="false">Sign in</a></p>
}
else
{
    <AlbumPanel AlbumId="AlbumId" @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
}
</div>
</SettingsShell>
@code {
    [Parameter] public Guid AlbumId { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool signedIn;
    protected override void OnInitialized() => signedIn = HttpContext.User.Identity?.IsAuthenticated == true;
}
