@inject AdminClient Admin
@* issue 190 §2, §9: identity, contact, location and registration. Sensitive values are masked by the API; the date of birth opens
   with a recorded purpose, which also takes the time-limited "profile-dob-open" access (60 minutes) in the same step. *@
<div class="acct-grid">
    <div class="ui-card">
        <h2 class="ui-card-title">Identity</h2>
        <dl class="ad-dl">
            <div><dt>Registered name</dt><dd data-registered-identity>@(names is { } n ? $"{n.FirstName} {n.LastName}".Trim() : "Not provided") @if (names is not null) {<span class="ui-sub">@(names.Confirmed ? "Confirmed by the member" : "Awaiting confirmation") · @(names.MatchesId is null ? "No ID comparison" : names.MatchesId == true ? "Matches ID" : "Differs from ID")</span>}</dd><dd class="ad-act"><a class="ui-button-ghost" href="/name-reviews">Name changes</a></dd></div>
            <div><dt>Date of birth</dt>
                <dd data-dob-check="@Account.DobCheck">
                    @if (dob is not null) {<span data-profile-dob>@(dob.DateOfBirth?.ToString("d MMMM yyyy") ?? "No date saved")</span>}
                    else {<span class="ad-masked" aria-label="Hidden">•• ••• ••••</span>}
                    <span class="ad-tag">@(Account.DateOfBirthVerified ? "Verified by ID" : Account.DobCheck switch { "correctionNeeded" => "Correction requested", "manualReview" => "Waiting for review", _ => "Saved, not verified" })</span>
                </dd>
                <dd class="ad-act">@if (dob is null) {<button type="button" class="ui-button-ghost" data-dialog-open="dob-open" data-op="dob-open">View date of birth</button>}</dd></div>
            <div><dt>Age</dt><dd>@(Account.Age?.ToString() ?? "Not provided") · @AccountLabels.Age(Account.AgeStatus)</dd><dd></dd></div>
            <div><dt>Display name</dt><dd>@(Account.DisplayName ?? "None")</dd><dd class="ad-act"><a class="ui-button-ghost" href="/accounts/@Account.Id/profiles">Profiles</a></dd></div>
            <div><dt>Verified identity</dt><dd data-identity-on-file="@(Account.IdentityOnFileSince is null ? "none" : "on-file")">@(Account.IdentityOnFileSince is { } since ? $"On file since {since:d MMM yyyy}{(Account.IdentityIssuingCountry is { } c ? $" · {c}" : "")}" : "None on file")</dd>
                <dd class="ad-act">@if (Account.IdentityOnFileSince is not null) {<a class="ui-button-ghost" href="/identity?account=@Account.Id">Open (Legal)</a>}</dd></div>
        </dl>
        @if (Account.Realm == "members" && Permissions?.Verify == true) { <DobCorrectionTools AccountId="Account.Id" /> }
    </div>
    <div class="ui-card">
        <h2 class="ui-card-title">Contact &amp; sign-in</h2>
        <dl class="ad-dl">
            <div><dt>Email</dt><dd data-contact-email>@(Contact?.EmailMasked ?? "None") @if (Contact?.EmailMasked is not null) {<span class="ad-tag">Verified</span>}</dd><dd></dd></div>
            <div><dt>Mobile</dt><dd data-contact-mobile>@(Contact?.MobileMasked ?? "None") @if (Contact?.MobileVerifiedAt is { } at) {<span class="ad-tag">Verified @at.ToString("d MMM yyyy")</span>}</dd><dd></dd></div>
            <div><dt>Joined</dt><dd>@(Contact?.CreatedAt.ToString("d MMM yyyy") ?? "—")</dd><dd></dd></div>
            <div><dt>Last active</dt><dd>@(Contact?.LastSeenAt.ToString("d MMM yyyy HH:mm") ?? "—") UTC</dd><dd class="ad-act"><a class="ui-button-ghost" href="/accounts/@Account.Id/access">Sign-in &amp; access</a></dd></div>
        </dl>
    </div>
    @if (Account.Realm == "members")
    {
        <div class="ui-card" data-home-city-check="@(Account.HomeCityCheck?.Latest?.Result ?? "none")">
            <h2 class="ui-card-title">Location</h2>
            <dl class="ad-dl">
                <div><dt>Home market</dt><dd data-home-market="@(Account.HomeMarket ?? "none")">@(Account.HomeMarket ?? "None")@(Account.HomeMarketMovedAt is { } moved ? $" · moved {moved:d MMM yyyy}" : "")</dd>
                    <dd class="ad-act">@if (Account.HomeMarketMovedAt is not null) { if (Permissions?.EditLocation == true) {<button type="button" class="ui-button-ghost" data-dialog-open="home-wait" data-op="home-override">Lift wait</button>} else {<RoleNote />} }</dd></div>
                @* D349, issue 281: the scheduled Home City check, in observed days only. It never changes the Home City or restricts anyone. *@
                <div><dt>Home City check</dt>
                    <dd data-home-city-latest="@(Account.HomeCityCheck?.Latest?.Result ?? "none")">@CheckText(Account.HomeCityCheck)
                        @if (Account.HomeCityCheck?.Latest is { TicketId: { } ticket, ItemReference: { } reference }) {<span class="ui-sub"> · <a href="/tickets/@ticket" data-home-city-item="@reference">@reference</a></span>}
                        @if (Account.HomeCityCheck?.DontSuggestBefore is { } until) {<span class="ad-tag" data-dont-suggest-before="@until.ToString("yyyy-MM-dd")">Not before @until.ToString("d MMM yyyy")</span>}</dd>
                    <dd class="ad-act"><button type="button" class="ui-button-ghost" data-dialog-open="home-city-check" data-op="home-city-check">Don't suggest before</button></dd></div>
                <div><dt>Trips</dt><dd data-trips="@trips.Count">@(trips.Count == 0 ? "None" : $"{trips.Count} trip{(trips.Count == 1 ? "" : "s")}")</dd><dd></dd></div>
            </dl>
            @if (trips.Count > 0)
            {
                <ul class="ui-list ad-trips">
                    @foreach (var t in trips)
                    {
                        <li data-trip="@t.Id" data-arrival="@t.ArrivalState"><span><strong>@(t.Market ?? "Outside every market")</strong> <span class="ui-sub">@t.Arrival.ToString("d MMM yyyy") – @t.Departure.ToString("d MMM yyyy") · @t.State · arrival @t.ArrivalState@(t.ArrivalMethod is { } m ? $" ({m})" : "")</span></span>
                            @if (t.ArrivalState != "arrived" && t.State is not ("expired" or "cancelled")) {<button type="button" class="ui-button-ghost" data-dialog-open="@($"arrival-{t.Id}")" data-op="confirm-arrival">Confirm arrival</button>}
                        </li>
                    }
                </ul>
            }
        </div>
    }
    <div class="ui-card">
        <h2 class="ui-card-title">Registration</h2>
        <dl class="ad-dl">
            <div><dt>Account type</dt><dd>@AccountLabels.Realm(Account.Realm)@(Account.Founder ? " · founding member" : "")</dd><dd></dd></div>
            <div><dt>Open cases</dt><dd>@Account.OpenCases</dd><dd class="ad-act"><a class="ui-button-ghost" href="/accounts/@Account.Id/conversations">Cases</a></dd></div>
            <div><dt>Related</dt><dd><a href="/accounts/@Account.Id/reinstate" data-account-reinstatement>Reinstatement review</a> · <a href="/registry">Identifier review</a></dd><dd></dd></div>
        </dl>
    </div>
</div>

<ConfirmDialog Id="dob-open" FormName="dob-open" Title="Open date of birth" Confirm="Open" OnSubmit="OpenDobAsync">
    <label class="ui-field"><span>Purpose</span><select name="purpose" required>@foreach (var p in Purposes){<option>@p</option>}</select></label>
    <NoteField Name="detail" Label="Details" Required="true" Max="300" />
    <p class="ui-help">Access lasts 60 minutes and is recorded against your name.</p>
</ConfirmDialog>
<ConfirmDialog Id="home-wait" FormName="home-wait" Title="Lift the 30-day home-city wait" Confirm="Lift wait" OnSubmit='() => RunAsync("home")'>
    <label class="ui-field"><span>Reason</span><select name="reason" required><option>Moved for work, confirmed</option><option>Relocation evidence reviewed</option><option>Staff error</option></select></label>
</ConfirmDialog>
<ConfirmDialog Id="home-city-check" FormName="home-city-check" Title="Don't suggest a Home City update before" Confirm="Save" OnSubmit='() => RunAsync("home-city-check")'>
    <label class="ui-field"><span>Date</span><input type="date" name="until" value="@(Account.HomeCityCheck?.DontSuggestBefore?.ToString("yyyy-MM-dd") ?? "")" /></label>
    <label class="ui-field"><span>Reason</span><select name="reason" required><option>Member confirmed their Home City</option><option>Member is away for a while</option><option>Already discussed with the member</option><option>Clear the date</option></select></label>
    <p class="ui-help">Leave the date empty to clear it. Recorded against your name.</p>
</ConfirmDialog>
@foreach (var t in trips.Where(t => t.ArrivalState != "arrived" && t.State is not ("expired" or "cancelled")))
{
    <ConfirmDialog Id="@($"arrival-{t.Id}")" FormName="@($"arrival-{t.Id}")" Title="Confirm arrival" Confirm="Confirm arrival" OnSubmit='() => RunAsync("arrival", t.Id)'>
        <label class="ui-field"><span>Reason</span><select name="reason" required><option>Arrival confirmed with the member</option><option>Travel evidence reviewed</option></select></label>
    </ConfirmDialog>
}
@code {
    [Parameter, EditorRequired] public AccountAdminSummary Account { get; set; } = null!;
    [Parameter] public AccountContactView? Contact { get; set; }
    [Parameter] public AccountPermissionsView? Permissions { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [CascadingParameter] private HttpContext? Context { get; set; }
    private static readonly string[] Purposes = ["Member support request", "Investigate a report", "Age or identity review", "Respond to a lawful request"];
    private RegisteredNamesView? names;
    private StaffDateOfBirth? dob;
    private List<TripAdminView> trips = [];
    [Parameter] public Action<(int Status, string? Code, string Done)>? Report { get; set; }

    protected override async Task OnInitializedAsync()
    {
        names = (await Admin.RegisteredNamesAsync(Account.Id)).Value;
        if (Account.Realm == "members") trips = (await Admin.TripsAsync(Account.Id)).Value ?? [];
    }

    private string Field(string name) => Context?.Request.HasFormContentType == true ? Context.Request.Form[name].ToString() : "";

    private async Task OpenDobAsync()
    {
        var purpose = $"{Field("purpose")}: {Field("detail").Trim()}";
        // issue 190 §2: take the access (if not already held) and open the date in one step; both are recorded server-side.
        var grants = (await Admin.GrantsAsync()).Value ?? [];
        if (!grants.Any(g => g.Active && g.Capability == "profile-dob-open"))
        {
            var grant = await Admin.RequestGrantAsync(new AccessGrantRequest("profile-dob-open", purpose));
            if (!grant.Ok) { Report?.Invoke((grant.Status, grant.Code, "")); return; }
        }
        var result = await Admin.ProfileDobAsync(Account.Id, purpose);
        dob = result.Value;
        Report?.Invoke((result.Status, result.Code, "Date of birth opened. Access is recorded."));
    }

    private async Task RunAsync(string op, Guid? item = null)
    {
        var reason = Field("reason");
        var (status, code) = op switch
        {
            "home" => Of(await Admin.HomeMoveOverrideAsync(Account.Id, reason)),
            "home-city-check" => Of(await Admin.SetHomeCityCheckAsync(Account.Id, DateOnly.TryParse(Field("until"), System.Globalization.CultureInfo.InvariantCulture, out var until) ? until : null, reason)),
            "arrival" => Of(await Admin.ConfirmArrivalAsync(item!.Value, reason)),
            _ => (400, null),
        };
        Report?.Invoke((status, code, "Saved."));
        await Changed.InvokeAsync();
        if (Account.Realm == "members") trips = (await Admin.TripsAsync(Account.Id)).Value ?? [];
    }
    private static (int, string?) Of<T>(ApiResult<T> result) => (result.Status, result.Code);

    /// <summary>D349: the latest result in observed days, and the current period. Never places or positions.</summary>
    private static string CheckText(HomeCityCheckAdminView? check)
    {
        var period = check?.PeriodFrom is { } from ? $"Current period {from:d MMM}{(check.PeriodTo is { } to ? $" – {to:d MMM yyyy}" : "")}" : "No current period";
        if (check?.Latest is not { } last) return $"No check yet · {period}";
        var result = last.Result switch
        {
            "suggested" => "Suggested", "noSuggestion" => "No suggestion", "skipped" => "Skipped (too few days with readings)",
            "suppressed" => last.Suppression switch { "dontSuggestBefore" => "Not raised (don't suggest before)", "openItem" => "Not raised (item already open)", "cooldown" => "Not raised (within 90 days of closure)", "homeCityChanged" => "Withdrawn (Home City changed)", _ => "Not raised" },
            _ => last.Result,
        };
        var item = last.Item switch { "pending" => " · item waiting for Zammad", "failed" => " · item could not be created", _ => "" };
        return $"{result} · {last.Observed} · {last.PeriodStart:d MMM} – {last.PeriodEnd:d MMM yyyy}{item} · {period}";
    }
}
