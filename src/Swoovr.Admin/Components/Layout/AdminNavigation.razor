@code {
[Parameter] public bool Drawer { get; set; }
private string Path => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
private bool IsActive(string href) => href == "/" ? Path.Length == 0 : Path == href || Path.StartsWith(href + "/", StringComparison.Ordinal);
}
