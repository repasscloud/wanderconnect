@page "/cases/{Id:guid}"
@inject AdminClient Admin
<PageTitle>Case — Swoovr admin</PageTitle>
<p class="breadcrumb"><a href="/cases">Queue</a> / Case</p>
@if (message is not null) { <p class="notice" role="status" data-result="@resultCode">@message @if (reauth) { <a href="/sign-in?reauth=true&returnUrl=/cases/@Id">Sign in again</a> }</p> }
@if (detail is null)
{
    <p data-case-detail="missing">@(loadError ?? "Not found, or not available to your role.")</p>
}
else
{
    var c = detail.Case;
    <h1 data-case-detail="@c.Id">@(c.SubjectName ?? "(no name)")</h1>
    @if (detail.EvidencePurgedAt is { } expired) { <p class="notice" data-case-evidence-expired>Investigation content was disposed under its retention schedule on @expired.ToString("d MMM yyyy"). Remaining records are the restricted compliance summary. A disposed review cannot be reopened.</p> }

    <dl class="facts">
        <div><dt>Status</dt><dd data-case-status="@c.Status">@c.Status</dd></div>
        <div><dt>Priority</dt><dd>@c.Priority</dd></div>
        <div><dt>Queue</dt><dd>@c.Queue@(detail.StaffAffiliatedSubject ? " (staff-affiliated)" : "")</dd></div>
        <div><dt>Member</dt><dd><a href="/accounts/@c.SubjectAccountId">Open account</a></dd></div>
    </dl>
    <form method="post" @formname="step" @onsubmit="StepAsync" class="row" data-enhance="false">
        <AntiforgeryToken />
        @if (c.AwaitingAcknowledgement) { <button name="StepForm.Step" value="acknowledge" type="submit" data-step="acknowledge">Acknowledge urgent report</button> }
        @if (c.Status == "open") { <button name="StepForm.Step" value="review" type="submit" class="secondary" data-step="review">Start review</button> }
        @if (c.Status != "closed") { <button name="StepForm.Step" value="close" type="submit" class="secondary" data-step="close">Close case</button> }
    </form>

    @if (c.SystemFlag is "returning-terminated-identity" or "returning-terminated-phone")
    {
        @* D191, #87: a lead, never proof; numbers are reassigned and names repeat. *@
        <p class="notice" data-system-flag="@c.SystemFlag">Swoovr opened this case: this account's @(c.SystemFlag == "returning-terminated-phone" ? "verified mobile number" : "verified identity (name and date of birth)") matches a terminated member's. Nothing is blocked; a match alone doesn't prove it's the same person.</p>
    }
    @if (c.SystemFlag == "returning-terminated")
    {
        @* D171: opened by Swoovr, not a report. Nothing is blocked; an admin decides whether this is the same person. *@
        <p class="notice" data-system-flag="returning-terminated">Swoovr opened this case: the account's verified email matches a terminated member who deleted their account in the last two years. Nothing is blocked automatically.</p>
    }
    <h2>Reports (@detail.Reports.Count)</h2>
    <ul class="list" data-reports>
        @foreach (var r in detail.Reports)
        {
            <li data-report="@r.Id"><strong>@r.Category</strong> (@r.Priority) about a @r.SubjectType · @r.CreatedAt.ToString("d MMM HH:mm")
                @if (r.Police is not null) { <span class="help" data-report-police="@r.Police"> · police: @(r.Police switch { "contacted" => "the reporter has contacted police", "will-contact" => "the reporter wants to contact police", _ => "not now" })</span> }
                @if (r.Text is not null) { <blockquote>@r.Text</blockquote> }</li>
        }
    </ul>
    <p><a href="/cases/@Id/text-review">Review automated text candidates</a></p>
    <p><a href="/cases/@Id/content">Review individual text removals and retained evidence</a></p>
    <h2>Evidence</h2>
    <ul class="list" data-evidence>
        @foreach (var e in detail.Evidence) { <li><span class="help">@e.Kind, captured @e.CapturedAt.ToString("d MMM HH:mm")</span><pre>@e.Snapshot</pre></li> }
    </ul>
    @if (ReportedPhotos.Count > 0)
    {
        @* #41: a chat photo the evidence names, for admins, with a recorded purpose; never a blocked one. *@
        <form method="post" @formname="photo" @onsubmit="PhotoAsync" class="row" data-case-photo-form data-enhance="false">
            <AntiforgeryToken />
            <select name="PhotoForm.MediaId">@foreach (var p in ReportedPhotos) { <option value="@p">@p</option> }</select>
            <input name="PhotoForm.Purpose" placeholder="Why you need to look" maxlength="500" required />
            <button type="submit" class="secondary" data-case-photo-open>Open reported photo</button>
        </form>
        @if (photoLink is not null) { <img src="/media/@photoLink" alt="Reported chat photo" width="320" data-case-photo /> }
    }
    @if (shownAtReport is { } shown)
    {
        @* #91: what others could see of the subject when the first report was made, mode by mode. *@
        <h2>Profile as shown when reported (@shown.ReportedAt.ToLocalTime().ToString("d MMM HH:mm"))</h2>
        <ul class="list" data-profile-at-report="@shown.Versions.Count">
            @foreach (var v in shown.Versions) { <li data-profile-version="@v.Mode"><span class="help">@v.Mode, version of @v.CapturedAt.ToLocalTime().ToString("d MMM HH:mm")</span><pre>@v.ContentJson</pre></li> }
        </ul>
    }

    <h2>Action</h2>
    @if (c.Status != "closed")
    {
        <form method="post" @formname="act" @onsubmit="ActAsync" class="stack" data-action-form data-enhance="false">
            <AntiforgeryToken />
            <label>Action
                <select name="ActForm.Action">
                    <option value="dismiss">Dismiss (no action)</option>
                    <option value="warn">Warn</option>
                    <option value="restrict">Restrict (up to 30 days; the member can't use the app)</option>
                    <option value="suspend">Suspend (admins, up to 90 days)</option>
                    <option value="terminate">Terminate (admins)</option>
                </select></label>
            <label>Reason (shown to the member)<textarea name="ActForm.Reason" maxlength="1000" rows="3"></textarea></label>
            <label>Days<input name="ActForm.Days" type="number" min="1" max="90" /></label>
            <fieldset><legend>Recorded with a restriction (the member is fully restricted either way, Q55)</legend>
                <label><input type="checkbox" name="ActForm.HideFromDiscovery" value="true" /> Out of discovery</label>
                <label><input type="checkbox" name="ActForm.NoNewRequests" value="true" /> No new requests</label>
                <label><input type="checkbox" name="ActForm.NoMessages" value="true" /> No messages</label>
            </fieldset>
            <button type="submit" data-act>Apply</button>
        </form>
    }
    @* D189: an admin may preserve evidence at once; the security and legal officer confirms or releases the hold. *@
    <h2>Preserve evidence</h2>
    <form method="post" @formname="preserve" @onsubmit="PreserveAsync" class="row" data-preserve-form data-enhance="false">
        <AntiforgeryToken />
        <input name="PreserveForm.Reason" placeholder="Why this needs preserving" maxlength="1000" required />
        <button type="submit" class="secondary" data-preserve>Place a provisional hold</button>
    </form>
    <h2>Actions recorded for this case</h2>
    <SanctionList Sanctions="detail.Sanctions" ReturnUrl="@($"/cases/{Id}")" />
}
@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromForm(FormName = "step")] public StepModel? StepForm { get; set; }
    [SupplyParameterFromForm(FormName = "act")] public ActModel? ActForm { get; set; }
    [SupplyParameterFromForm(FormName = "preserve")] public PreserveModel? PreserveForm { get; set; }
    public sealed class PreserveModel { public string? Reason { get; set; } }
    [SupplyParameterFromForm(FormName = "photo")] public PhotoModel? PhotoForm { get; set; }
    public sealed class PhotoModel { public Guid? MediaId { get; set; } public string? Purpose { get; set; } }
    private string? photoLink;

    // #41: chat photos named in this case's evidence snapshots (media ids only).
    private List<Guid> ReportedPhotos => detail?.Evidence.SelectMany(e => System.Text.RegularExpressions.Regex.Matches(e.Snapshot, "\"photo\":\"([0-9a-f-]{36})\"")
        .Select(m => Guid.Parse(m.Groups[1].Value))).Distinct().ToList() ?? [];

    private async Task PhotoAsync()
    {
        var result = await Admin.CaseMediaAsync(PhotoForm?.MediaId ?? Guid.Empty, Id, PhotoForm?.Purpose);
        photoLink = result.Value?.Link.Split('/').Last();
        Show(result.Status, result.Code, "Your view is recorded.");
        await LoadAsync();
    }
    private CaseDetailView? detail;
    private string? message, loadError, resultCode;
    private bool reauth;

    public sealed class StepModel { public string? Step { get; set; } }
    public sealed class ActModel
    {
        public string? Action { get; set; }
        public string? Reason { get; set; }
        public int? Days { get; set; }
        public bool HideFromDiscovery { get; set; }
        public bool NoNewRequests { get; set; }
        public bool NoMessages { get; set; }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Admin.CaseAsync(Id);
        detail = result.Value;
        if (!result.Ok) loadError = AdminText.Refusal(result.Status, result.Code);
        shownAtReport = result.Ok ? (await Admin.ProfileAtReportAsync(Id)).Value : null;
    }

    private ProfileAtReport? shownAtReport;

    private async Task StepAsync()
    {
        var result = await Admin.CaseStepAsync(Id, StepForm?.Step ?? "");
        Show(result.Status, result.Code, "Done.");
        await LoadAsync();
    }

    private async Task ActAsync()
    {
        var f = ActForm ?? new();
        var result = await Admin.ActAsync(Id, new ModerationActionRequest(f.Action ?? "", f.Reason, f.Days, f.HideFromDiscovery, f.NoNewRequests, f.NoMessages));
        Show(result.Status, result.Code, "Action applied. The member has a notice.");
        await LoadAsync();
    }

    private async Task PreserveAsync()
    {
        var result = await Admin.PlaceHoldAsync(new NewLegalHold(PreserveForm?.Reason, [detail?.Case.SubjectAccountId ?? Guid.Empty], null, null, null, null, null, Id));
        (resultCode, reauth) = (result.Ok ? "ok" : result.Code ?? result.Status.ToString(), result.Status == 401);
        message = result.Ok ? $"Provisional hold placed; {result.Value!.Items} item(s) preserved. The security and legal officer reviews it within 30 days." : HoldText.Refusal(result.Status, result.Code);
        await LoadAsync();
    }

    private void Show(int status, string? code, string ok)
    {
        (resultCode, reauth) = (status is >= 200 and < 300 ? "ok" : code ?? status.ToString(), status == 401 || code == "stale-session");
        message = status is >= 200 and < 300 ? ok : AdminText.Refusal(status, code);
    }
}
