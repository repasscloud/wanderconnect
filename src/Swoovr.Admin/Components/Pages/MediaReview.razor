@page "/media"
@inject AdminClient Admin
@inject NavigationManager Navigation
<PageTitle>Photo review — Swoovr admin</PageTitle>
<h1>Photo review</h1>
<p class="help">Routine photo review for Support and Admin. Specialist evidence uses its restricted workflow.</p>
@if(message is not null){<p class="notice" role="status" data-result="@resultCode">@message</p>}
<nav class="row"><a href="/media/history">Decision history</a><a href="/media/appeals">Photo appeals</a><a href="/media/history?decision=reject">Rejected photos</a></nav>
@if(queue is null){<p data-media-queue="refused">@loadError</p>}
else
{
    <section class="notice photo-safety" aria-labelledby="photo-safety-heading">
        <h2 id="photo-safety-heading">Before reviewing images</h2><p>@queue.SafetyNotice</p>
        @if(queue.AcknowledgedUntil is null)
        {
            <form method="post" @formname="photo-safety-ack" @onsubmit="AcknowledgeAsync" data-enhance="true"><AntiforgeryToken />
                <label><input type="checkbox" name="confirmed" required /> I understand and will follow this safety procedure.</label>
                <button type="submit">Acknowledge for four hours</button>
            </form>
        }
        else { <p class="help">Acknowledged until @queue.AcknowledgedUntil?.ToUniversalTime().ToString("HH:mm") UTC.</p> }
    </section>
    <p class="help" data-media-pending="@queue.Pending">Manual review: @queue.Total · Pending screening: @queue.Pending (@queue.PendingOverAnHour over an hour)</p>
    <form method="get" class="row"><label>Photo type<select name="kind"><option value="">All</option><option value="profile" selected="@(Kind=="profile")">Profile</option><option value="attachment" selected="@(Kind=="attachment")">Chat attachment</option></select></label><label>Screening reason<input name="reason" value="@Reason" maxlength="64" /></label><button type="submit" class="secondary">Filter</button></form>
    @if(queue.Items.Count==0){<p data-media-queue="none">No photos waiting for review.</p>}
    else
    {
        <div class="table-wrap"><table data-media-queue="@queue.Items.Count"><thead><tr><th scope="col">Photo</th><th scope="col">Type</th><th scope="col">Uploaded</th><th scope="col">Screening</th><th scope="col">Action</th></tr></thead><tbody>
        @foreach(var item in queue.Items)
        {
            <tr data-media-item="@item.Id"><td>@item.Reason</td><td>@(item.Purpose=="attachment"?"Chat":"Profile")</td><td>@item.CreatedAt.ToUniversalTime().ToString("d MMM HH:mm") UTC</td><td>@item.Screener · @(item.KnownContentChecked?"Known-content checked":"Known-content not run")</td><td><a class="button secondary" href="@QueueUrl(Page,item.Id)" data-review-open="@item.Id">Review</a></td></tr>
        }
        </tbody></table></div>
        <nav class="row" aria-label="Photo review pages">@if(Page>1){<a href="@QueueUrl(Page-1)">Previous</a>}<span>Page @queue.Page · @queue.Total photos</span>@if(Page*queue.PageSize<queue.Total){<a href="@QueueUrl(Page+1)">Next</a>}</nav>
    }
    @if(queue.Items.FirstOrDefault(i=>i.Id==Focus) is{}selected)
    {
        <dialog open class="photo-review-dialog" data-photo-dialog aria-labelledby="focused-photo-heading">
            <div class="row"><h2 id="focused-photo-heading">Review photo</h2><a href="@QueueUrl(Page)" data-photo-close>Close review</a></div>
            <p class="help">@selected.Reason · <a href="/accounts/@selected.AccountId">Account</a></p>
            @if(queue.AcknowledgedUntil is null){<p role="status">Acknowledge the safety notice before revealing or deciding this photo.</p>}
            else
            {
                @if(revealed&&link is not null){<div class="media-review is-revealed"><img src="/media/@link" alt="Photo under review" data-media-image="@selected.Id" /></div>}
                else {<div class="photo-concealed" role="status">Photo concealed.</div>}
                <form method="post" @formname="@($"toggle-{selected.Id}")" @onsubmit="()=>ToggleAsync(selected.Id)" data-enhance="true"><AntiforgeryToken /><input type="hidden" name="conceal" value="@(revealed?"true":"false")" /><button type="submit" class="secondary" data-reveal="@selected.Id">@(revealed?"Conceal photo":"Reveal photo")</button></form>
                <form method="post" @formname="@($"decide-{selected.Id}")" @onsubmit="()=>DecideAsync(selected.Id)" class="stack" data-enhance="true">
                    <AntiforgeryToken />
                    <label>Decision and reason<select name="reasonCode" required data-photo-decision><option value="">Choose a decision</option>@foreach(var reason in queue.Reasons?.Where(r=>r.Selectable)??[]){<option value="@reason.Code" selected="@(Field("reasonCode")==reason.Code)">@(reason.Decision=="approve"?"Approve":reason.Decision=="reject"?"Reject":"Escalate") — @reason.Label</option>}</select></label>
                    <label>Rejection or escalation notes (required for Other; never enter approval notes)<textarea name="reason" maxlength="500">@Field("reason")</textarea></label>
                    <button type="submit" data-photo-decide>Save decision and continue</button>
                </form>
            }
        </dialog>
    }
}
@code {
    [CascadingParameter] private HttpContext? Context { get; set; }
    [SupplyParameterFromQuery(Name="page")] public int Page { get; set; }=1;
    [SupplyParameterFromQuery(Name="kind")] public string? Kind { get; set; }
    [SupplyParameterFromQuery(Name="reason")] public string? Reason { get; set; }
    [SupplyParameterFromQuery(Name="review")] public Guid? Focus { get; set; }
    private MediaReviewQueue? queue;
    private string? message,loadError,resultCode,link;
    private bool revealed;
    protected override async Task OnInitializedAsync(){if(Page<1)Page=1;await LoadAsync();}
    private string QueueUrl(int page,Guid? focus=null)=>$"/media?page={page}"+(Kind is null?"":"&kind="+Uri.EscapeDataString(Kind))+(Reason is null?"":"&reason="+Uri.EscapeDataString(Reason))+(focus is null?"":"&review="+focus);
    private async Task LoadAsync(){var result=await Admin.MediaReviewPageAsync(Page,Kind,Reason);queue=result.Value;if(!result.Ok)loadError=AdminText.Refusal(result.Status,result.Code);}
    private string Field(string name)=>Context?.Request.HasFormContentType==true?Context.Request.Form[name].ToString():"";
    private async Task AcknowledgeAsync(){var status=await Admin.AcknowledgePhotoSafetyAsync(queue?.NoticeVersion??"",Field("confirmed")=="on");message=status<300?"Safety notice acknowledged.":"Confirm the current safety notice.";await LoadAsync();}
    private async Task ToggleAsync(Guid id)
    {
        // SSR posts have no retained component state: an explicit posted conceal flag is read, never inferred from session.
        if(Field("conceal")=="true"){link=null;revealed=false;message="Photo concealed.";await LoadAsync();return;}
        var result=await Admin.ViewMediaAsync(id,"Routine photo review reveal");
        if(result.Ok){link=result.Value!.Link.Split('/').Last();revealed=true;resultCode="ok";message="Photo revealed.";}
        else{link=null;revealed=false;message=AdminText.Refusal(result.Status,result.Code);}
        await LoadAsync();
    }
    private async Task DecideAsync(Guid id)
    {
        var reason=queue?.Reasons?.SingleOrDefault(r=>r.Selectable&&r.Code==Field("reasonCode"));
        if(reason is null){message="Choose a decision and reason.";return;}
        var notes=Field("reason");
        if(reason.RequiresNotes&&string.IsNullOrWhiteSpace(notes)){resultCode="reason-required";message="Other rejection requires notes.";return;}
        if(reason.Decision=="approve"&&!string.IsNullOrWhiteSpace(notes)){message="Approval uses a code only. Remove the notes.";return;}
        var result=await Admin.DecideMediaAsync(id,new MediaDecision(reason.Decision,reason.Decision=="approve"?null:notes,reason.Code));
        link=null;revealed=false;resultCode=result.Ok?"ok":result.Code;
        if(result.Ok){var next=queue?.Items.FirstOrDefault(i=>i.Id!=id);Navigation.NavigateTo(QueueUrl(Page,next?.Id));}
        else{message=AdminText.Refusal(result.Status,result.Code);await LoadAsync();}
    }
}
