@page "/code-reports"
@inject AdminClient Admin
<PageTitle>Annual report data — Swoovr admin</PageTitle>
<header class="ui-page-head ui-page-head-actions">
    <div><h1>Annual report data</h1><p>Aggregates for the year to 30 June. Publication benchmark 31 August.</p></div>
    @if (report is not null) {<div class="acct-buttons"><a class="ui-button-ghost" href="/code-reports/@EndingYear/export" data-code-report-export>Download JSON</a></div>}
</header>
<div class="ui-toolbar">
    <nav class="ui-segmented" aria-label="Financial year">
        @foreach (var y in new[] { DefaultYear, DefaultYear - 1, DefaultYear - 2 }) { <a href="/code-reports?year=@y" aria-current="@(y == EndingYear ? "page" : null)">FY @(y - 1)–@(y % 100)</a> }
    </nav>
    <div class="acct-badges"><span class="ui-pill" data-tone="escalate">Draft · not publication</span>@if (report is not null) {<span class="ui-pill" data-tone="quiet">Coverage: @report.DataQuality.CoverageStatus</span>}</div>
</div>
@if(message is not null){<p class="notice" role="status" data-code-report-result>@message</p>}
@if(report is null){<div class="ui-empty"><strong>Aggregates unavailable</strong>Not available for this year or role.</div>}
else
{
    var counted = report.Counts.Where(c => c.Count is not null).ToList();
    <div class="ui-stats ui-stats-4">
        @foreach (var group in counted.GroupBy(c => c.Metric).Take(4))
        {
            <div class="ui-stat"><strong>@group.Sum(c => c.Count ?? 0)</strong><span>@group.Key</span></div>
        }
    </div>
    <p class="ui-help" data-code-report-scope>@report.Header.Scope · @report.Header.FromInclusive.ToString("d MMM yyyy") – @report.Header.UntilExclusive.AddDays(-1).ToString("d MMM yyyy") (@report.Header.TimeZone)</p>
    <div class="acct-grid">
        <section>
            <div class="ui-results-head"><h2 class="ui-h2">Recorded counts</h2><p>Not recorded is not zero</p></div>
            <div class="table-scroll ui-table" tabindex="0" role="region" aria-label="Recorded counts">
            <table data-code-report-cells><thead><tr><th scope="col">Metric</th><th scope="col">Category</th><th scope="col" class="ui-right">Count</th></tr></thead><tbody>
                @foreach(var cell in report.Counts){<tr><td>@cell.Metric</td><td>@cell.Category</td><td class="ui-right">@if (cell.Count is { } n) {<strong>@n</strong>} else {<span class="ui-pill" data-tone="quiet">@cell.Status</span>}</td></tr>}
            </tbody></table></div>
        </section>
        <section>
            <div class="ui-results-head"><h2 class="ui-h2">Automation and operations</h2></div>
            <div class="ui-card"><dl class="media-meta"><dt>Training</dt><dd>@report.TrainingStatus</dd><dt>Own initiative</dt><dd>@report.OwnInitiativeCoverage</dd></dl></div>
            @if (report.Automation.Count > 0)
            {
                <div class="table-scroll ui-table" tabindex="0" role="region" aria-label="Automation"><table><thead><tr><th scope="col">Automation</th><th scope="col">Human review</th><th scope="col">Accuracy</th><th scope="col">Errors</th></tr></thead><tbody>
                @foreach(var automation in report.Automation){<tr><td><strong>@automation.Definition</strong><span class="ui-sub">@automation.Purpose</span></td><td>@automation.HumanReview</td><td><span class="ui-pill" data-tone="quiet">@automation.AccuracyStatus</span></td><td>@automation.ErrorStatus</td></tr>}
                </tbody></table></div>
            }
            @if (report.DataQuality.Limitations.Count > 0)
            {
                <details class="ui-card ui-disclosure ui-section"><summary><strong>Limits</strong></summary><ul class="ui-limits">@foreach(var limit in report.DataQuality.Limitations){<li>@limit</li>}</ul></details>
            }
            <section class="ui-card ui-section">
                <h2 class="ui-card-title">Save internal revision</h2>
                <form method="post" @formname="save-code-report" @onsubmit="SaveAsync" class="ui-form" data-code-report-save data-enhance="true"><AntiforgeryToken />
                    <input type="hidden" name="SaveForm.Year" value="@EndingYear" />
                    <label class="beta-check"><input type="checkbox" name="SaveForm.Confirmed" value="true" required /><span>Save with its coverage gaps (not published)</span></label>
                    <div><button type="submit">Save revision</button></div>
                </form>
            </section>
        </section>
    </div>
}
@code {
    [SupplyParameterFromQuery(Name="year")]public int? Year{get;set;}
    [SupplyParameterFromForm(FormName="save-code-report")]public SaveModel? SaveForm{get;set;}
    public sealed class SaveModel{public int Year{get;set;}public bool Confirmed{get;set;}}
    private static int DefaultYear=>DateTime.UtcNow.Month>=7?DateTime.UtcNow.Year:DateTime.UtcNow.Year-1;
    private int EndingYear=>Year??DefaultYear;
    private ModerationTransparencyExport? report;private string? message;
    protected override async Task OnInitializedAsync(){await LoadAsync();}
    private async Task LoadAsync(){report=(await Admin.ModerationReportAsync(EndingYear)).Value;}
    private async Task SaveAsync()
    {
        if(SaveForm is not{Confirmed:true}form){message="Review the coverage gaps and confirm before saving.";return;}
        Year=form.Year;var result=await Admin.SaveModerationReportAsync(form.Year);
        message=result.Ok?$"Internal revision {result.Value} saved; nothing was published.":"Revision unavailable. Check year, retained source window, role and fresh sign-in.";await LoadAsync();
    }
}
