@page "/holds/{Id:guid}"
@inject AdminClient Admin
<PageTitle>Legal hold — Swoovr admin</PageTitle>
<p class="breadcrumb"><a href="/holds">Legal holds</a> / Hold</p>
@if (message is not null) { <p class="notice" role="status" data-result="@resultCode">@message</p> }
@if (link is not null) { <p class="notice" data-export-link><a href="/holds/exports/@link.Token" download>Download the evidence package</a> (works once, until @link.ExpiresAt.ToLocalTime().ToString("HH:mm")).</p> }
@if (detail is null) { <p data-hold-detail="missing">@(loadError ?? "Not found, or not available to your role.")</p> }
else
{
    var h = detail;
    <h1 data-hold-detail="@h.Id">@(h.Status == "provisional" ? "Provisional hold" : h.Status == "released" ? "Released hold" : "Legal hold")</h1>
    <dl class="facts">
        <div><dt>Status</dt><dd data-hold-status="@h.Status">@h.Status</dd></div>
        <div><dt>Source</dt><dd>@(h.Source == "serious-incident" ? "Serious incident report (opened by Swoovr)" : $"Placed by {h.PlacedByRole}")</dd></div>
        <div><dt>Placed</dt><dd>@h.PlacedAt.ToString("d MMM yyyy HH:mm")</dd></div>
        <div><dt>Review due</dt><dd data-review-due>@h.ReviewDue.ToString("d MMM yyyy") @if (h.Overdue) { <strong data-overdue>overdue</strong> }</dd></div>
        <div><dt>Period</dt><dd>@(h.From?.ToString("d MMM yyyy") ?? "from the start") – @(h.Until?.ToString("d MMM yyyy") ?? "until released")</dd></div>
        @if (h.CaseId is { } caseId) { <div><dt>Case</dt><dd>@caseId</dd></div> }
        @if (h.LeCaseId is { } leCase) { <div><dt>Law-enforcement case</dt><dd><a href="/law-enforcement/@leCase" data-hold-le-case="@leCase">Open case</a> · @h.RequestingBody</dd></div> }
        @if (h.Kind is not null) { <div><dt>Kind</dt><dd data-hold-kind="@h.Kind">Temporary police preservation (review within 30 days; review is not release)</dd></div> }
        @if (h.LawfulBasis is not null) { <div><dt>Lawful basis</dt><dd>@h.LawfulBasis</dd></div> }
        <div><dt>Overlapping holds</dt><dd data-overlaps="@h.Overlaps">@h.Overlaps</dd></div>
        <div><dt>Custody log</dt><dd data-chain="@(h.ChainIntact ? "intact" : "broken")">@(h.ChainIntact ? "intact" : "BROKEN: report this as a security incident")</dd></div>
    </dl>
    <h2>Reason</h2><blockquote>@h.Reason</blockquote>
    @if (h.ReleaseConditions is not null) { <h2>Release conditions</h2><blockquote>@h.ReleaseConditions</blockquote> }
    @if (h.ReleaseReason is not null) { <h2>Released</h2><blockquote data-release-reason>@h.ReleaseReason</blockquote> }
    <section class="card" data-retention-state="@h.RetentionReason">
        <h2>Evidence retention</h2>
        <p>@RetentionLabel(h.RetentionReason)</p>
        @if (h.RetainUntil is { } until) { <p>Schedule date: @until.ToString("d MMM yyyy HH:mm 'UTC'"). Active preservation obligations take precedence.</p> }
        <p class="help">Releasing a hold ends its preservation authority. Required review or police evidence stays in restricted storage until its applicable disposition. Unresolved provenance is kept for legal review.</p>
    </section>
    <h2>Scope</h2>
    <ul class="list" data-scope-accounts="@h.AccountIds.Count">@foreach (var a in h.AccountIds) { <li>Account <code>@a</code></li> }</ul>
    @if (h.ConversationIds.Count > 0) { <ul class="list" data-scope-conversations="@h.ConversationIds.Count">@foreach (var c in h.ConversationIds) { <li>Conversation <code>@c</code></li> }</ul> }

    @if (h.Status != "released")
    {
        <h2>Manage</h2>
        <form method="post" @formname="step" @onsubmit="StepAsync" class="row" data-enhance="false">
            <AntiforgeryToken />
            @if (h.Status == "provisional") { <button name="step" value="confirm" type="submit" data-step="confirm">Confirm hold</button> }
            <button name="step" value="capture" type="submit" class="secondary" data-step="capture">Capture again</button>
        </form>
        <form method="post" @formname="review" @onsubmit="ReviewAsync" class="row" data-enhance="false">
            <AntiforgeryToken />
            <label>Next review<input name="due" type="date" required /></label>
            <button type="submit" class="secondary" data-review>Record review</button>
        </form>
    }
    @if (h.Status != "released" || h.Items.Count > 0)
    {
        <h2>Export evidence</h2>
        <form method="post" @formname="export" @onsubmit="ExportAsync" class="stack" data-export-form data-enhance="false">
            <AntiforgeryToken />
            <label>Purpose (required)<textarea name="purpose" maxlength="1000" rows="2" required></textarea></label>
            <fieldset><legend>Law-enforcement disclosure (fill all to record it in the register)</legend>
                <label>Agency<input name="agency" maxlength="200" /></label>
                <label>Officer<input name="officer" maxlength="200" /></label>
                <label>Reference<input name="reference" maxlength="200" /></label>
                <label>Legal basis
                    <select name="basis">
                        <option value="">(not a disclosure)</option>
                        <option value="app-6.2e">APP 6.2(e) enforcement-related activity</option>
                        <option value="warrant">Warrant</option>
                        <option value="subpoena">Subpoena</option>
                        <option value="court-order">Court order</option>
                        <option value="serious-threat">Serious threat to life, health or safety</option>
                        <option value="consent">Consent of the individual</option>
                    </select></label>
                <label>How the request was verified<input name="verified" maxlength="200" /></label>
            </fieldset>
            <fieldset><legend>Correction or redaction (optional; the preserved original never changes)</legend>
                <label>Corrects export id<input name="supplements" /></label>
                <label>Why (correction reason)<input name="correction" maxlength="1000" /></label>
                <label>Redact item id<input name="redactItem" /></label>
                <label>Fields (dotted paths, comma-separated, e.g. message.body)<input name="redactFields" maxlength="500" /></label>
                <label>Redaction reason<input name="redactReason" maxlength="1000" /></label>
            </fieldset>
            <button type="submit" data-export>Create one-time export link</button>
        </form>
    }
    @if (h.Status != "released")
    {
        <h2>Release</h2>
        <form method="post" @formname="release" @onsubmit="ReleaseAsync" class="row" data-enhance="false">
            <AntiforgeryToken />
            <input name="reason" placeholder="Why the preservation need has ended" maxlength="1000" required />
            @if (h.Overlaps > 0) { <label><input type="checkbox" name="overlaps" value="true" /> I checked the @h.Overlaps other live hold(s) on these accounts</label> }
            <button type="submit" class="secondary" data-release>Release preservation hold</button>
            <span class="help">Only an officer who neither placed nor confirmed this hold can release it.</span>
        </form>
    }
    @if (h.MayConfirmNoReview)
    {
        <h2>Independent retention disposition</h2>
        <p class="help">Only for copies with positively established provenance and no qualifying review, police or overlapping preservation obligation. An officer who placed or confirmed the hold cannot make this disposition. Record the basis without copying private content.</p>
        <form method="post" @formname="retention-disposition" @onsubmit="DispositionAsync" class="stack" data-retention-disposition data-enhance="false">
            <AntiforgeryToken />
            <label>Disposition basis<textarea name="retentionReason" minlength="20" maxlength="1000" rows="3" required></textarea></label>
            <label><input type="checkbox" name="retentionConfirmed" value="true" required /> I reviewed the provenance and confirmed there is no qualifying review, police or other retention obligation.</label>
            <button type="submit" class="secondary">Record disposition</button>
        </form>
    }
    @if (preservedPhoto is not null)
    {
        <div class="media-review" data-preserved-photo>
            <input type="checkbox" id="reveal-preserved-photo" class="media-reveal" />
            <label for="reveal-preserved-photo" class="secondary">Reveal preserved photo</label>
            <img src="/media/@preservedPhoto" alt="Preserved photo for authorised review" width="320" />
        </div>
    }
    <h2>Preserved items (@h.Items.Count)</h2>
    <p class="help">Content leaves only in an export. Each item's SHA-256 is of its content as preserved.</p>
    <table data-items="@h.Items.Count"><thead><tr><th>Capture</th><th>Kind</th><th>Source</th><th>Captured</th><th>SHA-256</th></tr></thead><tbody>
        @foreach (var i in h.Items) { <tr><td>@i.Capture</td><td>@i.Kind</td><td>@i.Source/@i.RecordId</td><td>@i.CapturedAt.ToString("d MMM HH:mm")</td><td><code>@i.Sha256[..16]…</code></td></tr> }
    </tbody></table>
    @foreach (var item in h.Items.Where(i => i.Kind == "media-item" && Guid.TryParse(i.RecordId, out _)).GroupBy(i => i.RecordId).Select(g => g.First()))
    {
        <form method="post" @formname="@($"preserved-photo-{item.Id}")" @onsubmit="() => PreservedPhotoAsync(Guid.Parse(item.RecordId))" class="row" data-preserved-photo-form data-enhance="false">
            <AntiforgeryToken />
            <label>Purpose for photo @item.RecordId<input name="photoPurpose" maxlength="500" required /></label>
            <button type="submit" class="secondary">Request photo link</button>
            <span class="help">Requires elevated evidence access. Blocked or unchecked material is never viewable.</span>
        </form>
    }

    @if (h.Exports is { Count: > 0 } exports)
    {
        <h2>Exports (@exports.Count)</h2>
        <ul class="list" data-exports="@exports.Count">@foreach (var e in exports) { <li data-export-id="@e.Id"><code>@e.Id</code> · @e.CreatedAt.ToLocalTime().ToString("d MMM HH:mm") · @(e.DownloadedAt is null ? "not downloaded" : $"package {e.PackageSha256?[..16]}…") @if (e.SupplementsExportId is { } s) { <span> · corrects <code>@s</code></span> } @if (e.Redactions > 0) { <span> · @e.Redactions redaction(s)</span> }</li> }</ul>
    }
    <h2>Disclosures (@h.Disclosures.Count)</h2>
    <ul class="list" data-disclosures="@h.Disclosures.Count">@foreach (var d in h.Disclosures) { <li>@d.Agency · @d.Officer · @d.Reference · @d.LegalBasis · @d.DisclosedAt.ToString("d MMM yyyy HH:mm")</li> }</ul>
    <h2>Chain of custody</h2>
    <ol class="list" data-custody="@h.Custody.Count">@foreach (var c in h.Custody) { <li data-custody-action="@c.Action">@c.At.ToString("d MMM HH:mm:ss") · @c.Action @(c.Detail is null ? "" : $"({c.Detail})") · <code>@c.Hash[..12]</code></li> }</ol>
}
@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private HttpContext? Context { get; set; }
    private LegalHoldDetail? detail;
    private EvidenceExportLink? link;
    private string? message, loadError, resultCode;

    // Loaded on every request, POST included: static rendering dispatches a submit only to a form it renders.
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Admin.HoldAsync(Id);
        detail = result.Value;
        if (!result.Ok) loadError = HoldText.Refusal(result.Status, result.Code);
    }

    private string Field(string name) => Context?.Request.HasFormContentType == true ? Context.Request.Form[name].ToString() : "";

    private async Task Show(ApiResult<LegalHoldDetail> result, string ok)
    {
        resultCode = result.Ok ? "ok" : result.Code ?? result.Status.ToString();
        message = result.Ok ? ok : HoldText.Refusal(result.Status, result.Code);
        if (result.Ok) detail = result.Value; else await LoadAsync();
    }

    private async Task StepAsync() => await Show(await Admin.HoldStepAsync(Id, Field("step")), Field("step") == "confirm" ? "Hold confirmed." : "Captured again.");

    private async Task ReviewAsync() => await Show(await Admin.ReviewHoldAsync(Id, Holds.Date(Field("due"))), "Review recorded.");

    private async Task ReleaseAsync() => await Show(await Admin.ReleaseHoldAsync(Id, Field("reason"), Field("overlaps") == "true"), "Hold released. Evidence disposal follows its applicable retention schedule.");

    private string? preservedPhoto;
    private async Task DispositionAsync() => await Show(await Admin.RetentionDispositionAsync(Id, Field("retentionReason"), Field("retentionConfirmed") == "true"), "Independent disposition recorded; any remaining preservation obligations still apply.");
    private async Task PreservedPhotoAsync(Guid media)
    {
        var result = await Admin.PreservedPhotoAsync(Id, media, Field("photoPurpose"));
        preservedPhoto = result.Value?.Link.Split('/').Last();
        resultCode = result.Ok ? "ok" : result.Code ?? result.Status.ToString();
        message = result.Ok ? "Photo link recorded for authorised review. Reveal only when ready." : HoldText.Refusal(result.Status, result.Code);
        await LoadAsync();
    }
    private static string RetentionLabel(string? reason) => reason switch
    {
        "disposed" => "Retained evidence copies have been disposed; the restricted operational record remains.",
        "live-hold" => "Preservation is active.",
        "review-open" => "The qualifying review remains open.",
        "review-schedule" => "The qualifying review schedule applies.",
        "police-schedule" => "The police-case schedule applies.",
        "legal-no-review-disposition" => "An independent no-review disposition is recorded.",
        "retention-review-required" => "An independent legal retention disposition is required.",
        _ => "The retention basis needs restricted legal or operator review.",
    };

    private async Task ExportAsync()
    {
        var disclosure = Field("basis") is { Length: > 0 } basis ? new DisclosureRequest(Field("agency"), Field("officer"), Field("reference"), basis, Field("verified")) : null;
        Guid? supplements = Guid.TryParse(Field("supplements"), out var s) ? s : null;
        List<RedactionRequest>? redactions = Guid.TryParse(Field("redactItem"), out var item)
            ? [new RedactionRequest(item, Field("redactFields").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(), Field("redactReason"))] : null;
        var result = await Admin.CreateExportAsync(Id, new EvidenceExportRequest(Field("purpose"), disclosure, detail?.LeCaseId, supplements,
            string.IsNullOrWhiteSpace(Field("correction")) ? null : Field("correction"), redactions));
        (link, resultCode) = (result.Value, result.Ok ? "ok" : result.Code ?? result.Status.ToString());
        message = result.Ok ? (disclosure is null ? "Export link created." : "Disclosure recorded and export link created.") : HoldText.Refusal(result.Status, result.Code);
        await LoadAsync();
    }
}
