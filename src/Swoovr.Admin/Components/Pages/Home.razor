@page "/"
@inject AdminClient Admin
<PageTitle>Swoovr admin</PageTitle>
<h1>Overview</h1>
@if (businessOnly)
{
    <p data-business-home>You’re signed in to your staff workspace.</p>
}
else
{
<p class="page-description">Your queues and reviews at a glance.</p>
@if (holds is not null)
{
    <ul class="tiles" data-holds-overview>
        <li><a href="/holds"><strong data-live-holds>@holds.Live</strong> legal holds</a></li>
        <li><a href="/holds"><strong data-overdue-holds>@holds.Overdue</strong> holds overdue for review</a></li>
    </ul>
}
@if (legalOnly) { <p data-legal-home>You're signed in as the security and legal officer. <a href="/law-enforcement">Law-enforcement cases</a>, <a href="/holds">legal holds</a> or the <a href="/disclosures">disclosure register</a>.</p> }
@if (le is { Open: > 0 } || le is { RetrospectivesDue: > 0 })
{
    <ul class="tiles" data-le-home>
        <li><a href="/law-enforcement"><strong>@le.Open</strong> open law-enforcement cases</a></li>
        <li><a href="/law-enforcement"><strong>@le.Overdue</strong> overdue responses or updates</a></li>
    </ul>
}
else if (refused is not null)
{
    <p class="notice notice-action" role="alert" data-refused="@status"><span>@refused</span><a href="/sign-in?reauth=true" class="ui-button-primary notice-button" data-enhance-nav="false">Sign in again</a></p>
}
else
{
    <ul class="tiles" data-dashboard>
        <li><a href="/cases"><strong data-open-cases>@open</strong> open cases</a></li>
        <li><a href="/cases"><strong data-urgent>@urgent</strong> urgent awaiting acknowledgement</a></li>
        <li><a href="/appeals"><strong data-pending-appeals>@appeals</strong> appeals waiting</a></li>
    </ul>

}
@* Issue 223 (D332): support requests that aren't closed, by status, in this person's queues; each opens the filtered queue. *@
@if (tickets is { States.Count: > 0 } support)
{
    <ul class="tiles" data-ticket-overview>
        @foreach (var s in support.States)
        {
            <li><a href="@($"/tickets?state={s.StateId}")" data-ticket-overview-state="@s.Name"><strong>@s.Count@(support.More && s.Count > 0 ? "+" : "")</strong> @SupportTicketText.State(s.Name).ToLowerInvariant() support requests</a></li>
        }
    </ul>
    @if (support.More) { <p class="help" data-ticket-overview-more>Counts the 100 most recently updated open requests. Open the queue to see them all.</p> }
}
@if(photoWorkload is{}photos)
{
    <ul class="tiles" data-photo-workload><li><a href="/media"><strong>@photos.ManualReview</strong> awaiting media review</a></li><li><a href="/media"><strong>@photos.PendingScreening</strong> waiting for screening</a></li><li><a href="/media/appeals"><strong>@photos.Appeals</strong> media appeals @if(photos.AwaitingOtherAdmin>0){<span class="tile-note" data-awaiting-other-admin="@photos.AwaitingOtherAdmin">@MediaText.AwaitingOtherAdmin(photos.AwaitingOtherAdmin)</span>}</a></li></ul>
}
}
@code {
    private bool businessOnly;
    private int open, urgent, appeals, status;
    private string? refused;
    private HoldOverview? holds;
    private PhotoWorkload? photoWorkload;
    private bool legalOnly;
    private LeOverview? le;
    private TicketOverview? tickets;

    protected override async Task OnInitializedAsync()
    {
        var workspace = (await Admin.WorkspaceAsync()).Value;
        businessOnly = workspace is { Business: true, MemberOperations: false, Legal: false, Administration: false };
        if (businessOnly) return;
        // Issue 223: refused (no ticket role, or the helpdesk unavailable) simply doesn't show.
        // A slow helpdesk never blocks the rest of the overview.
        try { tickets = (await Admin.TicketOverviewAsync()).Value; }
        catch (TaskCanceledException) { tickets = null; }
        catch (HttpRequestException) { tickets = null; }
        // D195: the officer's case timers (refused for everyone else, so it simply doesn't show).
        photoWorkload=(await Admin.PhotoWorkloadAsync()).Value;
        le = (await Admin.LeOverviewAsync()).Value;
        // D189: overdue hold reviews head the page for admins and the security and legal officer.
        var overview = await Admin.HoldOverviewAsync();
        holds = overview.Value is { Live: > 0 } ? overview.Value : null;
        var cases = await Admin.CasesAsync();
        // The security and legal officer has no moderation queue; holds are their page.
        if (!cases.Ok && cases.Status == 403 && overview.Ok) { legalOnly = true; return; }
        if (!cases.Ok) { (status, refused) = (cases.Status, AdminText.Refusal(cases.Status, cases.Code)); return; }
        (open, urgent) = (cases.Value!.Count, cases.Value.Count(c => c.AwaitingAcknowledgement));
        appeals = (await Admin.AppealsAsync()).Value?.Count ?? 0;
    }
}
