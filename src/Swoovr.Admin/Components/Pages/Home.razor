@page "/"
@inject AdminClient Admin
<PageTitle>Swoovr admin</PageTitle>
<h1>Moderation</h1>
@if (holds is not null)
{
    <ul class="tiles" data-holds-overview>
        <li><a href="/holds"><strong data-live-holds>@holds.Live</strong> legal holds</a></li>
        <li><a href="/holds"><strong data-overdue-holds>@holds.Overdue</strong> holds overdue for review</a></li>
    </ul>
}
@if (legalOnly) { <p data-legal-home>You're signed in as the security and legal officer. <a href="/law-enforcement">Law-enforcement cases</a>, <a href="/holds">legal holds</a> or the <a href="/disclosures">disclosure register</a>.</p> }
@if (le is { Open: > 0 } || le is { RetrospectivesDue: > 0 })
{
    <ul class="tiles" data-le-home>
        <li><a href="/law-enforcement"><strong>@le.Open</strong> open law-enforcement cases</a></li>
        <li><a href="/law-enforcement"><strong>@le.Overdue</strong> overdue responses or updates</a></li>
    </ul>
}
else if (refused is not null)
{
    <p class="notice" role="alert" data-refused="@status">@refused <a href="/sign-in?reauth=true">Sign in again</a></p>
}
else
{
    <ul class="tiles" data-dashboard>
        <li><a href="/cases"><strong data-open-cases>@open</strong> open cases</a></li>
        <li><a href="/cases"><strong data-urgent>@urgent</strong> urgent awaiting acknowledgement</a></li>
        <li><a href="/appeals"><strong data-pending-appeals>@appeals</strong> appeals waiting</a></li>
    </ul>
    <p class="help">Support sees the support queue; admins also see staff-affiliated cases (D134). Every action is recorded with its reason.</p>
}
@code {
    private int open, urgent, appeals, status;
    private string? refused;
    private HoldOverview? holds;
    private bool legalOnly;
    private LeOverview? le;

    protected override async Task OnInitializedAsync()
    {
        // D195: the officer's case timers (refused for everyone else, so it simply doesn't show).
        le = (await Admin.LeOverviewAsync()).Value;
        // D189: overdue hold reviews head the page for admins and the security and legal officer.
        var overview = await Admin.HoldOverviewAsync();
        holds = overview.Value is { Live: > 0 } ? overview.Value : null;
        var cases = await Admin.CasesAsync();
        // The security and legal officer has no moderation queue; holds are their page.
        if (!cases.Ok && cases.Status == 403 && overview.Ok) { legalOnly = true; return; }
        if (!cases.Ok) { (status, refused) = (cases.Status, AdminText.Refusal(cases.Status, cases.Code)); return; }
        (open, urgent) = (cases.Value!.Count, cases.Value.Count(c => c.AwaitingAcknowledgement));
        appeals = (await Admin.AppealsAsync()).Value?.Count ?? 0;
    }
}
