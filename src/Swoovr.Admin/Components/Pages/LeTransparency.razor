@page "/law-enforcement/transparency"
@inject AdminClient Admin
<PageTitle>Transparency and audit — Swoovr admin</PageTitle>
<p class="breadcrumb"><a href="/law-enforcement">Law enforcement</a> / Transparency and audit</p>
<h1>Transparency and audit</h1>
<p class="help">Procedure §13. The annual transparency aggregate leaves out confidential cases and shows any count from 1 to 4 as "fewer than 5". The quarterly audit export lists ids, times, states, timers and integrity checks only — no agency, officer, subject, note or evidence content.</p>
<form method="get" class="row" data-enhance="false">
    <label>Year<input name="year" type="number" min="2020" max="2100" value="@Year" /></label>
    <button type="submit" class="secondary">Show</button>
</form>
@if (report is null) { <p data-transparency="refused">@loadError</p> }
else
{
    <dl class="facts" data-transparency="@report.Year">
        <div><dt>Cases</dt><dd data-t-cases>@Count(report.Cases)</dd></div>
        <div><dt>Emergencies</dt><dd>@Count(report.Emergencies)</dd></div>
        <div><dt>Legal holds placed</dt><dd>@Count(report.HoldsPlaced)</dd></div>
        <div><dt>Accounts affected</dt><dd>@Count(report.AccountsAffected)</dd></div>
    </dl>
    <h2>Request types</h2>
    <ul class="list">@foreach (var (k, v) in report.RequestKinds) { <li>@k: @Count(v)</li> }</ul>
    <h2>Outcomes</h2>
    <ul class="list">@foreach (var (k, v) in report.Outcomes) { <li>@k: @Count(v)</li> }</ul>
    <h2>Agency country</h2>
    <ul class="list">@foreach (var (k, v) in report.AgencyCountries) { <li>@k: @Count(v)</li> }</ul>
}
<h2>Quarterly audit export</h2>
<form method="get" action="/law-enforcement/audit-export" class="row" data-enhance="false">
    <label>Quarter<input name="quarter" value="@Quarter" pattern="\d{4}-Q[1-4]" /></label>
    <button type="submit" data-audit-export>Download</button>
</form>
@code {
    [SupplyParameterFromQuery] public int? Year { get; set; }
    private TransparencyReport? report;
    private string? loadError;
    private string Quarter => $"{DateTime.UtcNow.Year}-Q{(DateTime.UtcNow.Month - 1) / 3 + 1}";

    protected override async Task OnInitializedAsync()
    {
        Year ??= DateTime.UtcNow.Year;
        var result = await Admin.TransparencyAsync(Year.Value);
        report = result.Value;
        if (!result.Ok) loadError = LeText.Refusal(result.Status, result.Code);
    }

    private static string Count(int? value) => value is { } v ? v.ToString() : "fewer than 5";
}
