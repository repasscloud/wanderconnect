@page "/registry"
@inject AdminClient Admin
<PageTitle>Identifier review — Swoovr admin</PageTitle>
<header class="ui-page-head">
    <h1>Identifier review</h1>
    <p>Restricted email addresses and mobile numbers from terminated accounts.</p>
</header>
@if (message is not null) { <p class="notice" role="status" data-result="@resultCode">@message</p> }
@if (grant is null)
{
    <div class="ui-locked" data-lookup-access="required">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        <strong>Elevated access required to search</strong>
        <span class="acct-buttons"><a class="ui-button-ghost" href="/access">Request access</a><a class="ui-button-ghost" href="/sign-in?reauth=true&amp;returnUrl=/registry" data-enhance-nav="false">Sign in again</a></span>
    </div>
}
else
{
    <div class="media-safety is-acknowledged ui-banner" data-lookup-purpose><span class="media-safety-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12l5 5 9-10"/></svg></span><span>Elevated access · <strong>@grant.Purpose</strong></span><a class="ui-button-ghost" href="/access">Manage</a></div>
}
<section class="ui-card" aria-label="Find an identifier">
    <h2 class="ui-card-title">Find an identifier</h2>
    <form method="post" @formname="lookup" @onsubmit="LookupAsync" data-registry-lookup data-enhance="true">
        <AntiforgeryToken />
        <fieldset disabled="@(grant is null)" class="ui-big-search ui-fieldset-plain">
            <label class="ui-field ui-type"><span class="sr-only">Identifier type</span><select name="type"><option value="email">Email</option><option value="mobile">Mobile number</option></select></label>
            <label class="ui-field beta-search"><span class="sr-only">Identifier from the support review</span><input name="value" type="search" maxlength="254" autocomplete="off" spellcheck="false" required placeholder="Search text…" /></label>
            <button type="submit" data-registry-search>Search</button>
        </fieldset>
    </form>
    @if (found is not null) { <section data-registry-search-results class="ui-results-block"><RegistryEntries Rows="@found" /></section> }
</section>
<nav class="ui-tabs" aria-label="Restrictions">
    <a href="/registry@(CaseId is { } c1 ? "?caseId=" + c1 : "")" aria-current="@(OnlyDue ? "page" : null)">Due for necessity review</a>
    <a href="/registry?due=false@(CaseId is { } c2 ? "&caseId=" + c2 : "")" aria-current="@(!OnlyDue ? "page" : null)">All restrictions</a>
</nav>
<form method="get" action="/registry" class="ui-inline-filter" data-enhance="false">
    <input type="hidden" name="due" value="@(OnlyDue ? "true" : "false")" />
    <label class="ui-field"><span>Case id</span><input name="caseId" value="@CaseId" placeholder="Optional" /></label>
    <button type="submit" class="ui-button-ghost">Apply</button>
    @if (CaseId is not null) { <a class="ui-button-ghost" href="/registry?due=@(OnlyDue ? "true" : "false")">Clear</a> }
</form>
@if (loadError is not null) { <p class="notice" role="status" data-registry-load="refused">@loadError</p> }
else { <RegistryEntries Rows="@rows" /> }
@if (next is {} cursor) { <nav class="ui-paging"><span></span><a class="ui-button-ghost" href="@NextLink(cursor)" data-registry-next>Next page</a></nav> }
@code {
    [CascadingParameter] private HttpContext? Context { get; set; }
    [SupplyParameterFromQuery] public Guid? CaseId { get; set; }
    [SupplyParameterFromQuery] public Guid? After { get; set; }
    [SupplyParameterFromQuery] public bool? Due { get; set; }
    private bool OnlyDue=>Due??true;
    private IReadOnlyList<BannedIdentifierView>? rows;
    private List<BannedIdentifierView>? found;
    private AccessGrantView? grant;
    private Guid? next;
    private string? message,resultCode,loadError;
    protected override async Task OnInitializedAsync()
    {
        var page=await Admin.RegistryAsync(CaseId,OnlyDue,After);rows=page.Value?.Items;next=page.Value?.NextCursor;
        if(!page.Ok)loadError=RegistryText.Refusal(page.Status,page.Code);
        grant=(await Admin.GrantsAsync()).Value?.FirstOrDefault(g=>g.Active&&g.Capability=="identifier-release");
    }
    private string Field(string name)=>Context?.Request.HasFormContentType==true?Context.Request.Form[name].ToString():"";
    private async Task LookupAsync()
    {
        if(grant is null){resultCode="elevated-access-required";message=AdminText.Refusal(403,resultCode);return;}
        var result=await Admin.RegistryLookupAsync(new IdentifierLookup(Field("type"),Field("value"),grant.Purpose));
        found=result.Value;resultCode=result.Ok?"ok":result.Code??result.Status.ToString();
        message=result.Ok?null:RegistryText.Refusal(result.Status,result.Code);
    }
    private string NextLink(Guid cursor)=>"/registry?due="+(OnlyDue?"true":"false")+"&after="+cursor+(CaseId is{}review?"&caseId="+review:"");
}
