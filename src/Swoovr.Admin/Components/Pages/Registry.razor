@page "/registry"
@inject AdminClient Admin
<PageTitle>Identifier review — Swoovr admin</PageTitle>
<h1>Identifier review</h1>
<p class="help">Restricted staff records. A match does not establish who owns an address or number now. Review the associated case and verify the circumstances before releasing a restriction. Identifier release and account reinstatement are separate actions.</p>
@if (message is not null) { <p class="notice" role="status" data-result="@resultCode">@message</p> }
<p><a href="/access">Elevated access</a> · <a href="/sign-in?reauth=true&amp;returnUrl=/registry">Sign in again</a></p>
<section class="card">
    <h2>Find an identifier</h2>
    @if (grant is null) { <p class="help" data-lookup-access="required">Ask for identifier-release access with a recorded purpose before searching.</p> }
    else { <p class="help" data-lookup-purpose>Recorded access purpose: @grant.Purpose</p> }
    <form method="post" @formname="lookup" @onsubmit="LookupAsync" class="stack" data-registry-lookup data-enhance="false">
        <AntiforgeryToken />
        <fieldset disabled="@(grant is null)">
            <label>Identifier type<select name="type"><option value="email">Email</option><option value="mobile">Mobile number</option></select></label>
            <label>Identifier from the support review<input name="value" maxlength="254" autocomplete="off" spellcheck="false" required /></label>
            <button type="submit" data-registry-search>Search</button>
        </fieldset>
    </form>
    @if (found is not null) { <section data-registry-search-results><h3>Search results</h3><RegistryEntries Rows="@found" /></section> }
</section>
<section class="card">
    <h2>Review queue</h2>
    <form method="get" action="/registry" class="row" data-enhance="false">
        <label>Show<select name="due"><option value="true" selected="@OnlyDue">Due for necessity review</option><option value="false" selected="@(!OnlyDue)">All restrictions</option></select></label>
        <label>Case id (optional)<input name="caseId" value="@CaseId" /></label>
        <button type="submit" class="secondary">Apply</button>
    </form>
    @if (loadError is not null) { <p role="status" data-registry-load="refused">@loadError</p> }
    else { <RegistryEntries Rows="@rows" /> }
    @if (next is {} cursor) { <a href="@NextLink(cursor)" data-registry-next>Next page</a> }
</section>
@code {
    [CascadingParameter] private HttpContext? Context { get; set; }
    [SupplyParameterFromQuery] public Guid? CaseId { get; set; }
    [SupplyParameterFromQuery] public Guid? After { get; set; }
    [SupplyParameterFromQuery] public bool? Due { get; set; }
    private bool OnlyDue=>Due??true;
    private IReadOnlyList<BannedIdentifierView>? rows;
    private List<BannedIdentifierView>? found;
    private AccessGrantView? grant;
    private Guid? next;
    private string? message,resultCode,loadError;
    protected override async Task OnInitializedAsync()
    {
        var page=await Admin.RegistryAsync(CaseId,OnlyDue,After);rows=page.Value?.Items;next=page.Value?.NextCursor;
        if(!page.Ok)loadError=RegistryText.Refusal(page.Status,page.Code);
        grant=(await Admin.GrantsAsync()).Value?.FirstOrDefault(g=>g.Active&&g.Capability=="identifier-release");
    }
    private string Field(string name)=>Context?.Request.HasFormContentType==true?Context.Request.Form[name].ToString():"";
    private async Task LookupAsync()
    {
        if(grant is null){resultCode="elevated-access-required";message=AdminText.Refusal(403,resultCode);return;}
        var result=await Admin.RegistryLookupAsync(new IdentifierLookup(Field("type"),Field("value"),grant.Purpose));
        found=result.Value;resultCode=result.Ok?"ok":result.Code??result.Status.ToString();
        message=result.Ok?"Search completed. Contact values are not echoed in these results.":RegistryText.Refusal(result.Status,result.Code);
    }
    private string NextLink(Guid cursor)=>"/registry?due="+(OnlyDue?"true":"false")+"&after="+cursor+(CaseId is{}review?"&caseId="+review:"");
}
