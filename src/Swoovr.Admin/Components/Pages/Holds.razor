@page "/holds"
@inject AdminClient Admin
<PageTitle>Legal holds — Swoovr admin</PageTitle>
<header class="ui-page-head ui-page-head-actions">
    <div><h1>Legal holds</h1><p>Records preserved for legal or safety reasons, whatever the member does.</p></div>
    <div class="acct-buttons"><a class="ui-button-ghost" href="/disclosures">Disclosure register</a>@if (Status != "released") {<a class="ui-button-primary" href="#place-hold">Place a hold</a>}</div>
</header>
@if (message is not null) { <p class="notice" role="status" data-result="@resultCode">@message @if (reauth) { <a href="/sign-in?reauth=true&returnUrl=/holds" data-enhance-nav="false">Sign in again</a> }</p> }
@if (holds is not null && Status != "released")
{
    <div class="ui-stats ui-stats-4">
        <div class="ui-stat"><strong>@holds.Count(h => h.Status == "live")</strong><span>Live holds</span></div>
        <div class="ui-stat @(holds.Any(h => h.Status == "provisional") ? "is-alert" : null)"><strong>@holds.Count(h => h.Status == "provisional")</strong><span>Provisional</span></div>
        <div class="ui-stat @(holds.Any(h => h.Overdue) ? "is-alert" : null)"><strong>@holds.Count(h => h.Overdue || h.ReviewDue <= DateTimeOffset.UtcNow.AddDays(7))</strong><span>Review due within 7 days</span></div>
        <div class="ui-stat"><strong>@holds.Sum(h => h.Items)</strong><span>Items preserved</span></div>
    </div>
}
<nav class="ui-tabs" aria-label="Hold status">
    <a href="/holds" data-filter="live" aria-current="@(Status != "released" ? "page" : null)">Live</a>
    <a href="/holds?status=released" data-filter="released" aria-current="@(Status == "released" ? "page" : null)">Released</a>
</nav>
@if (holds is null) { <p class="notice" data-holds="refused">@loadError</p> }
else if (holds.Count == 0) { <div class="ui-empty" data-holds="none"><strong>No holds</strong>Nothing in this view.</div> }
else
{
    <div class="table-scroll ui-table" tabindex="0" role="region" aria-label="Legal holds">
    <table data-holds="@holds.Count"><thead><tr><th scope="col">Hold</th><th scope="col">Source</th><th scope="col">Scope</th><th scope="col">Review due</th><th scope="col">Placed</th><th scope="col"><span class="sr-only">Open</span></th></tr></thead>
    <tbody>
    @foreach (var h in holds)
    {
        <tr data-hold="@h.Id" data-hold-status="@h.Status" data-row-link>
            <td><a href="/holds/@h.Id" data-row-target><span class="ui-pill" data-tone="@(h.Status == "live" ? "reject" : h.Status == "provisional" ? "escalate" : "quiet")">@(h.Status == "provisional" ? "Provisional" : h.Status == "released" ? "Released" : "Live")</span></a><span class="ui-sub"><code class="ui-mono">@h.Id.ToString()[..8]</code></span></td>
            <td>@(h.Source == "serious-incident" ? "Serious incident report" : "Placed by staff")@if (h.CaseId is { } caseId) {<span class="ui-sub"><a href="/cases/@caseId">Case @caseId.ToString()[..8]</a></span>}</td>
            <td>@h.Accounts account@(h.Accounts == 1 ? "" : "s") · @h.Items item@(h.Items == 1 ? "" : "s")</td>
            <td>@if (h.Overdue) {<strong data-overdue class="ui-pill" data-tone="reject">Overdue</strong>} else {@h.ReviewDue.ToUniversalTime().ToString("d MMM yyyy")}</td>
            <td>@h.PlacedAt.ToUniversalTime().ToString("d MMM yyyy")</td>
            <td class="ui-right"><a class="ui-button-ghost" href="/holds/@h.Id">Open</a></td>
        </tr>
    }
    </tbody></table></div>
}
@if (Status != "released")
{
    <section class="ui-card ui-section" id="place-hold" aria-labelledby="place-hold-heading">
        <h2 id="place-hold-heading">Place a hold</h2>
        <form method="post" @formname="place" @onsubmit="PlaceAsync" class="ui-form" data-place-hold data-enhance="true">
            <AntiforgeryToken />
            <fieldset class="ui-group"><legend>Scope</legend>
                <div class="ui-form-row">
                    <label class="ui-field"><span>Accounts</span><textarea name="accounts" rows="2" required placeholder="One account id per line, up to 20"></textarea></label>
                    <label class="ui-field"><span>Conversations (optional)</span><textarea name="conversations" rows="2" placeholder="Only these conversations"></textarea></label>
                </div>
                <div class="ui-form-row ui-form-row-3">
                    <label class="ui-field"><span>From</span><input name="from" type="date" /></label>
                    <label class="ui-field"><span>Until</span><input name="until" type="date" /></label>
                    <label class="ui-field"><span>Review due</span><input name="review" type="date" title="Defaults to 90 days" /></label>
                </div>
            </fieldset>
            <fieldset class="ui-group"><legend>Reason</legend>
                <label class="ui-field"><span>Reason</span><textarea name="reason" maxlength="1000" rows="3" required placeholder="Who asked or what happened"></textarea></label>
                <label class="ui-field"><span>Release conditions</span><textarea name="conditions" maxlength="1000" rows="2" placeholder="For example, matter closed"></textarea></label>
            </fieldset>
            <div><button type="submit" data-place>Place hold and preserve</button></div>
        </form>
    </section>
}
@code {
    [CascadingParameter] private HttpContext? Context { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
    private List<LegalHoldSummary>? holds;
    private string? message, loadError, resultCode;
    private bool reauth;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Admin.HoldsAsync(Status);
        holds = result.Value;
        if (!result.Ok) loadError = AdminText.Refusal(result.Status, result.Code);
    }

    private string Field(string name) => Context?.Request.HasFormContentType == true ? Context.Request.Form[name].ToString() : "";

    internal static List<Guid> Ids(string text) =>
        text.Split(['\n', '\r', ',', ' '], StringSplitOptions.RemoveEmptyEntries).Select(s => Guid.TryParse(s, out var g) ? g : Guid.Empty).ToList();

    internal static DateTimeOffset? Date(string text) => DateOnly.TryParse(text, out var d) ? new DateTimeOffset(d.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero) : null;

    private async Task PlaceAsync()
    {
        var result = await Admin.PlaceHoldAsync(new NewLegalHold(Field("reason"), Ids(Field("accounts")), Ids(Field("conversations")), Date(Field("from")),
            Date(Field("until")), Date(Field("review")), Field("conditions"), null));
        (resultCode, reauth) = (result.Ok ? "ok" : result.Code ?? result.Status.ToString(), result.Status == 401);
        message = result.Ok ? $"Hold placed · {result.Value!.Items} item(s) preserved." : HoldText.Refusal(result.Status, result.Code);
        await LoadAsync();
    }
}
