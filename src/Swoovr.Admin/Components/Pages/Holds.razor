@page "/holds"
@inject AdminClient Admin
<PageTitle>Legal holds — Swoovr admin</PageTitle>
<h1>Legal holds</h1>
<p class="help">For the security and legal officer (policy §3, §11). A hold preserves the named accounts' records (optionally only some conversations) for a period, whatever the member does: deletion still completes for everything anyone sees, but held records stay in the restricted evidence store until the hold is released. Holds never expire on their own; overdue reviews are listed first. The member is never told.</p>
<p class="row"><a href="/holds" data-filter="live">Live</a> · <a href="/holds?status=released" data-filter="released">Released</a> · <a href="/disclosures">Disclosure register</a></p>
@if (message is not null) { <p class="notice" role="status" data-result="@resultCode">@message @if (reauth) { <a href="/sign-in?reauth=true&returnUrl=/holds">Sign in again</a> }</p> }
@if (holds is null) { <p data-holds="refused">@loadError</p> }
else if (holds.Count == 0) { <p data-holds="none">No holds.</p> }
else
{
    <ul class="list" data-holds="@holds.Count">
        @foreach (var h in holds)
        {
            <li data-hold="@h.Id" data-hold-status="@h.Status">
                <a href="/holds/@h.Id">@(h.Status == "provisional" ? "Provisional hold" : h.Status == "released" ? "Released hold" : "Hold")</a>
                · @h.Accounts account(s), @h.Items preserved item(s) · @(h.Source == "serious-incident" ? "serious incident report" : "placed by staff")
                · review due @h.ReviewDue.ToString("d MMM yyyy") @if (h.Overdue) { <strong data-overdue>overdue</strong> }
            </li>
        }
    </ul>
}
@if (Status != "released")
{
    <h2>Place a hold</h2>
    <form method="post" @formname="place" @onsubmit="PlaceAsync" class="stack" data-place-hold data-enhance="false">
        <AntiforgeryToken />
        <label>Reason (who asked or what happened; up to 1,000 characters)<textarea name="reason" maxlength="1000" rows="3" required></textarea></label>
        <label>Account ids (one per line, up to 20)<textarea name="accounts" rows="2" required></textarea></label>
        <label>Conversation ids (optional; only these conversations)<textarea name="conversations" rows="2"></textarea></label>
        <div class="row">
            <label>From (optional)<input name="from" type="date" /></label>
            <label>Until (optional)<input name="until" type="date" /></label>
            <label>Review due (default 90 days)<input name="review" type="date" /></label>
        </div>
        <label>Release conditions<textarea name="conditions" maxlength="1000" rows="2"></textarea></label>
        <button type="submit" data-place>Place hold and preserve</button>
    </form>
}
@code {
    [CascadingParameter] private HttpContext? Context { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
    private List<LegalHoldSummary>? holds;
    private string? message, loadError, resultCode;
    private bool reauth;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Admin.HoldsAsync(Status);
        holds = result.Value;
        if (!result.Ok) loadError = AdminText.Refusal(result.Status, result.Code);
    }

    private string Field(string name) => Context?.Request.HasFormContentType == true ? Context.Request.Form[name].ToString() : "";

    internal static List<Guid> Ids(string text) =>
        text.Split(['\n', '\r', ',', ' '], StringSplitOptions.RemoveEmptyEntries).Select(s => Guid.TryParse(s, out var g) ? g : Guid.Empty).ToList();

    internal static DateTimeOffset? Date(string text) => DateOnly.TryParse(text, out var d) ? new DateTimeOffset(d.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero) : null;

    private async Task PlaceAsync()
    {
        var result = await Admin.PlaceHoldAsync(new NewLegalHold(Field("reason"), Ids(Field("accounts")), Ids(Field("conversations")), Date(Field("from")),
            Date(Field("until")), Date(Field("review")), Field("conditions"), null));
        (resultCode, reauth) = (result.Ok ? "ok" : result.Code ?? result.Status.ToString(), result.Status == 401);
        message = result.Ok ? $"Hold placed; {result.Value!.Items} item(s) preserved." : HoldText.Refusal(result.Status, result.Code);
        await LoadAsync();
    }
}
