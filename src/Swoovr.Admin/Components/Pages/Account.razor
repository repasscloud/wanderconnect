@page "/accounts/{Id:guid}"
@page "/accounts/{Id:guid}/{Section}"
@inject AdminClient Admin
@* issue 190 (D323): one account, nine routed sections. Every tab is its own address, so direct links, refresh and back all work
   (the old in-page #fragment links resolved against <base href="/"> and sent staff to the home page). The API authorises
   every read and action; the permissions view only decides which controls are enabled. *@
<PageTitle>@(account is null ? "Account" : Name) — Swoovr admin</PageTitle>
<p class="ui-back"><a href="/accounts">← Accounts</a></p>
@if (account is null)
{
    <h1 data-account="missing">Account</h1>
    <p class="notice" data-account="missing">@(loadError ?? "Not found.")</p>
}
else if (!Sections.Any(s => s.Key == Current))
{
    <h1 data-account="@account.Id">@Name</h1>
    <p class="notice" data-account-section="unknown">That section doesn't exist. <a href="/accounts/@Id">Open the overview</a>.</p>
}
else
{
    var state = StateOf();
    var activeSanction = account.Sanctions.FirstOrDefault(s => s.Live && s.Kind != "warning");
    <header class="acct-head" data-account-detail="@Current">
        <span class="acct-avatar" aria-hidden="true">@Initials(Name)</span>
        <div class="acct-title">
            <h1 data-account="@account.Id">@Name</h1>
            <div class="acct-badges">
                <span class="ui-pill" data-tone="@state.Tone" data-account-state="@state.Code">@state.Label</span>
                <span class="ui-pill" data-tone="@(account.IdStatus == "verified" ? "approve" : "quiet")">@AccountLabels.Id(account.IdStatus)</span>
                @if (verification is not null) {<span class="ui-pill" data-tone="@(verification.PhotoStatus == "verified" ? "approve" : "quiet")">@(verification.PhotoStatus == "verified" ? "Photo Verified" : "Photo not verified")</span>}
                <span class="ui-pill" data-tone="quiet">@AccountLabels.Plan(account.Plan)@(account.Founder ? " · founder" : "")</span>
                @if (account.Realm != "members") {<span class="ui-pill" data-tone="quiet">@AccountLabels.Realm(account.Realm)</span>}
                @if (account.Bot) {<span class="ui-pill" data-tone="quiet">Bot</span>}
                @if (account.Employee) {<span class="ui-pill" data-tone="quiet">Staff</span>}
            </div>
            <span class="beta-ref"><code>@account.Id</code><CopyButton Value="@account.Id.ToString()" /></span>
        </div>
        <div class="acct-actions">
            <a class="ui-button-ghost" href="/accounts/@account.Id/standing" data-standing-link>What the member sees</a>
            <a class="ui-button-primary" href="/accounts/@account.Id/enforcement" data-take-action>Take action</a>
        </div>
    </header>
    @if (account.Realm == "members")
    {
        <div class="ad-strip">
            <a class="ad-stat" href="/accounts/@Id/access" data-strip="account"><span>Account</span><b>@state.Label</b><small>@state.Detail</small></a>
            <a class="ad-stat" href="/accounts/@Id/verification" data-strip="verification"><span>Verification</span><b>@VerificationSummary()</b><small>@AccountLabels.Age(account.AgeStatus)</small></a>
            <a class="ad-stat" href="/accounts/@Id/membership" data-strip="membership"><span>Membership</span><b>@AccountLabels.Plan(account.Plan)</b><small>@PlanDetail()</small></a>
            <a class="ad-stat" href="/accounts/@Id/enforcement" data-strip="enforcement"><span>Enforcement</span><b>@(activeSanction is null ? "No active sanction" : AccountLabels.Sanction(activeSanction.Kind))</b><small>@account.Sanctions.Count on record · @account.OpenCases open case@(account.OpenCases == 1 ? "" : "s")</small></a>
        </div>
    }
    @if (message is not null) { <p class="notice" role="status" data-result="@resultCode">@message @if (reauth) { <a href="/sign-in?reauth=true&returnUrl=/accounts/@Id/@Current" data-enhance-nav="false">Sign in again</a> }</p> }
    <nav class="ad-tabs" aria-label="Account sections">
        @foreach (var tab in Sections.Where(s => !s.MembersOnly || account.Realm == "members"))
        {
            <a href="@Href(tab.Key)" aria-current="@(tab.Key == Current ? "page" : null)" data-section="@tab.Key">@tab.Label@if (tab.Key == "enforcement" && activeSanction is not null) {<span class="ad-count">1</span>}</a>
        }
    </nav>
    <section data-account-panel="@Current">
        @switch (Current)
        {
            case "overview": <AccountOverview Account="account" Contact="contact" Permissions="permissions" Changed="ReloadAsync" Report="Report" />; break;
            case "profiles": <AccountProfiles AccountId="Id" />; break;
            case "verification": <AccountVerification Account="account" Verification="verification" Permissions="permissions" Changed="ReloadAsync" Report="Report" />; break;
            case "media": <AccountMedia AccountId="Id" Report="Report" />; break;
            case "conversations": <AccountConversations AccountId="Id" Permissions="permissions" />; break;
            case "membership": <AccountMembership Account="account" Permissions="permissions" Changed="ReloadAsync" Report="Report" />; break;
            case "enforcement": <AccountEnforcement Account="account" Permissions="permissions" Changed="ReloadAsync" Report="Report" />; break;
            case "access": <AccountAccess Account="account" Locks="locks" Permissions="permissions" Changed="ReloadAsync" Report="Report" />; break;
            case "audit": <AccountAudit AccountId="Id" />; break;
        }
    </section>
}
@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? Section { get; set; }
    private string Current => (Section ?? "overview").ToLowerInvariant();
    private static readonly (string Key, string Label, bool MembersOnly)[] Sections =
    [
        ("overview", "Overview", false), ("profiles", "Profiles", true), ("verification", "Verification", true), ("media", "Media", true),
        ("conversations", "Conversations", true), ("membership", "Membership", true), ("enforcement", "Enforcement", true),
        ("access", "Sign-in & access", true), ("audit", "Audit", false),
    ];
    private AccountAdminSummary? account;
    private AccountPermissionsView? permissions;
    private AccountContactView? contact;
    private VerificationStateView? verification;
    private List<AccountLockView> locks = [];
    private RegisteredNamesView? registeredName;
    private string? message, loadError, resultCode;
    private bool reauth;

    // Loaded on every request, POST included: static rendering dispatches a submit only to a form it renders.
    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var result = await Admin.AccountAsync(Id);
        account = result.Value;
        if (!result.Ok) { loadError = AdminText.Refusal(result.Status, result.Code); return; }
        permissions = (await Admin.AccountPermissionsAsync(Id)).Value;
        contact = (await Admin.AccountContactAsync(Id)).Value;
        if (account!.Realm == "members")
        {
            registeredName = (await Admin.RegisteredNamesAsync(Id)).Value;
            verification = (await Admin.VerificationStateAsync(Id)).Value;
            locks = (await Admin.AccountLocksAsync(Id)).Value ?? [];
        }
    }

    /// <summary>Children report an action's outcome here, so every tab shows results (and "Sign in again") the same way.</summary>
    private void Report((int Status, string? Code, string Done) outcome)
    {
        var ok = outcome.Status is >= 200 and < 300;
        (resultCode, reauth) = (ok ? "ok" : outcome.Code ?? outcome.Status.ToString(), outcome.Status == 401 || outcome.Code == "stale-session");
        message = ok ? outcome.Done : AdminText.Refusal(outcome.Status, outcome.Code);
    }

    private string Name => registeredName is { Confirmed: true } r
        ? string.Join(" ", new[] { r.FirstName, r.LastName }.Where(n => !string.IsNullOrWhiteSpace(n)))
        : account?.DisplayName ?? "No display name";

    private (string Code, string Label, string Tone, string Detail) StateOf()
    {
        var held = locks.FirstOrDefault(l => l.Active);
        if (held is not null) return ("locked", "Sign-in locked", "reject", AccountLabels.Reason(held.ReasonCode));
        var live = account!.Sanctions.Where(s => s.Live && s.Kind != "warning").ToList();
        if (live.FirstOrDefault(s => s.Kind == "termination") is { }) return ("terminated", "Terminated", "reject", "Permanent");
        if (live.FirstOrDefault(s => s.Kind == "suspension") is { } suspended) return ("suspended", "Suspended", "reject", suspended.EndsAt is { } e ? $"Until {e:d MMM yyyy}" : "Until review");
        if (live.FirstOrDefault(s => s.Kind == "restriction") is { } restricted) return ("restricted", "Restricted", "escalate", restricted.EndsAt is { } e ? $"Until {e:d MMM yyyy}" : "Until review");
        return account.Status == "active" ? ("active", "Active", "approve", "Sign-in allowed") : (account.Status, AccountLabels.Status(account.Status), "reject", "");
    }

    private string VerificationSummary()
    {
        var parts = new List<string>();
        if (account!.IdStatus == "verified") parts.Add("ID Verified");
        if (verification?.PhotoStatus == "verified") parts.Add("Photo Verified");
        return parts.Count == 0 ? "None" : string.Join(" · ", parts);
    }

    private string PlanDetail()
    {
        var grant = account!.Entitlements.FirstOrDefault(e => e.Valid && e.Source == "adminGrant");
        return grant is not null ? $"Complimentary until {grant.EndsAt:d MMM yyyy}" : account.Founder ? "Founding member" : "No complimentary access";
    }

    private string Href(string key) => key == "overview" ? $"/accounts/{Id}" : $"/accounts/{Id}/{key}";
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
