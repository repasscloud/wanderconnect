@page "/registration"
@inject AdminClient Admin
<PageTitle>Registration settings — Swoovr admin</PageTitle>
<header class="ui-page-head">
    <h1>Registration settings</h1>
    <p>New registration only. Sign-in, password recovery, beta enrolments and records are not affected.</p>
</header>
@if(message is not null){<p class="notice" role="status" data-registration-result="@resultCode">@message</p>}
@if(policy is not null)
{
    <div class="ui-stats ui-stats-4" data-registration-state="@policy.State">
        <div class="ui-stat"><strong>@StateLabel(policy.State)</strong><span>Registration</span></div>
        <div class="ui-stat"><strong>@OnOff(policy.BetaEnabled)</strong><span>Invited beta</span></div>
        <div class="ui-stat"><strong>@OnOff(policy.PublicEnabled)</strong><span>Public</span></div>
        <div class="ui-stat"><strong>@policy.Revision</strong><span>Revision</span></div>
    </div>
    @if(policy.CanChange)
    {
        <section class="ui-card ui-section" aria-labelledby="registration-change-heading">
            <h2 id="registration-change-heading">Change availability</h2>
            <form method="post" @formname="registration-policy" @onsubmit="SaveAsync" data-enhance="true" class="ui-form" data-registration-form>
                <AntiforgeryToken /><input type="hidden" name="revision" value="@policy.Revision" />
                <fieldset class="ui-group"><legend>Registration</legend>
                    <label class="beta-check"><input type="checkbox" name="beta" value="yes" checked="@policy.BetaEnabled" /><span>Invited beta registration and beta tracking</span></label>
                    <label class="beta-check"><input type="checkbox" name="public" value="yes" checked="@policy.PublicEnabled" /><span>Public registration</span></label>
                </fieldset>
                <fieldset class="ui-group"><legend>Confirmation</legend>
                    <label class="ui-field"><span>Reason</span><textarea name="reason" required maxlength="500" rows="3">@Field("reason")</textarea></label>
                    <label class="beta-check"><input type="checkbox" name="confirm" value="yes" required /><span>Confirm this change</span></label>
                </fieldset>
                <div><button type="submit" class="ui-button-primary">Save availability</button></div>
            </form>
        </section>
    }
    else{<div class="ui-locked ui-section" data-registration-locked><strong>Root administrator only</strong>Availability can be changed by the Root administrator.</div>}
}
@code {
    [CascadingParameter] private HttpContext? Context{get;set;}
    private RegistrationAvailabilityView? policy;
    private string? message,resultCode;
    private string Field(string name)=>Context?.Request.HasFormContentType==true?Context.Request.Form[name].ToString():"";
    private static string OnOff(bool on)=>on?"On":"Off";
    private static string StateLabel(string state)=>state switch{"public-with-beta-tracking"=>"Public + beta","public"=>"Public","invite-only"=>"Invite only","closed"=>"Closed",_=>state};
    protected override async Task OnInitializedAsync()=>await LoadAsync();
    private async Task LoadAsync()
    {
        var result=await Admin.RegistrationAvailabilityAsync();policy=result.Value;
        if(!result.Ok){resultCode=result.Code??result.Status.ToString();message="Registration availability could not be read. New registration must remain closed until the authority is available.";}
    }
    private async Task SaveAsync()
    {
        if(!long.TryParse(Field("revision"),out var revision)){resultCode="invalid-revision";message="Reload the latest availability before changing it.";return;}
        var result=await Admin.UpdateRegistrationAvailabilityAsync(new(Field("beta")=="yes",Field("public")=="yes",revision,Field("confirm")=="yes",Field("reason")));
        resultCode=result.Ok?"saved":result.Code??result.Status.ToString();
        message=result.Ok?"Registration availability saved and audited.":result.Status==409?"Availability changed in another session. Review the latest revision and confirm again.":AdminText.Refusal(result.Status,result.Code);
        await LoadAsync();
    }
}
