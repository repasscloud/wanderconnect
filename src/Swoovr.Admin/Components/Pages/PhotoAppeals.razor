@page "/media/appeals"
@inject AdminClient Admin
<PageTitle>Media appeals — Swoovr admin</PageTitle>
<MediaTabs Active="appeals" />
@if(message is not null){<p class="notice" role="status">@message</p>}
@if(appeals is null){<div class="ui-empty"><strong>Appeals unavailable</strong>Media appeals are decided by Admin staff.</div>}
else if(appeals.Items.Count==0&&appeals.AwaitingOtherAdmin>0)
{
    @* Issue 232: appeals against this Admin's own decision go to a different Admin (D298); say so instead of looking empty. *@
    <div class="ui-empty" data-awaiting-other-admin="@appeals.AwaitingOtherAdmin"><strong>No appeals for you to decide</strong>@MediaText.AwaitingOtherAdmin(appeals.AwaitingOtherAdmin). You made the original decision, so a different Admin decides the appeal.</div>
}
else if(appeals.Items.Count==0){<div class="ui-empty"><strong>No appeals waiting</strong>New appeals appear here.</div>}
else
{
    <div class="ui-results-head"><p><strong>@appeals.Total</strong> waiting for a decision</p>@if(appeals.AwaitingOtherAdmin>0){<p class="ui-help" data-awaiting-other-admin="@appeals.AwaitingOtherAdmin">Also @MediaText.AwaitingOtherAdmin(appeals.AwaitingOtherAdmin) because you made the original decision.</p>}</div>
    <section class="ui-card">
    @foreach(var row in appeals.Items)
    {
        <article class="media-appeal" data-appeal="@row.Id">
            <form method="post" @formname="@($"appeal-view-{row.Id}")" @onsubmit="()=>ViewAsync(row.Id,row.MediaId)" data-enhance="true" class="media-frame media-appeal-frame"><AntiforgeryToken />
                @if(viewed==row.Id&&link is not null){<img src="/media/@link" alt="Rejected media under appeal" class="photo-appeal-image" />}
                else{<div class="media-veil">@EyeOff<button type="submit" class="ui-button-sm">Reveal</button></div>}
            </form>
            <div>
                <span class="ui-pill" data-tone="reject">Rejected</span>
                <blockquote class="media-quote">“@row.Text”</blockquote>
                <dl class="media-meta">
                    <dt>Submitted</dt><dd>@row.SubmittedAt.ToUniversalTime().ToString("d MMM HH:mm") UTC</dd>
                    <dt>Member</dt><dd><a href="/accounts/@row.AccountId">View account</a></dd>
                    <dt>Reference</dt><dd><span class="beta-ref"><code>@row.MediaId.ToString()[..8]</code><CopyButton Value="@row.MediaId.ToString()" /></span></dd>
                </dl>
            </div>
            <form method="post" @formname="@($"appeal-resolve-{row.Id}")" @onsubmit="()=>ResolveAsync(row.Id)" data-enhance="true" class="media-appeal-decision">
                <AntiforgeryToken />
                <fieldset class="ui-field"><legend>Outcome</legend>
                    <div class="ui-choice">
                        <label><input type="radio" name="outcome" value="uphold" required /><span>Uphold rejection</span></label>
                        <label><input type="radio" name="outcome" value="approve" required /><span>Approve</span></label>
                    </div>
                </fieldset>
                <label class="ui-field"><span>Reason</span><textarea name="reason" maxlength="500" required placeholder="Recorded with the outcome"></textarea></label>
                <button type="submit">Decide appeal</button>
            </form>
        </article>
    }
    </section>
    <nav class="ui-paging" aria-label="Appeal pages"><span class="ui-help">Page @appeals.Page</span><span class="ui-paging-links">@if(Page>1){<a class="ui-button-ghost" href="/media/appeals?page=@(Page-1)">Previous</a>}else{<span class="ui-button-ghost" aria-disabled="true">Previous</span>}@if(Page*appeals.PageSize<appeals.Total){<a class="ui-button-ghost" href="/media/appeals?page=@(Page+1)">Next</a>}else{<span class="ui-button-ghost" aria-disabled="true">Next</span>}</span></nav>
}
@code {
    [CascadingParameter]private HttpContext? Context { get; set; }
    [SupplyParameterFromQuery(Name="page")]public int Page { get; set; }=1;
    private PhotoAppealPage? appeals;private string? message,link;private Guid? viewed;
    private static readonly RenderFragment EyeOff = @<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.1A9.8 9.8 0 0 1 12 5c5 0 9 4.5 10 7-.4 1-1.3 2.4-2.6 3.7M6.6 6.6C4.5 8 3 10.1 2 12c1 2.5 5 7 10 7 1.7 0 3.3-.5 4.6-1.3"/></svg>;
    protected override async Task OnInitializedAsync(){Page=Math.Max(1,Page);await LoadAsync();}
    private async Task LoadAsync()=>appeals=(await Admin.PhotoAppealsAsync(Page)).Value;
    private async Task ViewAsync(Guid appeal,Guid media){var result=await Admin.ViewRejectedPhotoAsync(media,"Independent photo appeal review");if(result.Ok){viewed=appeal;link=result.Value!.Link.Split('/').Last();}else message=AdminText.Refusal(result.Status,result.Code);await LoadAsync();}
    private async Task ResolveAsync(Guid id){var form=Context?.Request.Form;var status=await Admin.ResolvePhotoAppealAsync(id,new PhotoAppealResolution(form?["outcome"].ToString(),form?["reason"].ToString()));link=null;viewed=null;message=status<300?"Appeal decided.":status==403?"Another Admin must decide this, with a current safety acknowledgement.":"Re-screening did not clear this media. Check its current state.";await LoadAsync();}
}
