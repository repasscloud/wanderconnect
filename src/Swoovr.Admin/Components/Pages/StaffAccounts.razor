@page "/staff"
@inject AdminClient Admin
@inject NavigationManager Navigation
<PageTitle>Staff accounts — Swoovr</PageTitle>
<h1>Staff accounts</h1>
@if (message is not null) { <p class="notice" role="status">@message</p> }
@if (accounts is not null)
{
    <form method="get" class="ui-form">
        <label class="ui-field">Name or verified email<input name="search" value="@Search" maxlength="100" /></label>
        <label class="ui-field">Role<select name="role"><option value="">All roles</option>@foreach (var role in Roles) { <option value="@role" selected="@(role == Role)">@AccountLabels.Role(role)</option> }</select></label>
        <label class="ui-field">Status<select name="status"><option value="">All statuses</option>@foreach(var value in new[]{"active","locked","suspended"}) { <option value="@value" selected="@(value == Status)">@value</option> }</select></label>
        <label class="ui-field">MFA<select name="mfa"><option value="">All</option>@foreach(var value in new[]{"enabled","setup-pending","disabled"}) { <option value="@value" selected="@(Mfa==value)">@value</option> }</select></label>
        <label class="ui-field">Signed in since<input name="since" type="date" value="@Since" /></label>
        <button type="submit" class="ui-button-primary">Search</button>
    </form>
    <div class="table-scroll"><table><thead><tr><th>Name</th><th>Verified email</th><th>Roles</th><th>Status</th><th>Last sign-in</th></tr></thead><tbody>
    @foreach (var row in accounts.Items)
    {
        <tr><td><a href="@($"/staff/{row.Id}")">@row.FirstName @row.LastName @(row.Root ? "(Root)" : "")</a></td><td>@row.Email</td><td>@string.Join(", ", row.Roles.Select(AccountLabels.Role))</td><td>@row.Status</td><td>@(row.LastSignInAt?.ToString("u") ?? "Not recorded")</td></tr>
    }
    </tbody></table></div>
    <p>@accounts.Total accounts</p>
    @if (accounts.Page > 1) { <a href="@PageLink(accounts.Page - 1)">Previous</a> }
    @if (accounts.Page * accounts.Size < accounts.Total) { <a href="@PageLink(accounts.Page + 1)">Next</a> }
    <section class="ui-card ui-section"><h2>Create staff account</h2>
    <form method="post" @formname="create-staff" @onsubmit="CreateAsync" class="ui-form">
        <AntiforgeryToken />
        <label class="ui-field">First name<input name="first" required maxlength="100" /></label>
        <label class="ui-field">Last name<input name="last" required maxlength="100" /></label>
        <label class="ui-field">Work email<input name="email" type="email" required maxlength="254" /></label>
        <label class="ui-field">Phone<input name="phone" type="tel" maxlength="32" /></label>
        <fieldset class="ui-group"><legend>Internal roles</legend>@foreach(var role in Roles) { <label><input name="roles" value="@role" type="checkbox" />@AccountLabels.Role(role)</label> }</fieldset>
        <label class="ui-field">Reason or case reference<input name="reason" required maxlength="80" placeholder="staff-onboarding or case:1234" pattern="[a-z][a-z0-9-]{2,63}(:[0-9]{1,18})?" /></label>
        <label><input type="checkbox" name="confirm" value="yes" required />Confirm this staff account and its roles</label>
        <button type="submit" class="ui-button-primary">Create account</button>
    </form></section>
}
@code {
    [CascadingParameter] private HttpContext? Context { get; set; }
    [SupplyParameterFromQuery(Name="search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name="role")] public string? Role { get; set; }
    [SupplyParameterFromQuery(Name="status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name="page")] public int Page { get; set; } = 1;
    [SupplyParameterFromQuery(Name="mfa")] public string? Mfa { get; set; }
    [SupplyParameterFromQuery(Name="since")] public string? Since { get; set; }
    private static readonly string[] Roles = ["support", "trustSafety", "admin", "legal", "business"];
    private StaffAccountPage? accounts; private string? message;
    private string Field(string name) => Context?.Request.HasFormContentType == true ? Context.Request.Form[name].ToString() : "";
    protected override async Task OnInitializedAsync() { var result = await Admin.StaffAccountsAsync(Search,Role,Status,Page,mfa:Mfa,signedInAfter:DateTimeOffset.TryParse(Since,out var since)?since:null); accounts = result.Value; if (!result.Ok) message = AdminText.Refusal(result.Status,result.Code); }
    private string PageLink(int page) => $"/staff?search={Uri.EscapeDataString(Search??"")}&role={Uri.EscapeDataString(Role??"")}&status={Uri.EscapeDataString(Status??"")}&mfa={Uri.EscapeDataString(Mfa??"")}&since={Uri.EscapeDataString(Since??"")}&page={page}";
    private async Task CreateAsync()
    {
        var result = await Admin.CreateStaffAsync(new(Field("first"),Field("last"),Field("email"),Field("phone"),Context!.Request.Form["roles"].Select(v=>v!).ToArray(),Field("reason"),Field("confirm")=="yes"));
        if (result.Ok) Navigation.NavigateTo($"/staff/{result.Value!.Id}");
        else message = AdminText.Refusal(result.Status,result.Code);
    }
}
