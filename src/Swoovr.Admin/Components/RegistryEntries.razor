@if (Rows is { Count: > 0 })
{
    <div class="table-scroll ui-table" tabindex="0" role="region" aria-label="Restrictions">
    <table class="registry-entries" data-registry-entries="@Rows.Count">
        <thead><tr><th scope="col">Identifier</th><th scope="col">Reason</th><th scope="col">Enforced</th><th scope="col">Review due</th><th scope="col">Expiry</th><th scope="col">Matches</th><th scope="col">Case</th></tr></thead>
        <tbody>
        @foreach (var row in Rows)
        {
            var due = row.ReviewDue <= DateTimeOffset.UtcNow;
            <tr data-registry-entry="@row.Id" data-registry-status="@row.Status" data-row-link>
                <td><a href="/registry/@row.Id" data-row-target><strong>@RegistryText.Type(row.IdentifierType)</strong></a><span class="ui-sub">@row.Status</span></td>
                <td>@RegistryText.Reason(row.ReasonCode)</td>
                <td>@row.BannedAt.ToUniversalTime().ToString("d MMM yyyy")</td>
                <td>@if (due) {<span class="ui-pill" data-tone="reject">Due</span>} else {@row.ReviewDue.ToUniversalTime().ToString("d MMM yyyy")}</td>
                <td>@(row.ExpiresAt?.ToUniversalTime().ToString("d MMM yyyy") ?? "None")</td>
                <td>@row.MatchCount</td>
                <td><a href="/cases/@row.CaseId">@row.CaseId.ToString()[..8]</a></td>
            </tr>
        }
        </tbody>
    </table></div>
}
else { <div class="ui-empty" data-registry-entries="none"><strong>Nothing here</strong>No restrictions in this view.</div> }
@code { [Parameter] public IReadOnlyList<BannedIdentifierView>? Rows { get; set; } }
