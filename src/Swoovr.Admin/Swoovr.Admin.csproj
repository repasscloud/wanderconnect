<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup><Compile Include="../Hosting/*.cs" Link="Hosting/%(Filename)%(Extension)" /></ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Swoovr.Client\Swoovr.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>
