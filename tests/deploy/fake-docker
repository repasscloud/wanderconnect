#!/usr/bin/env bash
# Test double for `docker` used by tests/deploy/cli_scenarios.sh. Records every call in $FAKE_LOG and simulates just
# enough of Docker/Compose for bin/swoovr: volumes are marker files in $FAKE_STATE; nothing real is started.
set -uo pipefail
echo "docker $*" >> "$FAKE_LOG"
state="$FAKE_STATE"; mkdir -p "$state/volumes" "$state/mounts"
volumes=(swoovr-pgdata zammad-pgdata zammad-storage zammad-elasticsearch zammad-redis caddy-data)

if [[ "${1:-}" == compose ]]; then
  shift
  while (($#)); do
    case "$1" in --project-name|--project-directory|-f|--env-file|--profile) shift 2 ;; *) break ;; esac
  done
  sub="${1:-}"; shift || true
  case "$sub" in
    version) echo 2.30.0 ;;
    config|pull|stop|cp|logs) cat > /dev/null 2>&1 < /dev/null; exit 0 ;;
    ps)
      [[ "${1:-}" == -aq || "${1:-}" == -q ]] && shift
      if [[ -n "${1:-}" && "${1:-}" != -* ]]; then echo "c-$1"; else printf 'c-api\nc-web\nc-keycloak\n'; fi ;;
    up) for v in "${volumes[@]}"; do touch "$state/volumes/$v"; done ;;
    down) [[ " $* " == *" --volumes "* ]] && rm -f "$state/volumes/"* ;;
    run)
      while [[ "${1:-}" == --* || "${1:-}" == -T ]]; do shift; done
      service="${1:-}"; shift || true
      [[ "${FAKE_FAIL_JOB:-}" == "$service" ]] && { echo "fake failure of $service"; exit 1; }
      case "$service" in
        keycloak-reconcile)
          echo 'SWOOVR_RECONCILE deploy-client=ok'
          echo "SWOOVR_RECONCILE initial-admin=${FAKE_ADMIN_STATE:-invite-not-completed}"
          [[ "${FAKE_ADMIN_STATE:-}" == ready ]] && echo 'SWOOVR_RECONCILE initial-admin-subject=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa' ;;
        api-command) [[ "${1:-} ${2:-}" == "root-admin ensure" ]] && echo 'root-admin=granted' ;;
        *) echo "job $service ok" ;;
      esac ;;
    exec)
      while [[ "${1:-}" == -T || "${1:-}" == -i ]]; do shift; done
      service="${1:-}"; shift || true
      case "$service" in
        caddy) # sh -c SCRIPT sh HOST PATH
          host="${5:-}"; path="${6:-}"; realm=""
          [[ "$path" =~ ^/realms/([a-z-]+)/ ]] && realm="${BASH_REMATCH[1]}"
          echo "  HTTP/1.1 200 OK"
          echo "{\"status\":\"ok\"} {\"status\":\"ready\"} {\"status\":\"healthy\"} {\"version\":\"${FAKE_VERSION:-0.0.0}\"} \"issuer\":\"https://auth-uat.swoovr.app/realms/$realm\" $host" ;;
        zammad-railsserver)
          cat > /dev/null
          echo 'SWOOVR_PROVISION_RESULT={"version":"7.2.2","groups":{"General Support":1},"identity_token":"t1","staff_directory_token":"t2","retention_token":"t3","home_city_check_token":"t4"}' ;;
      esac ;;
    *) exit 0 ;;
  esac
  exit 0
fi

case "${1:-}" in
  info) exit 0 ;;
  inspect)
    format="${3:-}"
    if [[ "$format" == *restarts* ]]; then echo 'svc running healthy restarts=0'
    elif [[ "$format" == *Health* ]]; then echo healthy
    elif [[ "$format" == *ExitCode* ]]; then echo 0
    elif [[ "$format" == *State.Status* ]]; then echo exited
    else echo '{}'; fi ;;
  volume)
    case "${2:-}" in
      inspect)
        if [[ "${3:-}" == -f ]]; then name="$5"; else name="$3"; fi
        [[ -e "$state/volumes/${name#swoovr-uat_}" ]] || exit 1
        if [[ "${3:-}" == -f ]]; then mkdir -p "$state/mounts/$name"; echo "$state/mounts/$name"; fi ;;
      ls) ls "$state/volumes" 2>/dev/null | sed 's/^/swoovr-uat_/' ;;
    esac ;;
  exec)
    shift
    if [[ "${1:-}" == -i ]]; then shift; cat > /dev/null; exit 0; fi  # pg_restore --list < dump
    shift  # container id; then: sh -c SCRIPT sh ARG
    script="${3:-}"
    if [[ "$script" == *pg_dump* ]]; then
      [[ -n "${FAKE_FAIL_PGDUMP:-}" ]] && { echo 'pg_dump: fake failure' >&2; exit 1; }
      echo "PGDMP fake dump of ${5:-db}"
    elif [[ "$script" == *ZAMMAD_DB* ]]; then printf zammad
    fi ;;
  *) exit 0 ;;
esac
