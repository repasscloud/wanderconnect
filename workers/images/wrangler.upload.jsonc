{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swoovr-images-upload-local",
  "main": "src/upload.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "traces": { "enabled": true }, "logs": { "enabled": true, "invocation_logs": false } },
  "r2_buckets": [{"binding":"QUARANTINE","bucket_name":"swoovr-images-quarantine-local"}],
  "vars": { "ALLOWED_ORIGINS": "https://app.example.invalid" }
}
