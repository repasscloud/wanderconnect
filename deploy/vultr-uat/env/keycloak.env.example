KC_DB_PASSWORD=__GENERATE_PASSWORD:db-keycloak__
# Temporary master-realm bootstrap admin. Retire after setup (DEPLOYMENT-UAT.md "Identity").
KC_BOOTSTRAP_ADMIN_PASSWORD=__GENERATE_PASSWORD:kc-admin__
# Shared with the API's Registration__ProviderToken.
SWOOVR_REGISTRATION_AUTHORITY_TOKEN=__GENERATE_PASSWORD:registration-authority__
