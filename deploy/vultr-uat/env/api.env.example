# Swoovr API private runtime values. Names match infra/uat/secret-bindings.json (the Azure Key Vault bindings),
# so UAT on Vultr and PROD on Azure use one configuration contract. Non-secret settings are in compose.yaml.
ConnectionStrings__Swoovr=Host=swoovr-postgres;Port=5432;Database=swoovr;Username=swoovr_api;Password=__GENERATE_PASSWORD:db-api__;SSL Mode=VerifyFull;Root Certificate=/etc/swoovr/tls/pg-ca.crt
Registration__ProviderToken=__GENERATE_PASSWORD:registration-authority__
MemberAdmin__ClientSecret=__GENERATE_PASSWORD:member-admin-secret__

# Providers (real UAT accounts; never simulated - D321)
# Email and SMS provider selection, sender and email credentials come from env/mail.env (D358, D360) via compose.yaml.
# Twilio SMS: needed when env/mail.env has SWOOVR_SMS_SERVICE=twilio (D360). While Twilio SMS is in verification,
# codes go to Mailpit and these may stay empty.
Sms__Twilio__AccountSid=
Sms__Twilio__AuthToken=
Sms__Twilio__From=
Didit__ApiKey=__OWNER:didit-key__
Didit__WorkflowId=__OWNER:didit-workflow__
Didit__WebhookSecret=__OWNER:didit-webhook__
Moderation__EscalationEmail=__OWNER:escalation-email__
Moderation__EscalationBackupEmail=__OWNER:escalation-backup__

# Media (legacy R2 store + independently hosted screening; staging pipeline settings from #261)
Media__R2__Endpoint=__OWNER:r2-endpoint__
Media__R2__Bucket=__OWNER:r2-bucket__
Media__R2__AccessKeyId=__OWNER:r2-access__
Media__R2__SecretAccessKey=__OWNER:r2-secret__
Media__Screening__BaseUrl=__OWNER:screening-https-origin__
Media__Screening__ApiKey=__OWNER:screening-key__
Media__Pipeline__ServiceToken=__OWNER:media-pipeline-service-token__
Media__Pipeline__UploadSigningKey=__OWNER:media-pipeline-upload-signing-key__

# Durable data keys (DATA-KEYS.md). Generated once per UAT build; a UAT reset generates new ones.
Founders__Secrets__1=__GENERATE_PASSWORD:founder-key-v1__
Phone__CodeKey=__GENERATE_PASSWORD:phone-key-v1__
Bans__HmacKeys__1=__GENERATE_KEY32:ban-key-v1__
ContactHistory__Keys__1=__GENERATE_KEY32:contact-key-v1__
ContactHistory__LookupKey=__GENERATE_KEY32:contact-lookup-v1__
Evidence__Keys__1=__GENERATE_KEY32:evidence-key-v1__
IdentityStore__Keys__1=__GENERATE_KEY32:identity-key-v1__
IdentityStore__HmacKey=__GENERATE_KEY32:identity-hmac-v1__
Push__TokenKeys__1=__GENERATE_KEY32:push-key-v1__
Push__TokenLookupKey=__GENERATE_KEY32:push-lookup-v1__

# Zammad (values captured by bin/swoovr zammad-provision; see containers/zammad/api.env.example)
Ticketing__Zammad__IdentityToken=__RUN_bin/swoovr_zammad-provision__
Ticketing__Zammad__StaffDirectoryToken=__RUN_bin/swoovr_zammad-provision__
Ticketing__Zammad__RetentionToken=__RUN_bin/swoovr_zammad-provision__
Ticketing__Zammad__HomeCityCheckToken=__RUN_bin/swoovr_zammad-provision__
Ticketing__Zammad__WebhookSecret=__GENERATE_PASSWORD:zammad-webhook__
Ticketing__Guest__AllowedOrigins__0=https://uat.swoovr.app
Ticketing__Guest__FrontendUrl=https://uat.swoovr.app/support
