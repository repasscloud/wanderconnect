# Every outgoing/incoming mail and SMS setting for UAT, in one file (D358, D360). Read by bin/swoovr (Compose
# interpolation) and envtool.py. After changing it: ./bin/swoovr mail-apply
#
# Which service uses what (D360, owner #316):
#   API (application email)   SWOOVR_API_MAIL_SERVICE       twilio (Twilio Email API) | smtp (relay below) | mailpit (sink)
#   Keycloak (sign-in email)  SWOOVR_KEYCLOAK_MAIL_SERVICE  twilio | mailersend
#   Zammad outgoing           SMTP relay below (SendGrid): staff notifications and replies from the support address
#   Zammad incoming           IMAP below: the support mailbox, fed into General Support (empty host = no inbound mail)
#   API SMS (codes, notices)  SWOOVR_SMS_SERVICE            mailpit (sink, while Twilio SMS is in verification) | twilio
#                             (Twilio SMS account values are in env/api.env as Sms__Twilio__*)
# Mailpit delivers nothing. Read it through an SSH tunnel (README "Mailpit").
#
# Sender for the API, Keycloak and Zammad notifications. CONFIRMED owner (D358): hello@repasscloud.com for now.
# Bare address only (no name, quotes or <>). It must be a sender the selected services accept (Twilio/SendGrid sender
# authentication for its domain).
SWOOVR_MAIL_FROM=hello@repasscloud.com
SWOOVR_MAIL_FROM_NAME=Swoovr
SWOOVR_MAIL_HELPDESK_FROM_NAME=Swoovr Helpdesk
#
SWOOVR_API_MAIL_SERVICE=twilio
SWOOVR_KEYCLOAK_MAIL_SERVICE=twilio
SWOOVR_SMS_SERVICE=mailpit
#
# Twilio Email API key (#316: the values called TWILIO_EMAIL_SID_RK and TWILIO_EMAIL_SECRET_RK). Needed while either
# mail service above is twilio; otherwise leave empty.
SWOOVR_MAIL_TWILIO_KEY_SID=__OWNER:twilio-email-key-sid__
SWOOVR_MAIL_TWILIO_KEY_SECRET=__OWNER:twilio-email-key-secret__
#
# SMTP relay: SendGrid. Username is literally "apikey"; the password is a SendGrid API key with Mail Send access.
# STARTTLS on 587 (2525 also works). Port is a bare number. Used by Zammad, and by the API when its service is smtp.
SWOOVR_MAIL_SMTP_HOST=smtp.sendgrid.net
SWOOVR_MAIL_SMTP_PORT=587
SWOOVR_MAIL_SMTP_USERNAME=apikey
SWOOVR_MAIL_SMTP_PASSWORD=__OWNER:sendgrid-api-key__
#
# MailerSend API token: only when a mail service above is mailersend.
SWOOVR_MAIL_MAILERSEND_API_TOKEN=
#
# Zammad incoming support mail (Q178). Leave SWOOVR_ZAMMAD_IMAP_HOST empty until the mail server is ready.
# SECURITY: ssl (993) | starttls (143). KEEP_ON_SERVER=true leaves fetched mail on the server (marked seen).
SWOOVR_ZAMMAD_SUPPORT_ADDRESS=
SWOOVR_ZAMMAD_SUPPORT_NAME=Swoovr Support
SWOOVR_ZAMMAD_IMAP_HOST=
SWOOVR_ZAMMAD_IMAP_PORT=993
SWOOVR_ZAMMAD_IMAP_SECURITY=ssl
SWOOVR_ZAMMAD_IMAP_USERNAME=
SWOOVR_ZAMMAD_IMAP_PASSWORD=
SWOOVR_ZAMMAD_IMAP_FOLDER=INBOX
SWOOVR_ZAMMAD_IMAP_KEEP_ON_SERVER=true
