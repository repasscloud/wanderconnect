# Every outgoing-mail setting for UAT, in one file (D358). Read by bin/swoovr (Compose interpolation) and envtool.py.
# After changing it: ./bin/swoovr mail-apply   (recreates Keycloak and the API, re-applies Zammad's mail settings)
#
# Sender for ALL mail: API, Keycloak and Zammad notifications. CONFIRMED owner 10 November 2026 (D358):
# hello@repasscloud.com, MailerSend's only verified domain for now. Must be on a MailerSend verified domain.
# Bare address only: no display name, quotes or spaces here.
SWOOVR_MAIL_FROM=hello@repasscloud.com
# Display names (DEFAULT). Members see SWOOVR_MAIL_FROM_NAME; staff see the helpdesk name on Zammad notifications.
SWOOVR_MAIL_FROM_NAME=Swoovr
SWOOVR_MAIL_HELPDESK_FROM_NAME=Swoovr Helpdesk
#
# MailerSend SMTP (D357): used by Zammad. STARTTLS on 587; 2525 also works. Port is a bare number.
SWOOVR_MAIL_SMTP_HOST=smtp.mailersend.net
SWOOVR_MAIL_SMTP_PORT=587
SWOOVR_MAIL_SMTP_USERNAME=__OWNER:mail-smtp-username__
SWOOVR_MAIL_SMTP_PASSWORD=__OWNER:mail-smtp-password__
#
# MailerSend HTTP API token (Email access on the verified domain): used by the API and Keycloak (D39).
# Q177 (#311) asks whether these also move to SMTP with the four values above.
SWOOVR_MAIL_API_TOKEN=__OWNER:mailersend-token__
