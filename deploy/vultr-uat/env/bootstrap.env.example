# Input to the operator image's database-bootstrap job (scripts/uat/uat_jobs.py). Same names as Azure secret-bindings.json.
SWOOVR_PG_ADMIN=swoovrbootstrap
PGUSER=swoovrbootstrap
PGPASSWORD=__GENERATE_PASSWORD:pg-admin__
SWOOVR_API_DB_PASSWORD=__GENERATE_PASSWORD:db-api__
SWOOVR_MIGRATOR_DB_PASSWORD=__GENERATE_PASSWORD:db-migrator__
SWOOVR_OPERATOR_DB_PASSWORD=__GENERATE_PASSWORD:db-operator__
SWOOVR_BACKUP_DB_PASSWORD=__GENERATE_PASSWORD:db-backup__
KC_DB_PASSWORD=__GENERATE_PASSWORD:db-keycloak__
