# Input to bin/swoovr zammad-provision only (piped on stdin to containers/zammad/provision.rb).
SWOOVR_ZAMMAD_BOOTSTRAP_PASSWORD=__GENERATE_PASSWORD:zammad-bootstrap__
SWOOVR_ZAMMAD_WEBHOOK_SECRET=__GENERATE_PASSWORD:zammad-webhook__
# Outgoing staff notification mail: MailerSend SMTP (CONFIRMED owner, Q176 #308, D357). STARTTLS on 587; 2525 also works.
# Use the MailerSend SMTP user's username and password (the owner keeps a copy as ZAMMAD_SMTP_* in .local/platform/docker.env).
SWOOVR_ZAMMAD_SMTP_HOST=smtp.mailersend.net
SWOOVR_ZAMMAD_SMTP_PORT=587
SWOOVR_ZAMMAD_SMTP_USERNAME=__OWNER:zammad-smtp-username__
SWOOVR_ZAMMAD_SMTP_PASSWORD=__OWNER:zammad-smtp-password__
# From for staff notifications, on the MailerSend verified domain, e.g. Swoovr Helpdesk <helpdesk@verified.domain>.
# Without it Zammad sends from noreply@helpdesk-uat.swoovr.app, which MailerSend refuses unless that host is verified.
SWOOVR_ZAMMAD_NOTIFICATION_SENDER=__OWNER:zammad-notification-sender__
