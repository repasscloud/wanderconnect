# Input to bin/swoovr zammad-provision only (piped on stdin to containers/zammad/provision.rb).
SWOOVR_ZAMMAD_BOOTSTRAP_PASSWORD=__GENERATE_PASSWORD:zammad-bootstrap__
SWOOVR_ZAMMAD_WEBHOOK_SECRET=__GENERATE_PASSWORD:zammad-webhook__
# Zammad's outgoing SMTP relay, sender and incoming IMAP mailbox come from env/mail.env (D357, D358, D360).
