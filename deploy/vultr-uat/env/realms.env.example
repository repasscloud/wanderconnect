# Input to keycloak-bootstrap only. Client secrets are generated; realm JSON comes from scripts/uat/keycloak_realms.py
# and is loaded with: bin/swoovr realms-env <generated-directory>. Keep the ${SWOOVR_UAT_...} placeholders inside it.
SWOOVR_UAT_MEMBERS_WEB_SECRET=__GENERATE_PASSWORD:member-web-secret__
SWOOVR_UAT_VENUES_WEB_SECRET=__GENERATE_PASSWORD:venue-web-secret__
SWOOVR_UAT_STAFF_WEB_SECRET=__GENERATE_PASSWORD:staff-web-secret__
SWOOVR_UAT_MEMBER_ADMIN_SECRET=__GENERATE_PASSWORD:member-admin-secret__
SWOOVR_UAT_ENTRA_CLIENT_SECRET=__OWNER:entra-client-secret__
SWOOVR_UAT_REALM_MEMBERS=__RUN_bin/swoovr_realms-env__
SWOOVR_UAT_REALM_VENUES=__RUN_bin/swoovr_realms-env__
SWOOVR_UAT_REALM_STAFF=__RUN_bin/swoovr_realms-env__
