# Operator identity for one-shot API commands (root-admin grant, accounts purge, founders allocate, keys status).
ConnectionStrings__Swoovr=Host=swoovr-postgres;Port=5432;Database=swoovr;Username=swoovr_operator;Password=__GENERATE_PASSWORD:db-operator__;SSL Mode=VerifyFull;Root Certificate=/etc/swoovr/tls/pg-ca.crt
