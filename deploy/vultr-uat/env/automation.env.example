# Deployment automation (D362). Read by the keycloak-reconcile job only. Written by bin/swoovr from GitHub values
# (UAT_INITIAL_ADMIN_EMAIL, UAT_ENTRA_TENANT_ID, UAT_ENTRA_CLIENT_ID, UAT_KEYCLOAK_ENABLED_REALMS) on each deployment.
# Generated once on the host: the secret of the master-realm service client `swoovr-deploy` (never a person).
SWOOVR_KC_DEPLOY_CLIENT_SECRET=__GENERATE_PASSWORD:kc-deploy-secret__
SWOOVR_INITIAL_ADMIN_EMAIL=__OWNER:initial-admin-email__
SWOOVR_ENTRA_TENANT_ID=__OWNER:entra-tenant-id__
SWOOVR_ENTRA_CLIENT_ID=__OWNER:entra-client-id__
SWOOVR_KEYCLOAK_ENABLED_REALMS=swoovr-members,swoovr-staff
