# Zammad 7.2.2 shared settings (all Zammad services). Matches compose.upstream.yaml x-shared, hosted values.
POSTGRESQL_DB=zammad_production
POSTGRESQL_HOST=zammad-postgresql
POSTGRESQL_USER=zammad
POSTGRESQL_PASS=__GENERATE_PASSWORD:zammad-db__
POSTGRESQL_PORT=5432
POSTGRESQL_OPTIONS=?pool=50
POSTGRESQL_DB_CREATE=false
REDIS_URL=redis://zammad-redis:6379
MEMCACHE_SERVERS=zammad-memcached:11211
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_SCHEMA=http
ELASTICSEARCH_HOST=zammad-elasticsearch
ELASTICSEARCH_PORT=9200
BACKUP_DIR=/var/tmp/zammad
NGINX_PORT=8080
NGINX_SERVER_SCHEME=https
NGINX_CLIENT_MAX_BODY_SIZE=220M
ZAMMAD_HTTP_TYPE=https
ZAMMAD_FQDN=helpdesk-uat.swoovr.app
