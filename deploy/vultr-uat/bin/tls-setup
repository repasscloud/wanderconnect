#!/usr/bin/env bash
# TLS material for the UAT host. Idempotent: existing keys are never replaced unless --rotate-postgres is given.
#  1. Private CA + server certificate for the Swoovr/Keycloak PostgreSQL (clients use VerifyFull against it).
#  2. Cloudflare Origin CA roots, so containers trust Caddy's origin certificate when they call public names.
#  3. trust-bundle.pem = Debian system CAs + Cloudflare Origin CA roots + PostgreSQL CA (SSL_CERT_FILE).
#  4. Checks the operator-installed Cloudflare Origin CA certificate (tls/origin/origin.pem + origin.key).
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
tls="$here/tls"
umask 077
mkdir -p "$tls/postgres" "$tls/trust" "$tls/origin"
chmod 0755 "$tls" "$tls/trust"
chmod 0700 "$tls/postgres" "$tls/origin"

if [[ "${1:-}" == --rotate-postgres ]]; then rm -f "$tls/postgres/ca.key" "$tls/postgres/server.key"; fi
if [[ ! -f "$tls/postgres/ca.key" ]]; then
  openssl ecparam -name prime256v1 -genkey -noout -out "$tls/postgres/ca.key"
  openssl req -x509 -new -key "$tls/postgres/ca.key" -sha256 -days 3650 -subj '/CN=Swoovr UAT PostgreSQL CA' \
    -addext 'basicConstraints=critical,CA:TRUE,pathlen:0' -addext 'keyUsage=critical,keyCertSign,cRLSign' \
    -out "$tls/trust/pg-ca.crt"
fi
if [[ ! -f "$tls/postgres/server.key" ]]; then
  openssl ecparam -name prime256v1 -genkey -noout -out "$tls/postgres/server.key"
  openssl req -new -key "$tls/postgres/server.key" -subj '/CN=swoovr-postgres' -out "$tls/postgres/server.csr"
  openssl x509 -req -in "$tls/postgres/server.csr" -CA "$tls/trust/pg-ca.crt" -CAkey "$tls/postgres/ca.key" \
    -CAcreateserial -days 825 -sha256 -out "$tls/postgres/server.crt" \
    -extfile <(printf 'subjectAltName=DNS:swoovr-postgres\nextendedKeyUsage=serverAuth\nkeyUsage=critical,digitalSignature')
  rm -f "$tls/postgres/server.csr"
fi
# The postgres image (Debian) runs as UID/GID 999 and refuses a key readable by others.
chown 999:999 "$tls/postgres/server.key" "$tls/postgres/server.crt"
chmod 0600 "$tls/postgres/server.key"; chmod 0644 "$tls/postgres/server.crt" "$tls/trust/pg-ca.crt"
chown 999:999 "$tls/postgres"; chmod 0700 "$tls/postgres"

# Cloudflare Origin CA roots (documented at developers.cloudflare.com/ssl/origin-configuration/origin-ca/).
curl -fsSL https://developers.cloudflare.com/ssl/static/origin_ca_rsa_root.pem -o "$tls/trust/cf-rsa.pem"
curl -fsSL https://developers.cloudflare.com/ssl/static/origin_ca_ecc_root.pem -o "$tls/trust/cf-ecc.pem"
cat "$tls/trust/cf-rsa.pem" "$tls/trust/cf-ecc.pem" > "$tls/trust/cloudflare-origin-ca.pem"
rm -f "$tls/trust/cf-rsa.pem" "$tls/trust/cf-ecc.pem"
echo 'Cloudflare Origin CA root fingerprints (compare with the Cloudflare documentation before continuing):'
openssl crl2pkcs7 -nocrl -certfile "$tls/trust/cloudflare-origin-ca.pem" | openssl pkcs7 -print_certs -noout | grep subject || true
awk 'BEGIN{c=0} /BEGIN CERT/{c++} {print > ("/tmp/swoovr-cf-" c ".pem")}' "$tls/trust/cloudflare-origin-ca.pem"
for f in /tmp/swoovr-cf-*.pem; do openssl x509 -in "$f" -noout -fingerprint -sha256 2>/dev/null || true; rm -f "$f"; done

cat /etc/ssl/certs/ca-certificates.crt "$tls/trust/cloudflare-origin-ca.pem" "$tls/trust/pg-ca.crt" > "$tls/trust/trust-bundle.pem"
chmod 0644 "$tls/trust/"*.pem

if [[ -f "$tls/origin/origin.pem" && -f "$tls/origin/origin.key" ]]; then
  chmod 0600 "$tls/origin/origin.key"
  for host in uat api-uat admin-uat auth-uat helpdesk-uat; do
    openssl x509 -in "$tls/origin/origin.pem" -noout -checkhost "$host.swoovr.app" | grep -q 'does match' \
      || { echo "FAIL origin certificate does not cover $host.swoovr.app" >&2; exit 1; }
  done
  [[ "$(openssl x509 -in "$tls/origin/origin.pem" -noout -pubkey | openssl sha256)" == "$(openssl pkey -in "$tls/origin/origin.key" -pubout | openssl sha256)" ]] \
    || { echo 'FAIL origin certificate and key do not match' >&2; exit 1; }
  openssl x509 -in "$tls/origin/origin.pem" -noout -enddate
  echo 'PASS origin certificate covers all five UAT hostnames and matches its key.'
else
  echo 'TODO install the Cloudflare Origin CA certificate as tls/origin/origin.pem and its key as tls/origin/origin.key (0600), then rerun.'
fi
