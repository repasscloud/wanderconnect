# One release = one commit. The image workflow (.github/workflows/images.yml) writes the five Swoovr lines as
# release-manifest.env; make-bundle.sh copies that file here as release.env. Every value is repo@sha256 (no tags).
SWOOVR_COMMIT=0000000000000000000000000000000000000000
SWOOVR_API_IMAGE=docker.io/repasscloud/swoovr-api@sha256:__FROM_RELEASE_MANIFEST__
SWOOVR_WEB_IMAGE=docker.io/repasscloud/swoovr-web@sha256:__FROM_RELEASE_MANIFEST__
SWOOVR_ADMIN_IMAGE=docker.io/repasscloud/swoovr-admin@sha256:__FROM_RELEASE_MANIFEST__
SWOOVR_OPERATOR_IMAGE=docker.io/repasscloud/swoovr-operator@sha256:__FROM_RELEASE_MANIFEST__
SWOOVR_KEYCLOAK_IMAGE=docker.io/repasscloud/swoovr-keycloak@sha256:__FROM_RELEASE_MANIFEST__
